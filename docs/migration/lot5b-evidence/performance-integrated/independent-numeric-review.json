  "method": {
    "sessionDuration": "trial.replayElapsedMs; all four measured rounds from both cohorts, with no summation of phase durations",
    "median": "statistics.median of all individual measured values pooled across cohorts; even counts use the arithmetic mean of the two central values",
    "strictBudget": "Exact decimal parsing of recorded session durations, median(after) < 1.1 * median(before), separately for each case; no tolerance and no cross-case compensation",
    "knownPrefixMetrics": "requests where type=advance and kind=action; nativeServiceMs for known_prefix_service, wallMs for known_prefix_request",
    "otherPhaseMetrics": "samples where stage equals the requested stage; elapsedMs",
    "p95": "Nearest rank sorted[ceil(0.95*n)-1] only when n>=20, otherwise null; no session p95 for n=8",
    "roundMedianNoise": "(maximum trial median - minimum trial median) / median(trial medians)",
    "diagnosticClassification": "Phase median increase <=0.1 passes. Above 0.1, noise above 0.1 gives over_budget_with_noise_unresolved; otherwise over_budget. This diagnostic rule does not replace the separate strict global rule.",
    "comparisonTolerance": {
      "absolute": 1e-09,
      "relative": 1e-12,
      "appliesTo": "numeric comparison against existing reports only; never applied to budget acceptance"
    },
    "qualifications": [
      "No phase aggregate, raw report precomputed median, or reviewer output was used to derive durations or distributions.",
      "Phase samples from the same session are not independent confidence evidence. Descriptive p95 and round-median ranges are not confidence intervals.",
      "The arithmetic mean of cohort increases is disclosed for comparison only and does not determine acceptance."
    ],
    "sessionCompletion": "Use the declared action count and targetLevels from cases.json. A measured target_levels_completed boundary is complete when its levels reach targetLevels; a null reason is complete at the declared action cap while below targetLevels. Warmups use their separately declared action cap. All final action and acquisition counts were already checked against recorded actions."
  },
