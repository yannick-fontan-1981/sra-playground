+def official_performance_active(value):
+    explicit = value.get('official_performance_active')
+    if explicit is not None:
+        require(type(explicit) is bool, 'official_performance_active must be boolean or null')
+        return explicit
+    started, released = value.get('performance_started'), value.get('quiet_released')
+    require(started is None or type(started) is bool, 'performance_started must be boolean or null')
+    require(released is None or type(released) is bool, 'quiet_released must be boolean or null')
+    return started is True and released is not True
+
