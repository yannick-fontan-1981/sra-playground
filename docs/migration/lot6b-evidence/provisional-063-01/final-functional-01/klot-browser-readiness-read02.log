SCRIPT scripts/run-bounded-native-campaign-proof.py
#!/usr/bin/env python3
"""Retain one bounded cold reference and immutable, losslessly compressed evidence.

The ordinary production harness owns every decision and dispatch. This outer
process fingerprints execution inputs and archives its passive public journal.
It does not import a Python agent or inspect the game implementation.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import gzip
import hashlib
import json
from pathlib import Path
import subprocess
import time

ROOT = Path(__file__).resolve().parents[1]


def sha(path):
    value = hashlib.sha256()
    with Path(path).open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            value.update(chunk)
    return value.hexdigest()


def evidence(path):
    path = Path(path)
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': sha(path), 'bytes': path.stat().st_size}


def native_source():
    files = {p.relative_to(ROOT).as_posix(): sha(p)
             for folder in ['src/logos-engine', 'src/runtime']
             for p in sorted((ROOT / folder).rglob('*'))
             if p.is_file() and p.suffix in ['.ts', '.json', '.drm']}
    ordered = dict(sorted(files.items()))
    digest = hashlib.sha256(json.dumps(ordered, separators=(',', ':')).encode()).hexdigest()
    return {'fileCount': len(ordered), 'digest': digest, 'files': ordered}


def archive(source, destination):
    with Path(source).open('rb') as incoming, Path(destination).open('xb') as outgoing:
        with gzip.GzipFile(filename='', mode='wb', fileobj=outgoing, mtime=0) as compressed:
            for chunk in iter(lambda: incoming.read(1024 * 1024), b''):
                compressed.write(chunk)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('game')
    parser.add_argument('levels', type=int)
    parser.add_argument('maximum_actions', type=int)
    parser.add_argument('directory')
    args = parser.parse_args()
    out = ROOT / args.directory
    before = native_source()
    manifest_path = out / 'source-manifest.json'
    if before != json.loads(manifest_path.read_text()):
        raise ValueError('Current native source differs from the declared freeze')
    stem = args.game.lower()
    report = out / f'{stem}-campaign.json.gz'
    trace = out / f'{stem}-public-trace.json.gz'
    receipt = out / f'execution-{stem}.json'
    output = out / f'{stem}-output.log.gz'
    journal_archive = out / f'{stem}-actual-public-journal.jsonl.gz'
    live_stem = f'v53-{out.name}-{stem}'
    journal = ROOT.parent / f'{live_stem}-actual-public-journal.jsonl'
    live_log = ROOT.parent / f'{live_stem}-live.log'
    for path in [report, trace, receipt, output, journal_archive, journal, live_log]:
        if path.exists():
            raise FileExistsError(path)
        path.parent.mkdir(parents=True, exist_ok=True)
    runner = ROOT / 'scripts/run-bounded-native-campaign.mjs'
    harness = ROOT / 'tests/helpers/v6-live-game-campaign.ts'
    inputs_before = {'runner': evidence(runner), 'harness': evidence(harness), 'generator': evidence(Path(__file__))}
    command = ['node', str(runner), args.game, str(args.levels), str(args.maximum_actions), str(report), str(trace), str(journal)]
    started = datetime.now(timezone.utc).isoformat()
    clock = time.monotonic()
    with live_log.open('xb') as stream:
        completed = subprocess.run(command, cwd=ROOT, stdout=stream, stderr=subprocess.STDOUT)
    archive(live_log, output)
    if journal.exists():
        archive(journal, journal_archive)
    after = native_source()
    inputs_after = {'runner': evidence(runner), 'harness': evidence(harness), 'generator': evidence(Path(__file__))}
    unchanged = before == after and inputs_before == inputs_after
    result = json.loads(gzip.decompress(report.read_bytes())) if report.exists() else None
    value = {
        'schema': 'logos-engine.v53.actual-journaled-campaign-execution.v1',
        'command': command, 'exitCode': completed.returncode, 'maximumAcquiredActions': args.maximum_actions, 'startedAt': started,
        'finishedAt': datetime.now(timezone.utc).isoformat(), 'elapsedSeconds': time.monotonic() - clock,
        'nativeSource': before, 'nativeSourceManifestDigest': before['digest'],
        'nativeSourceAfter': after, 'nativeSourceUnchanged': before == after,
        'executionInputs': inputs_before, 'executionInputsAfter': inputs_after,
        'executionCodeUnchanged': unchanged, 'output': evidence(output),
        'qualification': 'One bounded cold native common reference with the opaque public game host; an outer action cap is not a complete-game verdict. '
                         'A passive observer journals the actual commands and all returned public packets. '
                         'No expected action, learned state, route, Python agent or level jump is supplied.',
    }
    for key, path in [('report', report), ('trace', trace), ('publicJournal', journal_archive)]:
        if path.exists():
            value[key] = evidence(path)
    with receipt.open('x') as stream:
        stream.write(json.dumps(value, indent=2) + '\n')
    print(json.dumps({'exitCode': completed.returncode, 'sourceUnchanged': unchanged,
                      'status': result['status'] if result else None, 'outerReferenceLimit': result.get('outerReferenceLimit') if result else None,
                      'final': result['final'] if result else None,
                      'receipt': receipt.relative_to(ROOT).as_posix()}), flush=True)
    if completed.returncode or not unchanged:
        raise SystemExit(completed.returncode or 1)


if __name__ == '__main__':
    main()

SCRIPT scripts/run-bounded-native-campaign.mjs
/** Development reference cap. The unchanged common harness still owns decisions. */
import { access, mkdir, writeFile } from 'node:fs/promises';
import { appendFileSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { gzipSync } from 'node:zlib';
import { runNativeGameCampaign } from '../tests/helpers/v6-live-game-campaign.ts';

const [game, target, cap, reportArgument, traceArgument, journalArgument] = process.argv.slice(2);
const targetLevels = Number(target), maximumAcquiredActions = Number(cap);
if (!game || !Number.isInteger(targetLevels) || targetLevels < 1
    || !Number.isInteger(maximumAcquiredActions) || maximumAcquiredActions < 1
    || !reportArgument || !traceArgument || !journalArgument) {
  throw new Error('Usage: run-bounded-native-campaign.mjs GAME TARGET_LEVELS MAX_ACTIONS REPORT.gz TRACE.gz JOURNAL');
}
const [reportPath, tracePath, journalPath] = [reportArgument, traceArgument, journalArgument].map(value => resolve(value));
for (const path of [reportPath, tracePath, journalPath]) {
  try { await access(path); throw new Error(`Evidence already exists: ${path}`); }
  catch (error) { if (error.code !== 'ENOENT') throw error; }
  await mkdir(dirname(path), { recursive: true });
}
const packets = [];
let actionCapReached = false;
const report = await runNativeGameCampaign({ gameCode: game, targetLevels,
  progress: event => {
    console.log(JSON.stringify(event));
    // A response follows acquisition and precedes acceptance/dispatch of another
    // returned command. Stop only the outer diagnostic, never rewrite a policy.
    if (event.phase === 'response' && event.actions >= maximumAcquiredActions
        && event.levelsCompleted < targetLevels) {
      actionCapReached = true;
      throw new Error('outer_reference_acquired_action_cap');
    }
  },
  publicTrace: (packet, command) => {
    const item = { command: structuredClone(command), packet: structuredClone(packet) };
    packets.push(item);
    appendFileSync(journalPath, JSON.stringify(item) + '\n');
  },
});
report.outerReferenceLimit = { maximumAcquiredActions, actionCapReached,
  qualification: 'A bounded development reference, not a complete production campaign. The unchanged common harness owns every decision. If the outer action cap is reached, the last response has acquired its transition but is not accepted by the browser controller; final controller/prefix summaries may therefore lag that response. All actual public returns remain in the journal.' };
await writeFile(reportPath, gzipSync(JSON.stringify(report) + '\n'));
await writeFile(tracePath, gzipSync(JSON.stringify({ schema: 'logos-engine.native-public-game-trace.v1',
  game, sourceDigest: report.source.digest, status: report.status, packets }) + '\n'));
console.log(JSON.stringify({ status: report.status, final: report.final, failure: report.failure, actionCapReached }));
if (report.status !== 'passed') process.exitCode = 1;

SCRIPT docs/migration/lot6b-evidence/freeze-source.py
#!/usr/bin/env python3
"""Freeze the selected-rigid native candidate and its passive execution adapters.

Derived from scripts/freeze-v53-native-source.py. The same native inventory and
byte-parts schema are used. Preview, SelectedRigid and inherited Window passive
evidence adapters are included explicitly. No game, native runtime, oracle or measurement is executed.
"""
from pathlib import Path
import gzip, hashlib, importlib.util, io, json, subprocess, sys, tarfile

ROOT = Path(__file__).resolve().parents[3]
sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location('freeze_source_parent', ROOT / 'scripts/freeze-v53-native-source.py')
parent = importlib.util.module_from_spec(spec); spec.loader.exec_module(parent)
proof = parent.proof

def main():
    if len(sys.argv) != 2:
        raise SystemExit('Usage: python -B docs/migration/lot6b-evidence/freeze-source.py OUTPUT_DIRECTORY')
    out = (ROOT / sys.argv[1]).resolve(); out.relative_to(ROOT)
    out.mkdir(parents=True, exist_ok=True)
    if any((out / name).exists() for name in ('source-manifest.json', 'source-archive.json', 'source-archive.tar.gz')):
        raise FileExistsError('A source freeze is immutable')
    native = proof.native_source(); files = dict(native['files'])
    inputs = ['tests/helpers/v6-live-game-campaign.ts', 'tests/helpers/capture-preview-packing.ts', 'tests/helpers/capture-selected-rigid.ts',
              'tests/helpers/v6-window-question-capture.ts',
              'scripts/run-v53-journaled-campaign.mjs', 'scripts/run-v53-campaign-proof.py',
              'scripts/replay-v53-public-regression.mjs', 'scripts/run-v53-regression-checks.py',
              'scripts/run-v53-release-checks.py', 'scripts/freeze-v53-native-source.py',
              'scripts/run-recorded-public-regressions.py', 'scripts/compare-v54-regressions.py',
              'scripts/verify-native-delta.py', 'docs/migration/lot6b-evidence/freeze-source.py',
              'scripts/run-bounded-native-campaign.mjs', 'scripts/run-bounded-native-campaign-proof.py',
              'package.json', 'package-lock.json', 'tsconfig.json', '.openai/hosting.json']
    for name in inputs: files[name] = proof.sha(ROOT / name)
    files = dict(sorted(files.items())); archive = out / 'source-archive.tar.gz'
    with archive.open('xb') as stream, gzip.GzipFile(filename='', mode='wb', fileobj=stream, mtime=0, compresslevel=9) as zipped:
        with tarfile.open(fileobj=zipped, mode='w|') as tar:
            for name, expected in files.items():
                data = (ROOT / name).read_bytes()
                if hashlib.sha256(data).hexdigest() != expected: raise ValueError('Source changed: ' + name)
                info = tarfile.TarInfo(name); info.size = len(data); info.mode = 0o644
                tar.addfile(info, io.BytesIO(data))
    if proof.native_source() != native: raise ValueError('Native source changed during freeze')
    parent.write_json(out / 'source-manifest.json', native)
    parent.write_json(out / 'source-archive.json', {
        'schema': 'logos-engine.v53.frozen-source-archive.v1',
        'baseCommit': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(),
        'nativeSourceManifestDigest': native['digest'], 'files': files,
        'archive': proof.evidence(archive), 'generator': proof.evidence(Path(__file__)),
        'qualification': 'SelectedRigid candidate freeze. Includes exact native code and passive execution adapters; no learned state, game source or historical receipt is supplied as a production input.'})
    parent.split(out)
    print(json.dumps({'status': 'frozen', 'nativeDigest': native['digest'], 'nativeFiles': native['fileCount'],
                      'archiveFiles': len(files), 'directory': str(out.relative_to(ROOT))}))

if __name__ == '__main__': main()

