{
  "name": "sra-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive games and native TypeScript symbolic reasoning with Logos Engine.",
  "scripts": {
    "dev": "node scripts/prepare-python.mjs && node scripts/generate-content-pages.mjs && node scripts/generate-game-gallery.mjs && vite --host 0.0.0.0",
    "build": "node scripts/prepare-python.mjs && node scripts/generate-content-pages.mjs && node scripts/generate-game-gallery.mjs && tsc --noEmit && vite build",
    "content:generate": "node scripts/generate-content-pages.mjs && node scripts/generate-game-gallery.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.ts",
    "demo:logos": "node scripts/demo-logos.ts",
    "test:sic-transfer-levels": "node scripts/sic-transfer-levels.mjs",
    "test:sic-l1-transfer": "node scripts/sic-l1-targeted-campaign.mjs",
    "test:sic-campaign": "node scripts/sic-transfer-campaign.mjs",
    "test:sic-transfer": "node scripts/sic-transfer-cycle.mjs",
    "test:sic-pressure-transfer": "node scripts/sic-pressure-transfer-campaign.mjs",
    "test:sic-effect-composer": "node scripts/sic-effect-composer-campaign.mjs",
    "test:sic-effect-replays": "node scripts/sic-effect-composer-replays.mjs",
    "test:sic-continuity": "node scripts/verify-sic-continuity.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=22.18.0" },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
