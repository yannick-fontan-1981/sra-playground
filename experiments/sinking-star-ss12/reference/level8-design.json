  "adaptation": {
    "kind": "two-source-mechanic-adaptation",
    "preserved": [
      "Heroes and Mirrors 2 : le reflet change le côté relatif du Barde et de sa caisse, puis il faut les réaligner.",
      "Heroes and Water 28 : le Guerrier pousse le Barde pour éviter un déplacement parasite du cargo entraîné par le chant.",
      "Deux héros et deux destinations demandent de finir la coopération avant de quitter la salle."
    ],
    "changed": [
      "Trois îles originales remplacent les géométries sources.",
      "Le même poids ferme le premier axe de miroir et ouvre l’arrivée du dernier reflet.",
      "Le deuxième miroir doit être poussé à la bonne hauteur par le Guerrier.",
      "La paire de monstres finale impose un chant sélectif à distance sûre.",
      "La sortie par appui de Water 28 est transposée à une commande de portes ; aucune mécanique de pile ni double déplacement n’est ajoutée."
    ],
    "sourceReading": "Descriptions des énigmes Mirrors 2 et Water 28 consultées ; synthèse déclarée de leurs problèmes de position relative et de sortie sans chant, pas une reconstruction exacte.",
    "authoredRoute": "Parcours manuel avec recherche de marches sans manipulation entre les postes.",
    "resourceRoles": {
      "cargo": "Change de rive, puis commande simultanément un obturateur et la porte d’arrivée.",
      "firstMirror": "Fait passer la caisse puis les héros depuis des distances différentes.",
      "shutter": "Coupe le premier rayon pour qu’il ne ramène pas le Guerrier lors du reflet final.",
      "secondMirror": "Doit être décalé d’une case pour offrir une arrivée sûre sur l’île finale.",
      "warrior": "Règle le second miroir et place le Barde sans retirer le poids de sa commande.",
      "guards": "Bloquent les deux abords de la destination supérieure tant qu’ils restent vivants."
    }
