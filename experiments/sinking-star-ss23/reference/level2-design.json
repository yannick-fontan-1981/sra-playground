  "adaptation": {
    "sourcePrinciple": "L’énigme 11 fait progresser le Magicien à travers une grille de cristaux 3 × 3 par échanges successifs, avant un dernier transfert vers le côté de la sortie.",
    "changes": "SS23 conserve la grille pleine et la mobilité de la place de travail, mais remplace le bouton et le bloc de sortie du guide par un sas sec à deux accès décalés. Le Barde désaligne les rangées depuis des postes distincts, le Guerrier ouvre le port droit et le Marchand replace le Barde sans chant. Les neuf caisses restent présentes ; quatre destinations remplacent la sortie du personnage seul.",
    "limits": "Le plan et la coopération MWZB constituent une adaptation, pas une reproduction exacte. Les contrôles locaux comparent les premières cibles, la portée et les butées du chant ainsi que le replacement sans chant. Ils ne prouvent ni un ordre unique ni l’impossibilité globale sans une capacité.",
    "localChecks": [
      {
        "name": "Première cible et conservation des places",
        "observed": "Le premier échange atteint la caisse proche et laisse les deux autres caisses de sa rangée en place ; les neuf charges subsistent à chaque étape.",
        "scope": "Rejeu des premières commandes et du témoin complet ; aucune nécessité globale du rayon déduite."
      },
      {
        "name": "La poussée frontale ne remplace pas le premier désalignement",
        "observed": "Avant le chant inférieur, la rangée de trois caisses bute contre le mur de droite et refuse la poussée ; après le chant, le Guerrier entre dans la rangée libérée.",
        "scope": "Deux branches locales depuis le premier transfert du Magicien ; aucune impasse permanente revendiquée."
      },
      {
        "name": "Le décalage précède le dégagement haut",
        "observed": "Au centre, chanter vers le haut immédiatement est refusé. Décaler vers la droite puis monter permet le transport ; condamner la case haute de dégagement bloque cette montée.",
        "scope": "Comparaison locale du même poste du Barde et d’une variante de terrain avec une case fermée ; aucune impossibilité globale démontrée."
      },
      {
        "name": "Le replacement silencieux préserve les charges",
        "observed": "Les six poussées du Marchand amènent le Barde au centre sans déplacer une caisse. Un pas volontaire du Barde vers le haut déplace au contraire la caisse proche.",
        "scope": "Comparaison entre transport imposé et un pas chanté depuis le même état intermédiaire."
      },
      {
        "name": "Deux affectations gagnantes des destinations",
        "observed": "Le Marchand et le Magicien peuvent échanger leurs destinations finales, avec neuf caisses conservées et sans refus ni décès.",
        "scope": "Variante gagnante explicite ; pas d’affectation cachée d’une destination à un héros."
      }
    ]
  }
