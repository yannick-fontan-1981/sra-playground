  "adaptation": {
    "sourcePrinciple": "Le guide place le Voleur à l’extrémité de chaque tronçon avant la poussée et choisit le sens de traction pour préparer la suite.",
    "changes": "Les ricochets de pierres sont remplacés par une file de caisse et de miroir poussée par le Guerrier, puis par deux transports successifs d’une presse latérale. La commande ferme aussi la galerie du réceptionnaire. La première charge doit quitter le quai sans perdre le poids de commande : l’échange la dépose dans la baie du Magicien en remplaçant son poids, et un échange de partenaires maintient le relais de réception. Le miroir peut alors être réceptionné sur ce relais. Les deux commandes finales sont séparées ; aucun projectile, chronomètre ou pouvoir de ricochet n’est importé.",
    "limits": "La contre-branche établit la fermeture de l’accès après un envoi prématuré et la nécessité de rouvrir ce passage pour revenir à cette préparation. Elle ne prétend pas prouver une impasse définitive ni l’unicité de la route.",
    "localChecks": [
      {
        "name": "Réception préparée avant envoi",
        "observed": "Un envoi effectué avant le placement du Voleur ferme sa galerie ; son pas depuis la case voisine est refusé.",
        "scope": "Contre-branche locale reproduite dans review-middle-ss25.mjs ; rouvrir la commande reste une récupération autorisée."
      },
      {
        "name": "Le quai doit être libéré pour la deuxième charge",
        "observed": "Sans les échanges intermédiaires, la caisse reçue occupe encore la case où le Voleur doit se placer pour extraire le miroir.",
        "scope": "État obtenu par les mêmes deux envois, sans les échanges ; pas une preuve d’impasse définitive."
      },
      {
        "name": "Absence de poste inférieur de poussée",
        "observed": "L’eau nue sous le poste latéral interdit au Guerrier de s’y placer par marche pour remplacer directement cet envoi.",
        "scope": "Test du pas vers cette case, appuis et ressources inchangés."
      }
    ]
  }
}
