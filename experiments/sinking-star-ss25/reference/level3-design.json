  "adaptation": {
    "sourcePrinciple": "Le guide distingue une disposition espacée des plateformes pour aller et revenir d’une livraison, puis une disposition accolée pour disposer du poste nécessaire à une autre poussée.",
    "changes": "Deux appuis immergés desservent d’abord des baies séparées, au nord et au sud. Un convoi de deux caisses est fractionné : la tête est extraite vers le haut, la seconde charge passe à travers la colonne d’eau par échange, puis est extraite vers le bas. Les poids maintiennent deux portes tandis que les mêmes appuis doivent quitter les deux traversées initiales et former un pont central de deux cases. La Barde réalise les déplacements, puis le Voleur la dégage sans entraîner l’appui déjà rangé. Aucun courant, ricochet, Druide ou empilement supplémentaire n’est ajouté.",
    "limits": "La revue compare des configurations et des contre-gestes précis du témoin. Elle établit que les deux traversées latérales ne franchissent pas le chenal central, sans déclarer la route optimale ni exclure toute autre coopération légale.",
    "localChecks": [
      {
        "name": "Deux configurations des mêmes appuis",
        "observed": "Après les livraisons, les deux appuis séparés ne soutiennent pas le chenal central ; le pas de traversée est refusé. Les deux appuis deviennent ensuite voisins sans nouvelle caisse immergée.",
        "scope": "Ressources inchangées et états de la route reproduits ; pas d’exclusion de toute stratégie différente."
      },
      {
        "name": "Quitter le premier appui sans le reprendre",
        "observed": "Le départ volontaire de la Barde fait remonter l’appui déjà rangé, tandis que sa traction passive le conserve.",
        "scope": "Comparaison d’un contre-geste avec la relève effectivement exécutée."
      }
    ]
  }
}
