  "adaptation": {
    "kind": "adaptation",
    "preserved": [
      "Un monstre et une caisse servent de poids pour libérer les sorties.",
      "La transposition dépose une pièce sur une commande sans laisser la case vide."
    ],
    "changed": [
      "Le gardien est isolé dans un rail horizontal, derrière deux rangées de murs qui interdisent le chant et les visées.",
      "La poursuite déterministe de SS19 dépend du héros sélectionné, de sa position après l’action et de l’axe dominant ; ces détails ne sont pas attribués au guide.",
      "La réserve sort d’un coude aveugle par le chant, puis le Guerrier l’aligne avec le Magicien.",
      "Les trois destinations sont sur des presses liées au même accord de deux commandes.",
      "La carte, les coordonnées, le rail, l’îlot et le trajet sont propres à SS19."
    ],
    "sourceReading": "Heroes2 15 associe la transposition d’un monstre puis d’un cristal aux plaques. Heroes2 22 utilise les monstres comme poids à conserver. SS19 adapte cette logique avec un seul gardien mobile, une caisse unique, un relais de sélection et un îlot de commande.",
    "localChecks": [
      {
        "name": "Caisse indispensable",
        "observed": "À la victoire, les trois héros occupent les trois destinations, distinctes des commandes. Il ne reste que la caisse et le gardien pour les deux commandes. Immerger ou perdre la caisse rend cet accord final impossible.",
        "scope": "Argument de conservation des occupants, indépendant du témoin."
      },
      {
        "name": "Gardien sur une commande intérieure du rail",
        "observed": "La commande x11 ne se trouve ni à x5 ni à x15, les deux extrémités. Les murs verticaux n’arrêtent le gardien que si le héros actif est dans le cône vertical.",
        "scope": "Géométrie du rail et règle de poursuite du moteur."
      },
      {
        "name": "Aucune sortie accessible sans accord",
        "observed": "Chaque destination est la case d’une presse fermée tant que l’une des deux commandes est libre ; les héros ne peuvent pas contourner la condition en restant derrière une porte.",
        "scope": "Condition de victoire spatiale, sans verrou caché."
      }
    ]
  }
