  "adaptation": {
    "kind": "adaptation",
    "preserved": [
      "Un monstre et une caisse servent de poids pour libérer les sorties (Heroes 2, 15 et 22).",
      "La transposition remplace un occupant sur sa commande.",
      "Des presses poussent depuis des côtés inaccessibles aux héros (Heroes and Light, 1)."
    ],
    "changed": [
      "Le rail court comporte trois presses de couleurs distinctes et un bouton d’arrivée sur une quatrième case : aucune porte ne fait aussi office de bouton.",
      "Chaque monstre reste immobile tant qu’une force visible ne le déplace. Aucun déplacement automatique ne dépend de la sélection ou du placement d’un héros.",
      "La réserve sort du coude aveugle par le chant, puis le Guerrier l’aligne avec le Magicien.",
      "Les trois destinations sont des portes du même accord de deux commandes ; le rail, l’îlot, la géométrie et le trajet sont propres à SS19."
    ],
    "sourceReading": "Heroes 2 fournit la conservation des monstres et des caisses comme poids. Light 1 fournit le déplacement imposé par une presse. Cette carte originale combine ces mécanismes, sans reprendre un plateau commercial.",
    "localChecks": [
      {
        "name": "Deux poids indispensables",
        "observed": "À la victoire, les trois héros occupent les trois destinations distinctes des commandes du seuil. Seuls la caisse et le gardien peuvent tenir les deux boutons ; perdre l’un rend cet accord impossible.",
        "scope": "Conservation des occupants, indépendante du témoin."
      },
      {
        "name": "Trois commandes explicites",
        "observed": "Les boutons jaune, vert et orange ferment respectivement les presses en 14,3, 13,3 et 12,3. Le gardien arrive sur le bouton violet distinct en 11,3.",
        "scope": "Correspondance spatiale et circuits déclarés."
      },
      {
        "name": "Sorties sous accord",
        "observed": "Chaque destination est fermée tant que l’un des deux boutons violets est libre ; une fermeture expulse l’occupant avant la victoire.",
        "scope": "Condition spatiale, sans quota caché."
      }
    ]
  }
