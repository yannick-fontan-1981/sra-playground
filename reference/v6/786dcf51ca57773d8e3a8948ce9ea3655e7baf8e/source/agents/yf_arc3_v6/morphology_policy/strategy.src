MODULE v6.composition_strategy

WORKFLOW choose(request: Any) -> Any
    STATE
        session: Any
        trial: Any
    STEP open
        CALL families.begin(request=request) -> session
        NEXT examine
    STEP examine
        WHILE session.pending
            PROGRESS session.progress
            STOP WHEN session.done
            MAX DEPTH 16
            ON LIMIT DEFER unresolved
            DO
                CALL families.offer(session=session) -> trial
                IF trial.selected
                    CALL families.finish(session=session, trial=trial) -> session
                ELSE
                    CALL families.advance(session=session) -> session
        STOP session
