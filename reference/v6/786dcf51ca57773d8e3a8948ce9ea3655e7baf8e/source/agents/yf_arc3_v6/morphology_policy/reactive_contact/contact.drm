{
  "module_id": "v6.reactive_contact",
  "declarations": [
    {
      "id": "policy.reactive_contact",
      "kind": "schema",
      "premises": [
        "Input-compatible unique compact body across observed transitions; distinguish every other moving occurrence."
      ],
      "applicability": [
        "Persistent parent question from measured counteracted approach; current subject and retreat revalidated."
      ],
      "invariants": [
        "No claimed complete escape domain or capture physics; full measured masks retained."
      ],
      "falsifiers": [
        "Current control, subject, support or scope contradicted",
        "Interaction or followup fails to show common motion"
      ],
      "reason_refs": [
        "0.3.3.10-2",
        "0.1.1-5,5"
      ],
      "configuration": {
        "direction_prior": {
          "ACTION1": [
            0,
            -1
          ],
          "ACTION2": [
            0,
            1
          ],
          "ACTION3": [
            -1,
            0
          ],
          "ACTION4": [
            1,
            0
          ]
        },
        "operator_prior": "ACTION5",
        "priority": [
          "source81_composition",
          "parent_capture_contact_question",
          "parent_escape_configuration_access",
          "binding_followup",
          "contact_probe",
          "contact_access"
        ],
        "selection_order": [
          "cost_of_missing_manipulation_information",
          "peer_distance",
          "current_geometric_order"
        ],
        "hypotheses": [
          "The input-compatible observed body is the controlled actor, not every simultaneous mover",
          "Capture by contact is the parent hypothesis, not an acquired success law",
          "Existing dead-end guiding and modifying escape options remain competing strategies",
          "Current matching support class may admit access; destination occupancy is revalidated",
          "ACTION5 at current contact is a revisable local binding/state intervention prior",
          "Changed appearance alone is not attachment; nonpushing common translation is the next discriminant",
          "A revalidated common translation may move a current obstacle to alter a partial geometric escape domain; no complete flee law or capture proved",
          "Peer motion invalidates the static access suffix but does not erase independently observed transport",
          "Current adjacent directed contact may complete capture; only an official boundary confirms it; retain both masks and every other obstacle."
        ],
        "conditions": [
          {
            "field": "current_control_bound",
            "operator": "equals",
            "expected": true
          },
          {
            "field": "counteracted_approach_observed",
            "operator": "equals",
            "expected": true
          },
          {
            "field": "current_scope_and_input",
            "operator": "equals",
            "expected": true
          },
