            "operator": "equals",
            "expected": true
          },
          {
            "field": "current_exact_shape",
            "operator": "equals",
            "expected": true
          },
          {
            "field": "positive_axial_displacement",
            "operator": "equals",
            "expected": true
          }
        ],
        "contact_projections": [
          "projection.exploration.current_contact_opens_local_mechanism_question",
