            "operator": "equals",
            "expected": true
          },
          {
            "field": "common_action_for_locations",
            "operator": "equals",
            "expected": true
          }
        ],
        "kind_meaning": {
          "annotation_dependency": "Test access to a chart node whose annotation matches an intervening link; ownership and permission effects remain unknown.",
          "homologous_marker": "Test access to the distinct node sharing the initial anchored marker appearance, preserving acquired prerequisites."
        },
        "semantics": {
          "goal": "same_interior_annotation_as_current_anchor",
          "dependency": "node_annotation_matches_link_annotation",
          "unmatched_colored_nodes": "exclude_from_route_while_testing_related_nodes",
          "consumed_token": "boundary_change_is_permission_hypothesis_not_confirmed_door_law"
