        "max_location_alternatives": 32,
        "scene_equality": "retain_stay_and_projected_arrival_without_collision_claim",
        "continuation_under_ambiguity": "require_same_next_direction_toward_same_composition_for_every_location",
        "conditional_boundary_anchor": "match_explicit_link_annotation"
