          "load",
          "transform",
          "receive"
        ],
        "interface_dependency_depth": 2,
        "interface_operand_relation": "preserve_displayed_left_to_right_order_until_a_permutation_is_observed",
        "interface_learning_rules": [
          {
            "id": "projection.symbol_interface.observed_select",
