        "question": "Test the currently indicated interface contribution, retaining guide, selection, feedback and decoration as competing explanations.",
        "composition_role": "information_question",
        "goal": "G_official_completion",
        "preserve": [
          "other_loaded_supports",
          "other_observed_requests",
          "unselected_occurrences"
        ],
        "hypotheses": [
          "supposition.frame_indicates_instruction",
          "supposition.frame_indicates_selection",
          "supposition.frame_indicates_feedback",
          "supposition.frame_is_decoration"
        ],
        "expected_effect": "Observe a current selection, transfer, transformation or request change; do not assume that a halo is an acquired guide.",
        "falsifiers": [
          "no_discriminating_change",
          "different_current_center",
          "competing_spaced_frames",
          "unpredicted_change_of_other_compositions",
          "scope_changed"
        ],
