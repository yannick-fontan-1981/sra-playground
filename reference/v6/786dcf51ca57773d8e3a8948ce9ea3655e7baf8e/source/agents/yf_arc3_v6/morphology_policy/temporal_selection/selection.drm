        "questions": {
          "point_control": "Test whether pointing the unique nearest currently supported stationary occurrence exposes a local control after an observed autonomous trace; selection, editing, mechanical influence and terminal role remain unknown.",
          "lateral_edit_experiment": "Use the observed point-to-destination edit under current exact mask and overlay correspondence to place this occurrence one measured visual period laterally beside the penultimate observed forward trace sample, on its original side. This offset is a declared experimental hypothesis, not an acquired orbital radius. Preserve the initial complete connected body and other occurrences. When composing the second locus, the half-turn and boundary interruption are explicit competing hypotheses, never an observed type law.",
          "launch_changed_arrangement": "Reissue the command observed to return an autonomous animation after the measured edit. Compare unchanged trace, contact, and local deviation around the edited locus; no turn angle, orbital table or success predicted.",
          "recalled_launch": "Recall the command that returned a scoped autonomous trajectory and official boundary, after uniquely revalidating the complete current body template and currently supported compact occurrences. Its effect in this new scope is unknown; acquire the new returned trajectory without carrying prior positions, radius or turn law."
        },
        "lateral_experiment": {
          "offset": "one_current_visual_period",
          "anchor": "penultimate_distinct_forward_observed_sample",
          "side": "same_as_original_occurrence",
          "result_alternatives": [
            "unchanged_trajectory",
            "contact",
            "deviation_near_locus",
            "unresolved"
          ]
        },
        "second_locus_question": {
          "diameter_multiplier": 2,
          "alternatives": [
            "no_deviation",
            "quarter_turn",
            "half_turn",
            "three_quarter_turn",
            "other_or_unresolved"
          ],
          "meaning": "Observed new corridor and lateral offset permit a conditional geometric half-turn preimage toward a unique measured boundary interruption. The second occurrence type and target terminal role are unknown. Preserve the first edited occurrence and initial body. Choose the least point-edit distance among currently clear placements; equal alternatives abstain."
        },
