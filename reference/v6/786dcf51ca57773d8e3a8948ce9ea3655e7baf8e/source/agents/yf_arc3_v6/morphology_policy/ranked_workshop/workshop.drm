    {
      "id": "schema.ranked_workshop_reuse",
      "kind": "schema",
      "premises": [
        "ranked_profiles_current",
        "reference_cuts_current",
        "public_control_mode_change_observed"
      ],
      "applicability": [
        "factored_material_return"
      ],
      "invariants": [
        "no_game_id_or_oracle_state",
        "former_DRM_is_conditional_knowledge_not_old_runtime_authority",
        "equality_is_not_accepted_receipt",
        "focus_is_not_grasp",
