      ],
      "meaning_template_ref_by_alternative": {
        "cell_supports.propose_growth": "rule.cell_support_growth"
      },
      "reason_refs": [
        "reason.current_cell_support_grows_without_gauge_requirement"
      ]
    },
    {
      "id": "rule.cell_support_growth",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
