          "iteration": {
            "source_field": "cell_support_growth_rows",
            "item_bindings": {
              "geometry_digest": "geometry_digest",
              "cell_count": "cell_count",
              "previous_cell_count": "previous_cell_count"
            },
            "max_items": 3
          },
          "all_conditions": [
            {
              "field": "previous_cell_count",
              "operator": "greater_than",
              "expected": 0
            }
          ]
        },
        {
          "id_pattern": "observation.cell_support_appearance.{geometry_digest}.{scope_ref}",
          "kind": "schema",
