      ],
      "reason_refs": [
        "reason.current_cell_support_grows_without_gauge_requirement"
      ],
      "term_templates": [
        {
          "id_pattern": "supposition.cell_support_growth.{geometry_digest}",
          "kind": "schema",
          "label": "observed increasing cell support",
          "required_fields": [
            "geometry_digest",
            "cell_count",
            "support_values",
            "previous_cell_count",
            "current_cell_indices"
          ],
          "static_attributes": {
            "projection_contract": "yf_arc3_v5.cell_support_growth.v1",
            "commitment": "revisable",
            "canonical_fact_projection_enabled": true
          },
          "attribute_bindings": {
            "geometry_digest": "geometry_digest",
            "top": "top",
            "left": "left",
            "bottom": "bottom",
            "right": "right",
            "pitch": "pitch",
            "cell_count": "cell_count",
            "row_count": "row_count",
            "column_count": "column_count",
            "support_values": "support_values",
            "previous_cell_indices": "previous_cell_indices",
            "previous_cell_count": "previous_cell_count",
            "current_cell_count": "current_cell_count",
            "current_cell_indices": "current_cell_indices",
            "measurement_frame_ref": "measurement_frame_ref"
          },
          "iteration": {
            "source_field": "cell_support_growth_rows",
            "item_bindings": {
              "geometry_digest": "geometry_digest",
              "top": "top",
              "left": "left",
              "bottom": "bottom",
              "right": "right",
              "pitch": "pitch",
              "cell_count": "cell_count",
              "row_count": "row_count",
              "column_count": "column_count",
              "support_values": "support_values",
              "previous_cell_indices": "previous_cell_indices",
              "previous_cell_count": "previous_cell_count",
              "current_cell_count": "current_cell_count",
              "current_cell_indices": "current_cell_indices"
            },
            "max_items": 3
          },
          "all_conditions": [
            {
              "field": "previous_cell_count",
              "operator": "greater_than",
              "expected": 0
            }
          ]
        },
        {
          "id_pattern": "goal.full_support_coverage_from_growth.{geometry_digest}",
          "kind": "goal",
          "label": "test full coverage of the observed support domain",
          "required_fields": [
            "geometry_digest",
            "cell_count"
