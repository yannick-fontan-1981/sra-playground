{
  "module_id": "cell_support_growth",
  "declarations": [
    {
      "id": "policy.cell_support_growth",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "canonical_equivalence_tie_break_debt_ref": "debt.canonical_lexicographic_equivalence_tie_break",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "premises": [
        "sealed_action_conditioned_cell_support_growth"
      ],
      "applicability": [
        "current_measured_support_growth"
      ],
      "invariants": [
        "no_instance_palette_or_geometry",
        "support_growth_is_revisable",
        "gauge_is_optional_corroboration",
        "no_unique_visit_or_terminal_endpoint_inferred",
        "old_unrefuted_hypotheses_preserved"
      ],
      "falsifiers": [
        "current_geometry_or_support_growth_is_contradicted"
      ],
      "declared_alternative_refs": [
        "cell_supports.propose_growth",
        "cell_supports.retain_unknown"
      ],
      "fact_projections": [
        {
          "id": "projection.cell_supports.propose",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cell_supports.propose_growth"
            },
            {
              "field": "cell_support_growth_count",
              "operator": "equals",
              "expected": 1
            }
          ],
          "static_facts": {
            "applicable": true
          }
        },
        {
          "id": "projection.cell_supports.unknown",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cell_supports.retain_unknown"
            }
          ],
          "static_facts": {
            "applicable": true
          }
        }
      ],
      "selection_eligibility_conditions": [
        {
          "field": "applicable",
          "operator": "equals",
          "expected": true
        }
      ],
      "selection_tiers": [
        {
          "id": "tier.cell_supports.propose",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cell_supports.propose_growth"
            }
          ],
          "reason_ref": "reason.current_cell_support_grows_without_gauge_requirement"
        },
        {
          "id": "tier.cell_supports.unknown",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cell_supports.retain_unknown"
            }
          ],
