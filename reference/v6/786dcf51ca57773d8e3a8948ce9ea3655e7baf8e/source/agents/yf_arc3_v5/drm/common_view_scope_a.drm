{
  "module_id": "common_view_scope_a",
  "declarations": [
    {
      "id": "policy.common_view_scope_a",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.common_view_scope_from_actual_observations",
        "reason.joystick_observed_acquisition_unknown"
      ],
      "declared_alternative_refs": [
        "common_view_scope_a.current",
        "common_view_scope_a.unknown"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.common_view_scope_equivalent_observed_support",
      "selection_tiers": [
        {
          "id": "tier.joystick_acq.mask",
          "reason_ref": "reason.common_view_scope_from_actual_observations",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "common_view_scope_a.current"
            },
            {
              "field": "measurement_complete",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "scope_current",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.joystick_acq.unknown",
          "reason_ref": "reason.joystick_observed_acquisition_unknown",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "common_view_scope_a.unknown"
            }
          ]
        }
      ],
      "meaning_template_ref_by_alternative": {
        "common_view_scope_a.current": "rule.common_view_scoped_packet_a"
      },
      "configuration": {}
    },
    {
      "id": "rule.common_view_scoped_packet_a",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "reason_refs": [
        "reason.common_view_scope_from_actual_observations"
      ],
      "invariants": [
        "no_action_from_recognition",
        "no_raster_state_quotient",
        "no_default_pairwise_reduction",
        "no_extra_reserved_occurrence"
      ],
      "term_templates": [
        {
          "id_pattern": "{output_term_ref}",
          "kind": "value",
          "label": "Current common view and relation scope",
          "required_fields": [
            "output_term_ref",
            "values",
            "values_digest",
            "operation",
            "request_ref",
            "parent_goal_ref",
            "consumer_ref",
            "next_item_ref",
            "epoch",
            "evidence_revision_ref",
            "model_revision_ref",
            "frame_ref"
          ],
          "static_attributes": {
            "projection_contract_ref": "common_view.scoped_packet_a.v1"
          },
          "attribute_bindings": {
            "values": "values",
            "values_digest": "values_digest",
            "operation": "operation",
            "request_ref": "request_ref",
            "parent_goal_ref": "parent_goal_ref",
            "consumer_ref": "consumer_ref",
            "next_item_ref": "next_item_ref",
            "epoch": "epoch",
            "evidence_revision_ref": "evidence_revision_ref",
            "model_revision_ref": "model_revision_ref",
            "frame_ref": "frame_ref"
          }
        }
      ],
      "claim_templates": [
        {
          "id_pattern": "{output_claim_ref}",
          "predicate": "qualifies_common_view_scope_a",
          "family": "epistemic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "{output_term_ref}"
          ],
          "required_term_patterns": [
            "{output_term_ref}"
          ],
          "required_fields": [
            "output_claim_ref",
            "output_term_ref",
            "values",
            "values_digest",
            "operation",
            "request_ref",
            "parent_goal_ref",
            "consumer_ref",
            "next_item_ref",
            "epoch",
            "evidence_revision_ref",
            "model_revision_ref",
            "frame_ref"
          ],
          "scope_bindings": {
            "epoch": "epoch",
            "parent_goal_ref": "parent_goal_ref"
          },
          "attribute_bindings": {
            "values": "values",
            "values_digest": "values_digest",
            "operation": "operation",
            "request_ref": "request_ref",
            "parent_goal_ref": "parent_goal_ref",
