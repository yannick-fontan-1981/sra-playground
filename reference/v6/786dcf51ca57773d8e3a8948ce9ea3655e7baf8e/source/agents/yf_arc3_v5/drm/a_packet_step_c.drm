      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "premises": [
        "current_source_prebound_complete_native_packet"
      ],
      "applicability": [
        "one_family_step"
      ],
      "invariants": [
        "one_native_owner",
        "native_cost_once",
        "retained_unknowns",
        "no_physical_release"
      ],
      "falsifiers": [
        "wrong_identity",
        "stale_model",
        "missing_native_ledger"
      ],
      "selection_required_fact_fields": [
        "alternative_ref"
      ],
      "declared_alternative_refs": [
        "oriented_passage_packet.supported",
        "oriented_passage_packet.unsupported"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "applicable",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.policy.oriented_passage_packet_signature_c.supported",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "oriented_passage_packet.supported"
            },
            {
              "field": "exact_prebound_native_signature",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "operation_ref",
              "operator": "equals",
              "expected": "mechanics.oriented_passage.external_primitive"
            },
            {
              "field": "kernel_ref",
              "operator": "equals",
              "expected": "mechanics.oriented_passage"
            },
            {
              "field": "model_assignment_ref",
              "operator": "equals",
              "expected": "endpoint_model_ref"
            },
            {
              "field": "native_status_ref",
              "operator": "equals",
              "expected": "ACTIVE"
            },
            {
              "field": "native_packet_field_ref",
              "operator": "equals",
              "expected": "primitive_packet"
            },
            {
              "field": "native_cost_field_ref",
              "operator": "equals",
              "expected": "actual_primitive_cost"
