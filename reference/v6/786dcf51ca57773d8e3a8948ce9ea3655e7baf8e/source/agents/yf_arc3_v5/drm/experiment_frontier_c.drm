    {
      "id": "policy.experiment_frontier_c",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "premises": [
        "one_current_instrumental_or_understanding_question_has_an_explicit_response_domain_and_risk"
      ],
      "applicability": [
        "useful_experiment_or_validated_continuation_frontier"
      ],
      "invariants": [
        "private_answer_is_not_observable_evidence",
        "operation_and_benefit_remain_distinct",
        "unknown_models_remain_explicit",
        "overlapping_response_sets_are_not_disjoint_model_partitions",
        "possible_information_gain_is_not_guaranteed_discrimination",
        "unlisted_response_does_not_falsify_an_open_outcome_domain",
        "understanding_does_not_require_a_fabricated_game_beneficiary",
        "curiosity_preserves_validated_continuations_and_its_explicit_cost_and_stop_contract",
        "unknown_cost_loss_or_budget_is_not_zero_or_unlimited",
        "partial_cost_values_remain_obligations_without_authorizing_an_experiment",
        "no_reset_is_free",
        "no_action_release"
      ],
      "falsifiers": [
        "stale_or_unsealed_scope",
        "indistinguishable_observations",
        "unbounded_recovery_or_missing_manual_contract"
      ],
      "selection_required_fact_fields": [
        "alternative_ref"
      ],
      "declared_alternative_refs": [
        "experiment.end_cost_limited_trial",
        "experiment.await_current_scope",
        "experiment.await_observed_result",
        "experiment.reuse_current_evidence",
        "experiment.continue_robust_contribution",
        "experiment.review_observed_result",
        "experiment.require_scoped_manual_contract",
        "experiment.retain_recovery_boundary",
        "experiment.defer_understanding",
        "experiment.test_observed_whole_code",
        "experiment.probe_operation",
        "experiment.probe_usefulness",
        "experiment.retain_observable_ambiguity"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "applicable",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.experiment_frontier_c.possible_information",
          "all_conditions": [
            {"field": "observable_models_distinguishable", "operator": "equals", "expected": true},
            {"field": "observable_discrimination_guaranteed_within_models", "operator": "equals", "expected": false}
          ],
          "static_facts": {
            "information_expectation": "possible_discrimination_with_ambiguous_outcomes_retained",
            "information_gain_guaranteed": false,
            "ambiguous_observation_requires_reconsidering_the_question": true
          }
        },
        {
          "id": "projection.experiment_frontier_c.guaranteed_within_declared_models",
          "all_conditions": [
            {"field": "observable_discrimination_guaranteed_within_models", "operator": "equals", "expected": true}
          ],
          "static_facts": {
            "information_expectation": "strict_narrowing_for_each_declared_outcome",
            "information_gain_guaranteed_only_within_declared_models": true,
            "unpredicted_response_requires_reopening_models": true
          }
        },
        {
          "id": "projection.experiment_frontier_c.identical_or_unbound_responses",
          "all_conditions": [
            {"field": "observable_models_distinguishable", "operator": "equals", "expected": false},
            {"field": "question_kind", "operator": "equals", "expected": "MODEL_DISCRIMINATION"}
          ],
          "static_facts": {
            "information_expectation": "no_bound_discriminating_outcome",
            "requires_different_operation_condition_or_observable": true
          }
        },
        {
          "id": "projection.experiment_frontier_c.end_cost_limited_trial",
          "all_conditions": [
            {"field": "alternative_ref", "operator": "equals", "expected": "experiment.end_cost_limited_trial"},
            {"field": "observed_return_current", "operator": "equals", "expected": true},
            {"field": "observed_understanding_cost_limit_reached", "operator": "equals", "expected": true}
          ],
          "static_facts": {"applicable": true, "disposition_ref": "experiment.end_cost_limited_trial"}
        },
        {
          "id": "projection.experiment_frontier_c.await_observed_result",
          "all_conditions": [
            {"field": "alternative_ref", "operator": "equals", "expected": "experiment.await_observed_result"},
            {"field": "understanding_observation_incomplete", "operator": "equals", "expected": true}
          ],
          "static_facts": {"applicable": true, "disposition_ref": "experiment.await_observed_result"}
        },
        {
          "id": "projection.experiment_frontier_c.review_observed_result",
