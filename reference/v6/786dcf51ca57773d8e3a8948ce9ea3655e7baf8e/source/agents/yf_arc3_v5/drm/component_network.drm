{
  "module_id": "component_network",
  "declarations": [
    {
      "id": "principle.action_conditioned_openings_license_revisable_component_network",
      "kind": "principle",
      "family_ref": "family.interaction_evidence",
      "abstraction_level": "causal_variant",
      "premises": [
        "persistent_unit_openings_are_observed",
        "recoloring_beyond_the_clicked_unit_is_observed_or_remains_a_declared_alternative"
      ],
      "applicability": [
        "conditional_topology_and_origin_provenance_after_local_editing"
      ],
      "invariants": [
        "test_roles_and_forward_effects_before_model_admission",
        "keep_origins_separate_from_displayed_mixed_values",
        "simulate_requests_together_and_preserve_budget_and_other_requests",
        "unacquired_mixtures_remain_unknown",
        "conditional_fit_does_not_assert_a_universal_world_law",
        "source_selects_roles_goals_models_and_actions"
      ],
      "falsifiers": [
        "the_model_disagrees_with_current_scene_or_next_observed_effect",
        "a_role_assignment_or_goal_is_not_supported_by_its_markers_and_effects"
      ],
      "reason_refs": [
        "reason.action_conditioned_unit_and_budget_license_conditional_network_test"
      ]
    },
    {
      "id": "policy.component_network_geometry_scope",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "declared_alternative_refs": [
        "component_network.calculate_conditional_models",
        "component_network.retain_unknown"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "applicable",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.component_network.geometry_scope",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "component_network.calculate_conditional_models"
            },
            {
              "field": "network_geometry_scope_unique",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "network_resource_measurement_present",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "committed_plan_present",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "applicable": true,
            "network_contract": {
              "model_ref": "hypothesis.revisable_component_origin_network",
              "model_kind": "monotone_component_union_pure_domain",
              "empty_content_query": "common_receiver_background_or_retained_value",
              "domain_query": "bbox_of_observed_editable_signature",
              "neighbor_deltas": [
                [
                  -1,
                  0
                ],
                [
                  0,
                  1
                ],
                [
                  1,
                  0
                ],
                [
                  0,
                  -1
                ]
              ],
              "role_profiles": [
                {
                  "alternative_ref": "component_network.radial_emitters",
                  "emitter_query": {
                    "mask": "cardinal",
                    "value_field": "center_value"
                  },
                  "receiver_query": {
                    "mask": "diagonal",
                    "value_field": "marker_value"
                  }
                },
                {
                  "alternative_ref": "component_network.corner_emitters",
                  "emitter_query": {
                    "mask": "diagonal",
                    "value_field": "marker_value"
                  },
                  "receiver_query": {
                    "mask": "cardinal",
                    "value_field": "center_value"
                  }
                }
              ],
              "maximum_cell_count": 1024,
              "maximum_marker_radius": 8,
              "maximum_expansions": 32768,
              "maximum_path_length": 256,
              "maximum_admitted_point_additions": 1,
              "route_descriptions": [
                "increasing_separation",
                "decreasing_separation",
                "measurement_order"
              ],
              "cost_measure": "new_cells_then_edges",
              "resource_cost_normalization": "one_observed_debit_per_new_unit",
              "mixed_origin_values": "unknown",
              "unacquired_union_binding": "two_unreserved_unique_originals",
              "route_dependency": "singleton_demands_precede_unacquired_origin_union",
              "maximum_opened_set_states": 32768,
              "previous_scene_is_not_current_transition_across_instance_boundary": true,
              "one_original_preserves_its_value": true,
              "empty_components_have_no_origin": true,
              "all_induced_contacts_are_included": true,
              "pure_demand_components_must_remain_compatible": true,
              "world_impossibility_from_failed_orders": false,
              "point_action_ref": "ACTION6",
              "unknown_model_ref": "component_network.model_unknown",
              "unknown_route_ref": "component_network.route_unknown"
            }
          }
        },
        {
          "id": "projection.component_network.unknown_scope",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "component_network.retain_unknown"
            }
          ],
          "static_facts": {
            "applicable": true
          }
        }
      ],
      "selection_tiers": [
        {
          "id": "tier.component_network.measured_scope",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "component_network.calculate_conditional_models"
            }
          ],
          "reason_ref": "reason.action_conditioned_unit_and_budget_license_conditional_network_test"
        },
        {
          "id": "tier.component_network.unknown_scope",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "component_network.retain_unknown"
            }
          ],
          "reason_ref": "reason.incomplete_network_scope_preserves_other_questions"
        }
      ],
      "premises": [
        "persistent_complete_unit_replacement_with_repeated_preimage_or_current_revalidated_model",
        "current_measured_resource_quantity"
      ],
      "invariants": [
        "roles_remain_hypotheses_until_full_scene_and_transition_fit",
        "origin_sets_are_not_visible_color_names",
        "no_hard_coded_game_palette_coordinate_or_count",
        "three_route_descriptions_are_not_exhaustive_path_enumeration",
        "unknown_is_not_world_impossibility"
      ],
      "falsifiers": [
        "scene_transition_or_resource_contradicts_model"
      ],
      "reason_refs": [
        "reason.current_conditional_component_network_witness"
      ],
      "selection_tie_breakers": [
        {
          "field": "network_resource_measurement_present",
          "preferred_order": "minimize"
        }
      ]
    },
