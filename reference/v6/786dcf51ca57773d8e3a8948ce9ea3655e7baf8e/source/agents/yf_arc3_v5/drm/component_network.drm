    {
      "id": "rule.revisable_component_network_memory",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "relation_family": "structural",
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "premises": [
        "unique_current_role_assignment_and_full_scene_transition_fit",
        "measured_resource_debit_anchors_action_conditioned_opening"
      ],
      "invariants": [
        "original_values_and_demands_survive_recoloring",
        "model_acquisition_is_same_game_and_current_witness_is_level_scoped",
        "model_term_never_authorizes_an_action"
      ],
      "falsifiers": [
        "current_or_next_scene_contradicts_conditional_model"
      ],
      "term_templates": [
        {
          "id_pattern": "model.component_network.{level_index}.{geometry_token}",
          "kind": "schema",
          "label": "revisable component origin network",
          "required_fields": [
            "model",
            "level_index",
            "geometry_token",
            "frame_ref"
          ],
          "static_attributes": {
            "projection_contract": "yf_arc3_v5.revisable_component_network.v1",
            "commitment": "revisable",
            "action_authorization": false,
            "canonical_fact_projection_enabled": true
          },
          "attribute_bindings": {
            "model": "model",
            "level_index": "level_index",
            "measurement_ref": "measurement_ref",
            "scope_counter": "scope_counter",
            "model_signature": "model_token",
            "acquisition_observation_ref": "frame_ref"
          },
          "all_conditions": [
            {
              "field": "prior_model_present",
              "operator": "equals",
              "expected": false
            }
          ]
        },
        {
          "id_pattern": "goal.satisfy_current_component_demands",
          "kind": "schema",
          "label": "satisfy current component demands together",
          "required_fields": [
            "model"
          ],
          "static_attributes": {
            "projection_contract": "yf_arc3_v5.component_network_goal.v1",
            "goal_ref": "goal.satisfy_current_component_demands",
            "commitment": "revisable",
            "action_authorization": false
          },
          "attribute_bindings": {
            "model": "model",
            "level_index": "level_index",
            "scope_counter": "scope_counter"
          },
          "all_conditions": [
            {
              "field": "prior_model_present",
              "operator": "equals",
              "expected": false
            }
          ]
        },
        {
          "id_pattern": "witness.component_network.{frame_token}.{word_token}",
          "kind": "schema",
          "label": "current conditional component word and resource witness",
          "required_fields": [
            "model",
            "frame_ref",
            "word_cells",
            "scope_counter",
            "component_network_model_term_ref",
            "resource_claim_refs"
          ],
          "static_attributes": {
            "projection_contract": "yf_arc3_v5.current_component_network_witness.v1",
            "action_authorization": false,
            "conditional_model_not_world_law": true
          },
          "attribute_bindings": {
            "model_ref": "component_network_model_term_ref",
            "model_claim_ref": "component_network_model_claim_ref",
            "model_signature": "model_token",
            "scope_counter": "scope_counter",
            "observation_ref": "frame_ref",
            "measurement_ref": "measurement_ref",
            "word_ref": "word_ref",
            "word_cells": "word_cells",
            "resource_premise_claim_refs": "resource_claim_refs",
            "remaining_quantity": "remaining_quantity",
            "all_prefixes_valid": "network_all_prefixes_valid",
            "operational_scene_ref": "frame_ref"
          }
        },
        {
          "id_pattern": "expectation.component_network.{frame_token}.{word_token}",
          "kind": "schema",
          "label": "next new component unit preserves current conditional full witness",
          "required_fields": [
            "word_cells",
            "frame_ref"
          ],
          "static_attributes": {
            "conditional": true,
            "requires_sealed_response": true
          },
          "attribute_bindings": {
            "model_ref": "component_network_model_term_ref",
            "current_witness_ref": "component_network_witness_term_ref",
            "word_cells": "word_cells",
            "observation_ref": "frame_ref"
          }
        }
      ],
      "reason_refs": [
        "reason.current_conditional_component_network_witness"
      ],
      "claim_templates": [
