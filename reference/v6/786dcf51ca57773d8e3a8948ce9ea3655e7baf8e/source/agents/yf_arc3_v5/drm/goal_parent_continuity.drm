            {"field": "child_completion_claim_count", "operator": "equals_reference_field", "reference_field": "child_lifecycle_claim_count"},
            {"field": "child_current_effect_proof_count", "operator": "equals_reference_field", "reference_field": "child_lifecycle_claim_count"}
