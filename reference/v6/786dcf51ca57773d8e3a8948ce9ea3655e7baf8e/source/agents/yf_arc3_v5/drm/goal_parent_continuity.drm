              "field": "event_ref",
              "operator": "equals",
              "expected": "context_stack.return_local_execution"
            },
            {
              "field": "scope_matches",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "execution_return_matches",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "stack_update_allowed": true,
            "stack_transition_ref": "context_stack.reconcile_local_execution",
            "result_execution_context_ref": null,
            "result_execution_intent_refs": []
