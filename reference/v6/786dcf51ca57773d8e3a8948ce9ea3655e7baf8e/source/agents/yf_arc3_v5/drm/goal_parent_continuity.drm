{
  "module_id": "goal_parent_continuity",
  "declarations": [
    {
      "id": "policy.parent_child_effect_consumption",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "declared_alternative_refs": ["parent.child_effect_consumption"],
      "selection_eligibility_conditions": [{"field": "applicable", "operator": "equals", "expected": true}],
      "invariants": ["an_answer_is_not_automatically_a_satisfied_condition", "consumption_never_grants_act", "unrelated_dependencies_remain_unchanged"],
      "fact_projections": [
        {
          "id": "projection.parent_child_effect.not_required",
          "all_conditions": [],
          "static_facts": {"applicable": true, "child_effect_consumption_required": false,
            "child_effect_consumption_accepted": false, "child_effect_consumption_grants_act": false,
            "child_effect_applied_dependency_refs": [], "child_effect_enabled_continuation_refs": [],
            "child_effect_repair_requirement_refs": []}
        },
        {
          "id": "projection.parent_child_effect.require_current_receipt",
          "all_conditions": [
            {"field": "child_return_present", "operator": "equals", "expected": true},
            {"field": "parent_scope_matches", "operator": "equals", "expected": true},
            {"field": "parent_continuity_allows_candidate", "operator": "equals", "expected": true},
            {"field": "child_return_matches_required_dependency", "operator": "equals", "expected": true}
          ],
          "static_facts": {"child_effect_consumption_required": true,
            "child_effect_consumption_disposition_ref": "child_effect.refused_current_dependency_unproved",
            "child_effect_continuation_allowed": false,
            "child_effect_requires_revalidation": true,
            "child_effect_repair_requirement_refs": ["requirement.revalidate_exact_child_effect_and_remaining_dependencies"]}
        },
        {
          "id": "projection.parent_child_effect.accept_current_dependency_effect",
          "all_conditions": [
            {"field": "child_effect_consumption_required", "operator": "equals", "expected": true},
            {"field": "child_return_canonical", "operator": "equals", "expected": true},
            {"field": "child_return_scope_matches", "operator": "equals", "expected": true},
            {"field": "child_return_parent_matches", "operator": "equals", "expected": true},
            {"field": "child_return_effect_claim_count", "operator": "greater_than", "expected": 0},
            {"field": "child_return_current_effect_claim_count", "operator": "equals_reference_field", "reference_field": "child_return_effect_claim_count"},
            {"field": "child_return_prerequisite_count", "operator": "equals_reference_field", "reference_field": "child_return_completed_prerequisite_count"},
            {"field": "parent_continuity_allows_candidate", "operator": "equals", "expected": true}
          ],
          "static_facts": {"child_effect_consumption_accepted": true,
            "child_effect_consumption_disposition_ref": "child_effect.consumed_for_current_parent_continuation",
            "child_effect_continuation_allowed": true, "child_effect_requires_revalidation": false,
            "child_effect_repair_requirement_refs": []},
          "bound_facts": {"child_effect_applied_dependency_refs": "child_return_dependency_refs",
            "child_effect_enabled_continuation_refs": "child_return_candidate_refs"}
        }
      ],
      "reason_refs": ["reason.consume_current_child_effect_without_replanning_parent"]
    },
    {
      "id": "policy.parent_goal_why_measurement",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "premises": ["a_root_definition_owns_a_falsifier_for_the_root_it_defines"],
      "applicability": ["scoped_frontier_declarations_supply_parent_why_evidence"],
      "invariants": [
        "a_question_attached_to_a_terminal_does_not_define_its_root_why",
        "focus_variants_of_one_exact_contract_retain_every_origin_and_scope_proof",
        "distinct_owned_contracts_remain_ambiguous",
        "an_explicit_source_candidate_identity_qualifies_only_its_current_owned_contract",
        "an_action_goal_refinement_does_not_inherit_a_sibling_activation_identity",
        "candidate_identity_never_replaces_an_engaged_parent_why",
        "why_measurement_grants_no_action_authority"
      ],
      "falsifiers": ["a_child_only_falsifier_is_borrowed_from_the_root_graph", "conflicting_why_fields_are_coalesced"],
      "declared_alternative_refs": ["measurement.parent_goal_why_contract"],
      "selection_eligibility_conditions": [{"field": "applicable", "operator": "equals", "expected": true}],
      "fact_projections": [{
        "id": "projection.parent_goal_why.owned_exact_contract",
        "all_conditions": [],
        "static_facts": {
          "applicable": true,
          "definition_goal_falsifier_min_count": 1,
          "candidate_activation_identity_binding_field": "activation_ref",
          "candidate_activation_identity_terminal_binding_field": "terminal_goal_refs",
          "coalesced_reference_fields": ["canonical_origin_refs", "canonical_scope_proof_refs"],
          "equivalence_fields": [
            "parent_goal_ref", "source_activation_ref", "guiding_principle_ref", "premise_claim_refs",
            "support_claim_refs", "activation_reason_refs", "falsifier_refs", "access_condition_refs",
            "expected_goal_delta_refs", "expected_effect_signature_refs", "parent_goal_refs",
            "prerequisite_goal_refs", "declared_parent_goal_pairs", "declared_goal_falsifier_pairs",
            "operational_goal_hypotheses"
          ]
        }
      }],
      "reason_refs": ["reason.parent_why_requires_owned_definition_and_exact_equivalence"]
    },
    {
      "id": "policy.reasoning_context_stack_transition",
      "configuration": {
        "child_effect_contract": {
          "lifecycle_predicate_ref": "goal_lifecycle_status",
          "lifecycle_status_attribute_ref": "lifecycle_status",
          "completion_status_refs": ["locally_satisfied", "achieved"],
          "epistemic_status_refs": ["supported", "established"],
          "active_disposition_ref": "active",
          "positive_polarity_ref": "positive",
          "successful_operation_status_ref": "completed"
        }
      },
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "declared_alternative_refs": [
        "context_stack.current_transition"
      ],
      "premises": [
        "the_canonical_goal_graph_owns_dependencies_and_source_declares_the_active_path"
      ],
      "applicability": [
        "a_source_context_entry_or_native_return_requires_reconciliation"
      ],
      "invariants": [
        "a_context_stack_never_grants_act",
        "a_child_return_never_closes_its_parent",
        "a_prepared_sibling_never_replaces_the_dispatched_context",
        "ambiguous_native_alternatives_remain_addressable_in_the_original_checkpoint"
      ],
      "falsifiers": [
        "a_foreign_return_mutates_the_stack",
        "a_local_lease_lacks_its_declared_context",
        "the_parent_why_is_rewritten_by_a_child"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "applicable",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.context_stack.default_preservation",
          "all_conditions": [],
          "static_facts": {
            "applicable": true,
            "stack_update_allowed": false,
            "stack_transition_ref": "context_stack.preserve",
            "stack_grants_act": false,
            "parent_goal_closed": false
