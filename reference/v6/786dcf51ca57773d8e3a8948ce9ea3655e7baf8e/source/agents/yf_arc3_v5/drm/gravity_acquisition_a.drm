{
  "module_id": "gravity_acquisition_a",
  "declarations": [
    {
      "id": "policy.gravity_acquisition_a",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.gravity_acquisition_from_actual_observations",
        "reason.gravity_observed_acquisition_unknown"
      ],
      "declared_alternative_refs": [
        "gravity_acquisition_a.current",
        "gravity_acquisition_a.unknown"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.gravity_acquisition_equivalent_observed_support",
      "selection_tiers": [
        {
          "id": "tier.gravity_acq.mask",
          "reason_ref": "reason.gravity_acquisition_from_actual_observations",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "gravity_acquisition_a.current"
            },
            {
              "field": "acquisition_complete",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "owner_bindings_current",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.gravity_acq.unknown",
          "reason_ref": "reason.gravity_observed_acquisition_unknown",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "gravity_acquisition_a.unknown"
            }
          ]
        }
      ],
      "meaning_template_ref_by_alternative": {
        "gravity_acquisition_a.current": "rule.gravity_acquired_geometry_and_state_a"
      },
      "configuration": {}
    },
