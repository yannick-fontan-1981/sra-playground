      "id":"policy.b_observed_cargo_coupling","kind":"selection_policy",
      "evaluation":"declared_lexicographic_order","supported_operators":["SELECT"],
      "input_contract":"yf_arc3_v5.authority_input.selection.v1","output_contract":"yf_arc3_v5.authority_output.selection.v1",
      "reason_refs":["reason_front_preparation_is_not_rigid_coupling_and_rigid_coupling_is_not_delivery"],
      "declared_alternative_refs":["cargo_pair.rigid_transport","cargo_pair.coupled","cargo_pair.delivered","cargo_pair.front_only","cargo_pair.unresolved"],
      "selection_eligibility_conditions":[{"field":"eligible","operator":"equals","expected":true}],
      "fact_projections":[
        {"id":"projection.b_pair.rigid","all_conditions":[{"field":"alternative_ref","operator":"equals","expected":"cargo_pair.rigid_transport"},{"field":"actual_evidence_bound","operator":"equals","expected":true},{"field":"pair_before","operator":"equals","expected":true},{"field":"pair_after","operator":"equals","expected":true},{"field":"same_nonzero_translation","operator":"equals","expected":true},{"field":"relative_offset_preserved","operator":"equals","expected":true},{"field":"locked_face_preserved","operator":"equals","expected":true},{"field":"identity_and_mask_preserved","operator":"equals","expected":true},{"field":"actor_identity_and_mask_preserved","operator":"equals","expected":true}],"static_facts":{"eligible":true,"observed_pair_kind":"rigid_transport","outline_proves_coupling":false,"universal_coupling_law_proven":false,"actual_delivery_proved":false}},
        {"id":"projection.b_pair.coupled_new","all_conditions":[{"field":"alternative_ref","operator":"equals","expected":"cargo_pair.coupled"},{"field":"actual_evidence_bound","operator":"equals","expected":true},{"field":"pair_before","operator":"equals","expected":false},{"field":"pair_after","operator":"equals","expected":true},{"field":"identity_and_mask_preserved","operator":"equals","expected":true}],"static_facts":{"eligible":true,"observed_pair_kind":"active_coupling","outline_proves_coupling":false,"universal_coupling_law_proven":false,"actual_delivery_proved":false}},
        {"id":"projection.b_pair.coupled_stationary","all_conditions":[{"field":"alternative_ref","operator":"equals","expected":"cargo_pair.coupled"},{"field":"actual_evidence_bound","operator":"equals","expected":true},{"field":"pair_before","operator":"equals","expected":true},{"field":"pair_after","operator":"equals","expected":true},{"field":"same_nonzero_translation","operator":"equals","expected":false},{"field":"identity_and_mask_preserved","operator":"equals","expected":true}],"static_facts":{"eligible":true,"observed_pair_kind":"active_coupling","outline_proves_coupling":false,"universal_coupling_law_proven":false,"actual_delivery_proved":false}},
        {"id":"projection.b_pair.delivery","all_conditions":[{"field":"alternative_ref","operator":"equals","expected":"cargo_pair.delivered"},{"field":"actual_evidence_bound","operator":"equals","expected":true},{"field":"pair_after","operator":"equals","expected":false},{"field":"released_after","operator":"equals","expected":true},{"field":"delivery_acquired_after","operator":"equals","expected":true},{"field":"receiver_membership_after","operator":"equals","expected":true},{"field":"identity_and_mask_preserved","operator":"equals","expected":true}],"static_facts":{"eligible":true,"observed_pair_kind":"received_delivery","universal_coupling_law_proven":false,"delivery_actor_attribution_proven":false}},
        {"id":"projection.b_pair.front_only","all_conditions":[{"field":"alternative_ref","operator":"equals","expected":"cargo_pair.front_only"},{"field":"actual_evidence_bound","operator":"equals","expected":true},{"field":"front_before","operator":"equals","expected":true},{"field":"pair_before","operator":"equals","expected":false},{"field":"pair_after","operator":"equals","expected":false},{"field":"delivery_acquired_after","operator":"equals","expected":false},{"field":"identity_and_mask_preserved","operator":"equals","expected":true}],"static_facts":{"eligible":true,"observed_pair_kind":"frontal_preparation_only","full_interaction_readiness_proven":false,"outline_proves_coupling":false,"actual_delivery_proved":false}},
        {"id":"projection.b_pair.unknown","all_conditions":[{"field":"alternative_ref","operator":"equals","expected":"cargo_pair.unresolved"}],"static_facts":{"eligible":true,"observed_pair_kind":"unresolved","full_interaction_readiness_proven":false,"outline_proves_coupling":false,"actual_delivery_proved":false}}
      ],
      "selection_tie_breakers":[{"field":"alternative_ref","preferred_order":"minimize"}],
      "canonical_equivalence_tie_break_debt_ref":"debt.b_pair_classification_not_action_selection",
