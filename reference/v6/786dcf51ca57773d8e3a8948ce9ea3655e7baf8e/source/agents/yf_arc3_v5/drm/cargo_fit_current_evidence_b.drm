        {"id":"tier.b_pair.coupled","all_conditions":[{"field":"alternative_ref","operator":"equals","expected":"cargo_pair.coupled"}],"reason_ref":"reason_two_current_possession_links_distinguish_coupling_from_front_preparation"},
        {"id":"tier.b_pair.delivered","all_conditions":[{"field":"alternative_ref","operator":"equals","expected":"cargo_pair.delivered"}],"reason_ref":"reason_release_and_complete_receiver_occupancy_distinguish_delivery"},
        {"id":"tier.b_pair.front","all_conditions":[{"field":"alternative_ref","operator":"equals","expected":"cargo_pair.front_only"}],"reason_ref":"reason_front_relation_without_possession_is_only_preparation"},
        {"id":"tier.b_pair.unknown","all_conditions":[{"field":"alternative_ref","operator":"equals","expected":"cargo_pair.unresolved"}],"reason_ref":"reason_unqualified_pair_state_preserves_uncertainty"}
      ]
