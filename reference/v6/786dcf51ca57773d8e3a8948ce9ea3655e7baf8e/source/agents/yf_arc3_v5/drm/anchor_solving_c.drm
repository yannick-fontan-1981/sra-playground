{
  "module_id": "anchor_solving_c",
  "declarations": [
    {
      "id": "policy.anchor_solving_c",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "premises": [
        "current_spatial_beacon_parent_question"
      ],
      "applicability": [
        "K25_requested_operation"
      ],
      "invariants": [
        "grounded_anchor_dependence",
        "separate_anchor_and_beacon_clearance",
        "current_anchor_system_state",
        "current_law_and_quantizer_scope",
        "no_act"
      ],
      "falsifiers": [
        "unbound_spatial_signature",
        "wrong_inverse_or_preparation_receipt",
        "ungrounded_pickup_or_clearance"
      ],
      "selection_required_fact_fields": [
        "alternative_ref"
      ],
      "declared_alternative_refs": [
        "anchor_solving.native",
        "anchor_solving.missing"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "applicable",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.anchor_solving.0",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "anchor_solving.native"
            },
            {
              "field": "current_anchor_question",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "applicable": true,
            "disposition_ref": "anchor_solving.native"
          }
        },
        {
          "id": "projection.anchor_solving.1",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "anchor_solving.missing"
            },
            {
              "field": "current_anchor_question",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "applicable": true,
            "disposition_ref": "anchor_solving.missing"
          }
        }
      ],
      "selection_tiers": [
        {
          "id": "tier.anchor_solving.0",
          "all_conditions": [
            {
              "field": "disposition_ref",
              "operator": "equals",
              "expected": "anchor_solving.native"
            }
          ],
          "reason_ref": "reason.anchor_configuration_supplies_beacon_pose_and_spatial_signature"
        },
        {
          "id": "tier.anchor_solving.1",
          "all_conditions": [
            {
              "field": "disposition_ref",
              "operator": "equals",
              "expected": "anchor_solving.missing"
            }
          ],
          "reason_ref": "reason.anchor_question_requires_current_evidence"
        }
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.anchor_solving_activation_unverified",
      "reason_refs": [
        "reason.anchor_configuration_supplies_beacon_pose_and_spatial_signature",
        "reason.anchor_question_requires_current_evidence"
      ]
    },
    {
      "id":"policy.anchor_binding_publication_c","kind":"selection_policy","evaluation":"declared_eligibility_single",
      "supported_operators":["SELECT"],"input_contract":"yf_arc3_v5.authority_input.selection.v1",
      "output_contract":"yf_arc3_v5.authority_output.selection.v1","declared_alternative_refs":["anchor_binding.publish"],
      "selection_required_fact_fields":["alternative_ref"],
      "selection_eligibility_conditions":[{"field":"eligible","operator":"equals","expected":true}],
      "fact_projections":[{"id":"projection.anchor_binding.current",
        "all_conditions":[{"field":"alternative_ref","operator":"equals","expected":"anchor_binding.publish"},
          {"field":"binding_publication_current","operator":"equals","expected":true}],"static_facts":{"eligible":true}}],
      "meaning_template_ref_by_alternative":{"anchor_binding.publish":"rule.anchor_native_field_binding_c"},
      "premises":["actual_acquired_canonical_source","exact_native_field_and_current_scope"],
      "invariants":["binding_is_not_new_physical_law","no_action_authority"],
      "falsifiers":["source_revision_changes","unsupported_or_wrong_polarity_source"],
      "reason_refs":["reason.current_acquired_anchor_field_binds_requested_calculation"]
    },
    {
      "id":"rule.anchor_native_field_binding_c","kind":"rule","evaluation":"project_requested_conclusions",
      "supported_operators":["DERIVE"],"input_contract":"yf_arc3_v5.authority_input.derivation.v1",
      "output_contract":"yf_arc3_v5.authority_output.derivation.v1","relation_family":"epistemic",
      "term_templates":[{"id_pattern":"{term_ref}","kind":"value","label":"Current Source anchor native field binding",
        "required_fields":["term_ref","native_field_ref","bound_value"],
        "attribute_bindings":{"native_field_ref":"native_field_ref","bound_value":"bound_value",
          "evidence_revision_ref":"evidence_revision_ref","model_revision_ref":"model_revision_ref"},
        "static_attributes":{"projection_contract_ref":"anchor.native_field_binding.c.v1"}}],
      "claim_templates":[{"id_pattern":"{claim_ref}","predicate":"records_current_anchor_native_field_binding",
        "family":"epistemic","epistemic_status":"supported","argument_patterns":["{term_ref}","{parent_goal_ref}"],
        "required_term_patterns":["{term_ref}","{parent_goal_ref}"],
        "required_fields":["claim_ref","term_ref","parent_goal_ref"],
        "scope_bindings":{"parent_goal_ref":"parent_goal_ref","epoch":"epoch",
          "evidence_revision_ref":"evidence_revision_ref","model_revision_ref":"model_revision_ref"},
        "attribute_bindings":{"native_field_ref":"native_field_ref"},
        "static_attributes":{"projection_contract_ref":"anchor.native_field_binding.c.v1"}}],
      "premises":["supported_actual_acquired_field"],"invariants":["exact_scope_and_value","no_dispatch_authority"],
      "falsifiers":["canonical_source_changes"],"reason_refs":["reason.current_acquired_anchor_field_binds_requested_calculation"]
    }
  ]
}
