{
  "module_id": "arc3.cargo_native_component_b",
  "declarations": [
    {
      "id": "policy.b_cargo_native_component",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason_only_explicit_current_canonical_fields_can_construct_a_typed_component_without_invented_defaults_or_laws"
      ],
      "configuration": {
        "required_owner_scope_fields": [
          "parent_goal_ref",
          "scope_ref",
          "epoch",
          "input_revision_ref",
          "level_scope_ref"
        ],
        "schema_by_component_kind": {
          "MODEL": "HandoffModel",
        "TEMPLATE": "HandoffRequest",
        "TEMPLATE_BANK": "CargoNativeTemplateBankB",
          "INVERSE_QUESTION_BANK": "CargoInverseQuestionBankB",
          "SERVICE_ALLOCATION_BANK": "CargoServiceAllocationBankB",
          "SERVICE_ALLOCATION_DOMAIN": "CargoServiceAllocationDomainB",
          "PROFILE": "NativeProfileRequestA",
          "QUERY": "SearchDomainInputC",
          "REQUEST_IDENTITY": "MechanicalRequestIdentity"
        }
      },
      "declared_alternative_refs": [
        "cargo_component.publish",
        "cargo_component.missing"
      ],
      "meaning_template_ref_by_alternative": {
        "cargo_component.publish": "rule.b_current_source_cargo_native_component"
      },
      "selection_eligibility_conditions": [
        {
          "field": "eligible",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.cargo_component.publish",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cargo_component.publish"
            },
            {
              "field": "native_component_complete_current",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "eligible": true,
            "reason_ref": "reason_only_explicit_current_canonical_fields_can_construct_a_typed_component_without_invented_defaults_or_laws",
            "no_dispatch_or_action_authority": true
          }
        },
        {
          "id": "projection.cargo_component.missing",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cargo_component.missing"
            },
            {
              "field": "native_component_complete_current",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "eligible": true,
            "reason_ref": "reason_only_explicit_current_canonical_fields_can_construct_a_typed_component_without_invented_defaults_or_laws",
            "no_dispatch_or_action_authority": true
          }
        }
      ]
    },
    {
      "id": "rule.b_current_source_cargo_native_component",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "premises": [
        "actual_current_acquisition",
        "every_field_explicit_and_canonical",
        "current_principal_and_same_owner"
      ],
      "applicability": [
        "typed_cargo_component_acquisition"
      ],
      "invariants": [
        "optional_and_unknown_fields_need_explicit_source_values",
        "no_law_or_role_confirmation_by_type_validation",
        "original_field_status_and_digest_retained"
      ],
      "falsifiers": [
        "missing_field_or_source_method",
        "changed_principal_or_field_support",
        "foreign_owner_scope"
      ],
      "reason_refs": [
        "reason_only_explicit_current_canonical_fields_can_construct_a_typed_component_without_invented_defaults_or_laws"
      ],
      "term_templates": [
        {
          "id_pattern": "{output_term_ref}",
          "kind": "value",
          "label": "Current Source typed cargo component",
          "required_fields": [
            "output_term_ref",
            "component_payload"
          ],
          "static_attributes": {
            "source_kind_ref": "cargo.current_native_component.b.v1",
            "no_dispatch_or_action_authority": true,
            "no_physical_law_or_role_promotion": true
          },
          "attribute_bindings": {
            "component_kind_ref": "component_kind_ref",
            "schema_ref": "schema_ref",
            "component_digest": "component_digest",
            "component_provenance": "component_provenance",
            "provenance_digest": "provenance_digest",
            "principal_goal_digest": "principal_goal_digest",
            "principal_support_digest": "principal_support_digest",
            "frame_ref": "frame_ref",
            "observation_record_ref": "observation_record_ref",
            "value": "component_payload"
          }
        }
      ],
      "claim_templates": [
        {
          "id_pattern": "{output_support_claim_ref}",
          "predicate": "current_source_cargo_native_component_bound",
          "family": "epistemic",
          "epistemic_status": "proposed",
          "argument_patterns": [
            "{output_term_ref}",
            "{observation_record_ref}"
          ],
          "required_term_patterns": [
            "{output_term_ref}"
          ],
          "required_fields": [
            "output_support_claim_ref",
            "component_payload"
          ],
          "scope_bindings": {
            "parent_goal_ref": "parent_goal_ref",
            "scope_ref": "scope_ref",
            "epoch": "epoch",
            "input_revision_ref": "input_revision_ref",
            "level_scope_ref": "level_scope_ref",
            "frame_ref": "frame_ref"
          },
          "attribute_bindings": {
            "component_kind_ref": "component_kind_ref",
            "schema_ref": "schema_ref",
            "component_digest": "component_digest",
            "component_provenance": "component_provenance",
            "provenance_digest": "provenance_digest",
            "principal_goal_digest": "principal_goal_digest",
            "principal_support_digest": "principal_support_digest",
            "frame_ref": "frame_ref",
            "observation_record_ref": "observation_record_ref"
          },
          "static_attributes": {
            "no_dispatch_or_action_authority": true,
            "no_physical_law_or_role_promotion": true
          }
        }
      ]
    }
  ]
}
