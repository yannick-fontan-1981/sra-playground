{
  "module_id": "contribution_consumption",
  "declarations": [{
    "id": "policy.consume_reasoning_contribution",
    "kind": "selection_policy",
    "evaluation": "declared_eligibility_single",
    "supported_operators": ["SELECT"],
    "input_contract": "yf_arc3_v5.authority_input.selection.v1",
    "output_contract": "yf_arc3_v5.authority_output.selection.v1",
    "declared_alternative_refs": ["consumption.accept_current_return", "consumption.repair_return"],
    "selection_eligibility_conditions": [{"field": "eligible", "operator": "equals", "expected": true}],
    "reason_refs": ["reason.return_identity_precedes_consumer_activation"],
    "fact_projections": [
      {"id": "projection.consumption.defaults", "static_facts": {
        "eligible": false, "consumption_accepted": false,
        "requires_current_revalidation": false,
        "consumed_tracking_present": false, "consumed_binding_exact": false,
        "applied_dependency_refs": [], "enabled_continuation_refs": [],
        "repair_requirement_refs": [], "consumption_grants_action": false
      }},
      {"id": "projection.consumption.accept", "all_conditions": [
        {"field": "alternative_ref", "operator": "equals", "expected": "consumption.accept_current_return"},
        {"field": "return_shape_valid", "operator": "equals", "expected": true},
        {"field": "return_request_matches", "operator": "equals", "expected": true},
        {"field": "return_request_origin_matches", "operator": "equals", "expected": true},
        {"field": "return_recipient_matches", "operator": "equals", "expected": true},
        {"field": "return_producer_matches", "operator": "equals", "expected": true},
        {"field": "return_source_terminal_matches", "operator": "equals", "expected": true},
        {"field": "return_timeline_matches", "operator": "equals", "expected": true},
        {"field": "return_scope_matches", "operator": "equals", "expected": true},
        {"field": "return_chronology_matches", "operator": "equals", "expected": true},
        {"field": "return_products_present", "operator": "equals", "expected": true}
      ], "static_facts": {"eligible": true, "consumption_accepted": true,
        "consumption_disposition_ref": "consumption.return_accepted_for_current_revalidation"},
        "bound_facts": {"requires_current_revalidation": "returned_requires_current_revalidation",
          "consumed_tracking_present": "returned_tracking_present", "consumed_binding_exact": "returned_binding_exact"}},
      {"id": "projection.consumption.repair", "all_conditions": [
        {"field": "alternative_ref", "operator": "equals", "expected": "consumption.repair_return"}
      ], "any_conditions": [
        {"field": "return_shape_valid", "operator": "equals", "expected": false},
        {"field": "return_request_matches", "operator": "equals", "expected": false},
        {"field": "return_request_origin_matches", "operator": "equals", "expected": false},
        {"field": "return_recipient_matches", "operator": "equals", "expected": false},
        {"field": "return_producer_matches", "operator": "equals", "expected": false},
        {"field": "return_source_terminal_matches", "operator": "equals", "expected": false},
        {"field": "return_timeline_matches", "operator": "equals", "expected": false},
        {"field": "return_scope_matches", "operator": "equals", "expected": false},
        {"field": "return_chronology_matches", "operator": "equals", "expected": false},
        {"field": "return_products_present", "operator": "equals", "expected": false}
      ], "static_facts": {"eligible": true,
        "consumption_disposition_ref": "consumption.return_requires_targeted_repair",
        "repair_requirement_refs": ["requirement.reacquire_missing_or_mismatched_return_evidence"]}}
    ]
  }]
}
