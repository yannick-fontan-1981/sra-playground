{
  "module_id": "arc3.recipe_input_catalogue_d",
  "declarations": [
    {
      "id": "policy.recipe_input_catalogue_d", "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order", "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": ["reason.recipe_actual_spatial_catalogue", "reason.recipe_spatial_catalogue_missing"],
      "declared_alternative_refs": ["recipe_input.publish_complete", "recipe_input.unknown"],
      "selection_tie_breakers": [{"field": "alternative_ref", "preferred_order": "minimize"}],
      "canonical_equivalence_tie_break_debt_ref": "debt.recipe_input_equivalent_catalogue",
      "selection_tiers": [
        {"id": "tier.recipe_input.complete", "reason_ref": "reason.recipe_actual_spatial_catalogue",
         "all_conditions": [
           {"field": "alternative_ref", "operator": "equals", "expected": "recipe_input.publish_complete"},
           {"field": "spatial_population_complete", "operator": "equals", "expected": true}
         ]},
        {"id": "tier.recipe_input.unknown", "reason_ref": "reason.recipe_spatial_catalogue_missing",
         "all_conditions": [{"field": "alternative_ref", "operator": "equals", "expected": "recipe_input.unknown"}]}
      ],
      "meaning_template_ref_by_alternative": {"recipe_input.publish_complete": "rule.recipe_acquired_input_catalogue_d"},
      "configuration": {"support_predicate_ref": "qualifies_acquired_recipe_spatial_catalogue",
                        "acquired_source_kind_ref": "recipe.acquired_spatial_catalogue.v1"}
    },
    {
      "id": "rule.recipe_acquired_input_catalogue_d", "kind": "rule",
      "evaluation": "project_requested_conclusions", "supported_operators": ["DERIVE"],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic", "reason_refs": ["reason.recipe_actual_spatial_catalogue"],
      "invariants": ["spatial_query_not_input_role", "activity_values_not_inferred", "actual_acquisition_not_request_pixels"],
      "term_templates": [{
        "id_pattern": "{catalogue_term_ref}", "kind": "value", "label": "Current acquired spatial cell catalogue",
        "required_fields": ["catalogue_term_ref", "value", "binding_digest", "frame_ref", "observation_record_ref"],
        "static_attributes": {"source_kind_ref": "recipe.acquired_spatial_catalogue.v1",
                              "input_role_confirmed": false, "active_slot_values_acquired": false},
        "attribute_bindings": {"value": "value", "binding_digest": "binding_digest", "frame_ref": "frame_ref",
                               "raw_input_ref": "raw_input_ref", "observation_record_ref": "observation_record_ref"}
      }],
      "claim_templates": [{
        "id_pattern": "{catalogue_support_claim_ref}", "predicate": "qualifies_acquired_recipe_spatial_catalogue",
        "family": "epistemic", "epistemic_status": "supported",
        "argument_patterns": ["{catalogue_term_ref}", "{observation_record_ref}"],
        "required_term_patterns": ["{catalogue_term_ref}"],
        "required_fields": ["catalogue_support_claim_ref", "catalogue_term_ref", "binding_digest", "observation_record_ref"],
        "attribute_bindings": {"binding_digest": "binding_digest"},
        "scope_bindings": {
          "frame_ref": "frame_ref", "raw_input_ref": "raw_input_ref", "timeline_ref": "timeline_ref",
          "observation_record_ref": "observation_record_ref", "parent_goal_ref": "parent_goal_ref",
          "parent_contribution_ref": "parent_contribution_ref", "consumer_ref": "consumer_ref", "caller_ref": "caller_ref",
          "scope_ref": "scope_ref", "episode_ref": "episode_ref", "level_scope_ref": "level_scope_ref", "epoch": "epoch",
          "input_revision_ref": "input_revision_ref", "evidence_revision_ref": "evidence_revision_ref",
          "model_revision_ref": "model_revision_ref", "event_owner_ref": "event_owner_ref"
        }
      }]
    }
  ]
}
