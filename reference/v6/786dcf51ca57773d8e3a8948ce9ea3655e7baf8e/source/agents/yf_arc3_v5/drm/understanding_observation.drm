          "all_conditions": [
            {"field": "alternative_ref", "operator": "equals", "expected": "understanding.retain_observed_ambiguity"},
            {"field": "observed_prediction_domains_open", "operator": "equals", "expected": true}
          ],
          "static_facts": {
            "unlisted_response_establishes_falsification": false,
            "understanding_question_ref": "question.which_additional_outcomes_or_conditions_remain_possible",
            "understanding_followup_required": true
          }
        },
        {
          "id": "projection.understanding_observation.0",
