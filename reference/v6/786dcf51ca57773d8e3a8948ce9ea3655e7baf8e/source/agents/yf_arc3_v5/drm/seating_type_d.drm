{
  "module_id": "arc3.seating_type_d",
  "declarations": [
    {
      "id": "policy.seating_type_row_d", "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order", "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": ["reason.current_supplied_generic_or_typed_relation_is_conditional", "reason.seating_type_relation_missing"],
      "configuration": {"relation_predicate_ref": "qualifies_current_conditional_seating_type_relation",
        "compatible_by_rule_ref": {"rule.seating_type_generic_d": true, "rule.seating_type_equal_d": true,
          "rule.seating_type_different_d": false}},
      "declared_alternative_refs": ["seating_type.generic", "seating_type.equal", "seating_type.different", "seating_type.unknown"],
      "selection_tie_breakers": [{"field": "alternative_ref", "preferred_order": "minimize"}],
      "canonical_equivalence_tie_break_debt_ref": "debt.equivalent_current_seating_type_interpretations",
      "selection_tiers": [
        {"id": "tier.seating_type.generic", "reason_ref": "reason.current_supplied_generic_or_typed_relation_is_conditional",
          "all_conditions": [
            {"field": "alternative_ref", "operator": "equals", "expected": "seating_type.generic"},
            {"field": "row_current", "operator": "equals", "expected": true},
            {"field": "generic_field_current", "operator": "equals", "expected": true},
            {"field": "generic_value_is_boolean", "operator": "equals", "expected": true},
            {"field": "generic_field_value", "operator": "equals", "expected": true}
          ]},
        {"id": "tier.seating_type.equal", "reason_ref": "reason.current_supplied_generic_or_typed_relation_is_conditional",
          "all_conditions": [
            {"field": "alternative_ref", "operator": "equals", "expected": "seating_type.equal"},
            {"field": "row_current", "operator": "equals", "expected": true},
            {"field": "generic_field_current", "operator": "equals", "expected": true},
            {"field": "generic_value_is_boolean", "operator": "equals", "expected": true},
            {"field": "generic_field_value", "operator": "equals", "expected": false},
            {"field": "seat_type_field_current", "operator": "equals", "expected": true},
            {"field": "seat_type_is_ref", "operator": "equals", "expected": true},
            {"field": "type_reference_equal", "operator": "equals", "expected": true}
          ]},
        {"id": "tier.seating_type.different", "reason_ref": "reason.current_supplied_generic_or_typed_relation_is_conditional",
          "all_conditions": [
            {"field": "alternative_ref", "operator": "equals", "expected": "seating_type.different"},
            {"field": "row_current", "operator": "equals", "expected": true},
            {"field": "generic_field_current", "operator": "equals", "expected": true},
            {"field": "generic_value_is_boolean", "operator": "equals", "expected": true},
            {"field": "generic_field_value", "operator": "equals", "expected": false},
            {"field": "seat_type_field_current", "operator": "equals", "expected": true},
            {"field": "seat_type_is_ref", "operator": "equals", "expected": true},
            {"field": "type_reference_equal", "operator": "equals", "expected": false}
          ]},
        {"id": "tier.seating_type.unknown", "reason_ref": "reason.seating_type_relation_missing",
          "all_conditions": [{"field": "alternative_ref", "operator": "equals", "expected": "seating_type.unknown"}]}
      ],
      "meaning_template_ref_by_alternative": {"seating_type.generic": "rule.seating_type_generic_d",
        "seating_type.equal": "rule.seating_type_equal_d", "seating_type.different": "rule.seating_type_different_d"},
      "invariants": ["generic_explicit_never_from_absent_color_or_missing_field", "original_role_status_preserved",
        "conditional_supplied_relation_not_acceptance_law", "no_universal_seat_quantifier", "no_action_authority"]
    },
    {
      "id": "policy.seating_type_catalogue_d", "kind": "selection_policy",
      "evaluation": "declared_eligibility_single", "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": ["reason.every_requested_seat_type_pair_has_exact_current_source_relation"],
      "configuration": {"catalogue_predicate_ref": "qualifies_acquired_conditional_seating_type_catalogue",
        "source_kind_ref": "seating.acquired_conditional_types.v1"},
      "declared_alternative_refs": ["seating_types.catalogue", "seating_types.unknown"],
      "selection_eligibility_conditions": [{"field": "eligible", "operator": "equals", "expected": true}],
      "fact_projections": [
        {"id": "projection.seating_types.catalogue", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "seating_types.catalogue"},
          {"field": "type_relation_catalogue_complete", "operator": "equals", "expected": true}
        ], "static_facts": {"eligible": true}},
        {"id": "projection.seating_types.unknown", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "seating_types.unknown"},
          {"field": "type_relation_catalogue_complete", "operator": "equals", "expected": false}
        ], "static_facts": {"eligible": true}}
      ],
      "meaning_template_ref_by_alternative": {"seating_types.catalogue": "rule.seating_type_catalogue_d"}
    },
    {
      "id": "rule.seating_type_generic_d", "kind": "rule", "evaluation": "project_requested_conclusions",
      "supported_operators": ["DERIVE"], "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1", "relation_family": "epistemic",
      "reason_refs": ["reason.current_supplied_generic_or_typed_relation_is_conditional"], "term_templates": [],
      "claim_templates": [{"id_pattern": "{relation_namespace_ref}.{pair_digest}",
        "predicate": "qualifies_current_conditional_seating_type_relation", "family": "epistemic", "epistemic_status": "supported",
        "argument_patterns": ["{seat_ref}", "{member_type_ref}"],
        "required_fields": ["relation_namespace_ref", "seat_ref", "member_type_ref", "input_binding_digest"],
        "attribute_bindings": {"input_binding_digest": "input_binding_digest", "seat_field_provenance": "seat_field_provenance",
          "member_field_provenance": "member_field_provenance"},
        "scope_bindings": {"frame_ref": "frame_ref", "raw_input_ref": "raw_input_ref", "timeline_ref": "timeline_ref",
          "observation_record_ref": "observation_record_ref", "parent_goal_ref": "parent_goal_ref",
          "parent_contribution_ref": "parent_contribution_ref", "consumer_ref": "consumer_ref", "caller_ref": "caller_ref",
          "scope_ref": "scope_ref", "episode_ref": "episode_ref", "level_scope_ref": "level_scope_ref", "epoch": "epoch",
          "input_revision_ref": "input_revision_ref", "evidence_revision_ref": "evidence_revision_ref",
          "model_revision_ref": "model_revision_ref", "event_owner_ref": "event_owner_ref"},
        "static_attributes": {"compatible": true, "conditional_relation": true, "acceptance_confirmed": false, "no_action_authority": true}}]
    },
    {
      "id": "rule.seating_type_equal_d", "kind": "rule", "evaluation": "project_requested_conclusions",
      "supported_operators": ["DERIVE"], "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1", "relation_family": "epistemic",
      "reason_refs": ["reason.current_supplied_generic_or_typed_relation_is_conditional"], "term_templates": [],
      "claim_templates": [{"id_pattern": "{relation_namespace_ref}.{pair_digest}",
        "predicate": "qualifies_current_conditional_seating_type_relation", "family": "epistemic", "epistemic_status": "supported",
        "argument_patterns": ["{seat_ref}", "{member_type_ref}"],
        "required_fields": ["relation_namespace_ref", "seat_ref", "member_type_ref", "input_binding_digest"],
        "attribute_bindings": {"input_binding_digest": "input_binding_digest", "seat_field_provenance": "seat_field_provenance",
          "member_field_provenance": "member_field_provenance"},
        "scope_bindings": {"frame_ref": "frame_ref", "raw_input_ref": "raw_input_ref", "timeline_ref": "timeline_ref",
          "observation_record_ref": "observation_record_ref", "parent_goal_ref": "parent_goal_ref",
          "parent_contribution_ref": "parent_contribution_ref", "consumer_ref": "consumer_ref", "caller_ref": "caller_ref",
          "scope_ref": "scope_ref", "episode_ref": "episode_ref", "level_scope_ref": "level_scope_ref", "epoch": "epoch",
          "input_revision_ref": "input_revision_ref", "evidence_revision_ref": "evidence_revision_ref",
          "model_revision_ref": "model_revision_ref", "event_owner_ref": "event_owner_ref"},
        "static_attributes": {"compatible": true, "conditional_relation": true, "acceptance_confirmed": false, "no_action_authority": true}}]
    },
    {
      "id": "rule.seating_type_different_d", "kind": "rule", "evaluation": "project_requested_conclusions",
      "supported_operators": ["DERIVE"], "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1", "relation_family": "epistemic",
      "reason_refs": ["reason.current_supplied_generic_or_typed_relation_is_conditional"], "term_templates": [],
      "claim_templates": [{"id_pattern": "{relation_namespace_ref}.{pair_digest}",
        "predicate": "qualifies_current_conditional_seating_type_relation", "family": "epistemic", "epistemic_status": "supported",
        "argument_patterns": ["{seat_ref}", "{member_type_ref}"],
        "required_fields": ["relation_namespace_ref", "seat_ref", "member_type_ref", "input_binding_digest"],
        "attribute_bindings": {"input_binding_digest": "input_binding_digest", "seat_field_provenance": "seat_field_provenance",
          "member_field_provenance": "member_field_provenance"},
        "scope_bindings": {"frame_ref": "frame_ref", "raw_input_ref": "raw_input_ref", "timeline_ref": "timeline_ref",
          "observation_record_ref": "observation_record_ref", "parent_goal_ref": "parent_goal_ref",
          "parent_contribution_ref": "parent_contribution_ref", "consumer_ref": "consumer_ref", "caller_ref": "caller_ref",
