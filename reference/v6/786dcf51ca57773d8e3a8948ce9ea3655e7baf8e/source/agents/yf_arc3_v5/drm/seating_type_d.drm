    },
    {
      "id": "rule.seating_type_catalogue_d", "kind": "rule", "evaluation": "project_requested_conclusions",
      "supported_operators": ["DERIVE"], "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1", "relation_family": "epistemic",
      "reason_refs": ["reason.every_requested_seat_type_pair_has_exact_current_source_relation"],
      "term_templates": [{"id_pattern": "{catalogue_term_ref}", "kind": "value", "label": "Current requested conditional seat-type relations",
        "required_fields": ["catalogue_term_ref", "value", "binding_digest", "frame_ref", "observation_record_ref"],
        "attribute_bindings": {"value": "value", "binding_digest": "binding_digest", "frame_ref": "frame_ref",
          "raw_input_ref": "raw_input_ref", "observation_record_ref": "observation_record_ref",
          "field_provenance": "field_provenance", "field_provenance_digest": "field_provenance_digest"},
        "static_attributes": {"source_kind_ref": "seating.acquired_conditional_types.v1", "acceptance_confirmed": false,
          "type_relation_status": "conditional", "no_universal_seat_quantifier": true}}],
      "claim_templates": [{"id_pattern": "{catalogue_support_claim_ref}",
        "predicate": "qualifies_acquired_conditional_seating_type_catalogue", "family": "epistemic", "epistemic_status": "supported",
        "argument_patterns": ["{catalogue_term_ref}", "{observation_record_ref}"], "required_term_patterns": ["{catalogue_term_ref}"],
        "required_fields": ["catalogue_support_claim_ref", "catalogue_term_ref", "binding_digest"],
        "attribute_bindings": {"binding_digest": "binding_digest", "field_provenance_digest": "field_provenance_digest"},
