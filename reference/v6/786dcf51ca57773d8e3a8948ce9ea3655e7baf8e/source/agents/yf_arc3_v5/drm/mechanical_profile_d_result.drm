    {
      "id": "principle.d_profile_current_native_closure",
      "kind": "principle",
      "reason_refs": [
        "reason.d_profile_exact_current_native_contribution"
      ],
      "invariants": [
        "exact_current_caller_parent_and_native_identity",
        "no_goal_family_or_strategy_inference",
        "required_and_supplied_bindings_keep_provenance",
        "blocked_or_bounded_return_never_becomes_exhaustive_empty"
      ]
    },
