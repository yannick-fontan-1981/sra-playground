{
  "module_id": "arc3.cargo_entity_population_b",
  "declarations": [
    {
      "id": "policy.b_cargo_entity_population",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason_source_roles_keep_original_status_in_complete_cargo_population"
      ],
      "declared_alternative_refs": [
        "cargo_entities.observed",
        "cargo_entities.conditional",
        "cargo_entities.missing"
      ],
      "meaning_template_ref_by_alternative": {
        "cargo_entities.observed": "rule.b_observed_cargo_entity_population",
        "cargo_entities.conditional": "rule.b_conditional_cargo_entity_population"
      },
      "selection_eligibility_conditions": [
        {
          "field": "eligible",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.cargo_entities.observed",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cargo_entities.observed"
            },
            {
              "field": "entity_population_complete",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "population_original_statuses_supported",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "eligible": true,
            "reason_ref": "reason_source_roles_keep_original_status_in_complete_cargo_population",
            "epistemic_status": "supported",
            "support_predicate": "observed_native_state_field_supported",
            "source_kind_ref": "acquired_observation",
            "no_dispatch_or_action_authority": true
          }
        },
        {
          "id": "projection.cargo_entities.conditional",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cargo_entities.conditional"
            },
            {
              "field": "entity_population_complete",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "population_original_statuses_supported",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "eligible": true,
            "reason_ref": "reason_source_roles_keep_original_status_in_complete_cargo_population",
            "epistemic_status": "proposed",
            "support_predicate": "conditional_native_cargo_population",
            "source_kind_ref": "conditional_source_body_population",
            "no_dispatch_or_action_authority": true
          }
        },
        {
          "id": "projection.cargo_entities.missing",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cargo_entities.missing"
            },
            {
              "field": "entity_population_complete",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "eligible": true,
            "reason_ref": "reason_source_roles_keep_original_status_in_complete_cargo_population",
            "epistemic_status": null,
            "support_predicate": null,
            "source_kind_ref": null,
            "no_dispatch_or_action_authority": true
          }
        }
      ]
    },
