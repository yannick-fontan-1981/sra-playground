{
  "module_id": "arc3.directed_flow_command_domain_d",
  "declarations": [
    {
      "id": "policy.directed_flow_command_domain_d",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason_actual_dispatched_commands_bound_to_current_control_model"
      ],
      "configuration": {
        "support_predicate_ref": "current_observed_configuration_command_domain",
        "source_kind_ref": "directed_flow.current_command_domain.v1",
        "required_scope_fields": [
          "frame_ref",
          "observation_record_ref",
          "raw_input_ref",
          "timeline_ref",
          "parent_goal_ref",
          "parent_contribution_ref",
          "consumer_ref",
          "caller_ref",
          "scope_ref",
          "episode_ref",
          "level_scope_ref",
          "epoch",
          "input_revision_ref",
          "evidence_revision_ref",
          "model_revision_ref",
          "event_owner_ref"
        ],
        "retained_source_owner_fields": [
          "parent_goal_ref",
          "epoch",
          "episode_ref",
          "level_scope_ref",
          "model_revision_ref"
        ]
      },
      "declared_alternative_refs": [
        "flow_command_domain.publish",
        "flow_command_domain.unknown"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "eligible",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.flow_command_domain.publish",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "flow_command_domain.publish"
            },
            {
              "field": "command_domain_current",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "eligible": true
          }
        },
        {
          "id": "projection.flow_command_domain.unknown",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "flow_command_domain.unknown"
            },
            {
              "field": "command_domain_current",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "eligible": true
          }
        }
      ],
      "meaning_template_ref_by_alternative": {
        "flow_command_domain.publish": "rule.directed_flow_command_domain_d"
      },
      "invariants": [
        "actual_dispatched_command_acquisitions",
        "same_retained_parent_epoch_episode_level_model",
        "exact_current_control_edge_binding",
        "no_invented_action_or_payload",
        "conditional_configuration_templates_only",
        "no_operational_payload_lease",
        "no_portable_control_law_confirmation",
        "no_action_authority",
        "relative_layout_compatibility_not_a_carrying_law",
        "current_complete_closure_and_source_offsets_revalidated"
      ]
    },
    {
      "id": "rule.directed_flow_command_domain_d",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "reason_refs": [
        "reason_actual_dispatched_commands_bound_to_current_control_model"
      ],
      "term_templates": [
        {
          "id_pattern": "{command_domain_term_ref}",
          "kind": "value",
          "label": "Current observed configuration command templates",
          "required_fields": [
            "command_domain_term_ref",
            "value",
            "command_domain_digest",
            "command_domain_provenance_digest"
          ],
          "attribute_bindings": {
            "value": "value",
            "command_domain_digest": "command_domain_digest",
            "command_domain_provenance_digest": "command_domain_provenance_digest",
            "command_domain_provenance": "command_domain_provenance",
            "frame_ref": "frame_ref",
            "observation_record_ref": "observation_record_ref",
            "current_carry_applicability": "current_carry_applicability",
            "current_carry_applicability_digest": "current_carry_applicability_digest"
          },
          "static_attributes": {
            "source_kind_ref": "directed_flow.current_command_domain.v1",
            "no_action_authority": true,
            "command_domain_exhaustiveness_not_proved": true,
            "operational_payload_lease_not_proved": true
          }
        }
      ],
      "claim_templates": [
        {
          "id_pattern": "{command_domain_claim_ref}",
          "predicate": "current_observed_configuration_command_domain",
          "family": "epistemic",
          "epistemic_status": "proposed",
          "argument_patterns": [
            "{command_domain_term_ref}",
            "{observation_record_ref}"
          ],
          "required_term_patterns": [
            "{command_domain_term_ref}"
          ],
          "required_fields": [
            "command_domain_claim_ref",
            "command_domain_digest",
            "command_domain_provenance_digest"
          ],
          "attribute_bindings": {
            "command_domain_digest": "command_domain_digest",
            "command_domain_provenance_digest": "command_domain_provenance_digest",
            "current_carry_applicability_digest": "current_carry_applicability_digest"
          },
          "scope_bindings": {
            "frame_ref": "frame_ref",
            "observation_record_ref": "observation_record_ref",
            "raw_input_ref": "raw_input_ref",
            "timeline_ref": "timeline_ref",
            "parent_goal_ref": "parent_goal_ref",
            "parent_contribution_ref": "parent_contribution_ref",
            "consumer_ref": "consumer_ref",
            "caller_ref": "caller_ref",
            "scope_ref": "scope_ref",
            "episode_ref": "episode_ref",
            "level_scope_ref": "level_scope_ref",
            "epoch": "epoch",
            "input_revision_ref": "input_revision_ref",
            "evidence_revision_ref": "evidence_revision_ref",
            "model_revision_ref": "model_revision_ref",
            "event_owner_ref": "event_owner_ref"
          },
          "static_attributes": {
            "no_action_authority": true,
            "no_portable_control_law_confirmation": true
          }
        }
      ]
    }
  ]
}
