{
  "module_id": "registered_adapter_c",
  "declarations": [
    {
      "id": "policy.registered_external_adapter_c",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "premises": [
        "one_current_source_adapter_binding"
      ],
      "applicability": [
        "bound_external_primitive"
      ],
      "invariants": [
        "one_typed_adapter_not_ordered_passes",
        "no_second_physics_or_debit",
        "all_cross_domain_checks_remain_inside_owning_adapter",
        "ready_phases_pending_current_k03_receipt"
      ],
      "falsifiers": [
        "multiple_ports_or_scope_mismatch",
        "unknown_operation_or_missing_source_binding",
        "current_child_packet_rejected"
      ],
