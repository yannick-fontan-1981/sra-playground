{
  "module_id": "arc3.scoped_profile_frontier_d",
  "declarations": [
    {
      "id": "policy.scoped_profile_explicit_evidence_d",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.current_source_request_justifies_pure_evidence_only"
      ],
      "declared_alternative_refs": [
        "scoped_profile.explicit_evidence",
        "scoped_profile.explicit_blocked"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.scoped_profile.explicit_evidence",
      "selection_tiers": [
        {
          "id": "tier.scoped_profile.explicit_evidence",
          "reason_ref": "reason.current_source_request_justifies_pure_evidence_only",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "scoped_profile.explicit_evidence"
            },
            {
              "field": "pure_request_inputs_current",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.scoped_profile.explicit_blocked",
          "reason_ref": "reason.current_source_request_justifies_pure_evidence_only",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "scoped_profile.explicit_blocked"
            }
          ]
        }
      ],
      "meaning_template_ref_by_alternative": {
        "scoped_profile.explicit_evidence": "rule.scoped_profile_explicit_evidence_d"
      }
    },
    {
      "id": "rule.scoped_profile_explicit_evidence_d",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "reason_refs": [
        "reason.current_source_request_justifies_pure_evidence_only"
      ],
      "invariants": [
        "exact_current_owned_unprocessed_sealed_facet",
        "exact_native_signature_and_retained_model_assignments",
        "no_external_input_adapter",
        "no_action_release",
        "no_role_or_law_confirmation"
      ],
      "claim_templates": [
        {
          "id_pattern": "{justification_claim_ref}",
          "predicate": "justifies_current_pure_native_evidence_operation",
          "family": "epistemic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "{parent_goal_ref}",
            "{facet_term_ref}"
          ],
          "required_term_patterns": [
            "{parent_goal_ref}",
            "{facet_term_ref}"
          ],
          "required_fields": [
            "justification_claim_ref",
            "parent_goal_ref",
            "facet_term_ref",
            "packet_term_ref",
            "operation_ref",
            "native_input_digest",
            "model_assignments"
          ],
          "scope_bindings": {
            "parent_goal_ref": "parent_goal_ref",
            "epoch": "epoch",
            "episode_ref": "episode_ref",
            "level_scope_ref": "level_scope_ref",
            "input_revision_ref": "input_revision_ref",
            "scope_ref": "scope_ref"
          },
          "attribute_bindings": {
            "operation_ref": "operation_ref",
            "mode_ref": "mode_ref",
            "native_input_digest": "native_input_digest",
            "model_assignments": "model_assignments",
            "packet_term_ref": "packet_term_ref"
          },
          "static_attributes": {
            "external_input_authority": false,
            "execution_authority": false,
            "model_truth_confirmed": false
          }
        }
      ]
    },
    {
