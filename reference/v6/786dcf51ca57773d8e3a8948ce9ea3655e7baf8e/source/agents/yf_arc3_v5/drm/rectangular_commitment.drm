{
  "module_id":"drm.rectangular_commitment",
  "declarations":[
    {
      "id":"principle.rectangular_commitment_requires_observed_patch_and_current_epoch",
      "kind":"principle","premises":["bounded_public_before_after","complete_perimeter_inventory"],
      "reason_refs":["reason.observed_transaction_precedes_construction_control_question"],
      "invariants":["raster_change_is_not_mass_or_stability_law","cleared_old_patch_is_not_new_object","current_revalidation_before_probe"]
    },
    {
      "id":"policy.rectangular_commitment_acquisition","kind":"selection_policy",
      "reason_refs":["reason.persistent_patch_and_moved_outline_open_control_question"],
      "evaluation":"declared_lexicographic_order","supported_operators":["SELECT"],
      "input_contract":"yf_arc3_v5.authority_input.selection.v1",
      "output_contract":"yf_arc3_v5.authority_output.selection.v1",
      "declared_alternative_refs":["rectangle.observed_commitment","rectangle.changed_preview_commitment","rectangle.control_change","rectangle.no_effect","rectangle.unqualified"],
      "fact_projections":[
        {"id":"projection.rectangle.changed_preview_commitment","all_conditions":[
          {"field":"alternative_ref","operator":"equals","expected":"rectangle.changed_preview_commitment"},
          {"field":"same_context_epoch","operator":"equals","expected":true},
          {"field":"rectangular_change_pair_count","operator":"equals","expected":0},
          {"field":"changed_preview_pair_count","operator":"equals","expected":1},
          {"field":"rectangular_change_inventory_complete","operator":"equals","expected":true}
        ],"static_facts":{"applicable":true,"acquisition_kind":"observed_rectangular_commitment_changed_preview"},
        "bound_facts":{
          "before_bbox":"changed_preview_before_bbox","after_bbox":"changed_preview_after_bbox",
          "before_perimeter_value":"changed_preview_before_perimeter_value","perimeter_value":"changed_preview_perimeter_value",
          "after_old_patch":"changed_preview_after_old_patch","rectangular_change_token":"changed_preview_rectangular_change_token",
          "signature_correspondence_count":"changed_preview_signature_correspondence_count",
          "signature_correspondence_domain_complete":"changed_preview_signature_correspondence_domain_complete",
          "signature_reference_bbox":"changed_preview_signature_reference_bbox","signature_values":"changed_preview_signature_values",
          "signature_source_bboxes":"changed_preview_signature_source_bboxes","signature_received_values":"changed_preview_signature_received_values",
          "signature_positive_overlap_rows":"changed_preview_signature_positive_overlap_rows","signature_created_bbox":"changed_preview_signature_created_bbox",
          "signature_geometry_token":"changed_preview_signature_geometry_token","signature_received_count":"changed_preview_signature_received_count",
          "signature_positive_overlap_count":"changed_preview_signature_positive_overlap_count"
        }},
        {"id":"projection.rectangle.observed_commitment","all_conditions":[
          {"field":"alternative_ref","operator":"equals","expected":"rectangle.observed_commitment"},
          {"field":"same_context_epoch","operator":"equals","expected":true},
          {"field":"rectangular_change_pair_count","operator":"equals","expected":1},
          {"field":"rectangular_change_inventory_complete","operator":"equals","expected":true}
        ],"static_facts":{"applicable":true,"acquisition_kind":"observed_rectangular_commitment"}},
        {"id":"projection.rectangle.control_change","all_conditions":[
          {"field":"alternative_ref","operator":"equals","expected":"rectangle.control_change"},
          {"field":"same_context_epoch","operator":"equals","expected":true},
          {"field":"rectangular_control_pair_count","operator":"equals","expected":1},
          {"field":"rectangular_change_inventory_complete","operator":"equals","expected":true}
        ],"static_facts":{"applicable":true,"acquisition_kind":"observed_rectangular_control"}},
        {"id":"projection.rectangle.no_effect","all_conditions":[
          {"field":"alternative_ref","operator":"equals","expected":"rectangle.no_effect"},
          {"field":"same_context_epoch","operator":"equals","expected":true},
          {"field":"rectangular_no_effect_observed","operator":"equals","expected":true},
          {"field":"rectangular_before_perimeter_count","operator":"greater_than","expected":0},
          {"field":"rectangular_change_inventory_complete","operator":"equals","expected":true},
          {"field":"action_ref","operator":"not_equals","expected":"ACTION6"},
          {"field":"action_ref","operator":"not_equals","expected":"ACTION7"}
        ],"static_facts":{"applicable":true,"acquisition_kind":"observed_rectangular_no_effect"}},
        {"id":"projection.rectangle.unqualified","all_conditions":[
          {"field":"alternative_ref","operator":"equals","expected":"rectangle.unqualified"}
        ],"static_facts":{"applicable":true,"acquisition_kind":"unqualified_rectangle_change"}}
      ],
      "selection_tiers":[
        {"id":"tier.rectangle.observed","all_conditions":[{"field":"acquisition_kind","operator":"equals","expected":"observed_rectangular_commitment"}],"reason_ref":"reason.persistent_patch_and_moved_outline_open_control_question"},
        {"id":"tier.rectangle.changed_preview","all_conditions":[{"field":"acquisition_kind","operator":"equals","expected":"observed_rectangular_commitment_changed_preview"}],"reason_ref":"reason.unique_shape_successor_and_actual_patch_change_support_revisable_appearance_transition"},
        {"id":"tier.rectangle.control","all_conditions":[{"field":"acquisition_kind","operator":"equals","expected":"observed_rectangular_control"}],"reason_ref":"reason.action_changes_preview_geometry_without_changing_committed_patch"},
        {"id":"tier.rectangle.no_effect","all_conditions":[{"field":"acquisition_kind","operator":"equals","expected":"observed_rectangular_no_effect"}],"reason_ref":"reason.no_effect_is_scoped_to_observed_outline_configuration"},
        {"id":"tier.rectangle.unqualified","all_conditions":[{"field":"acquisition_kind","operator":"equals","expected":"unqualified_rectangle_change"}],"reason_ref":"reason.ambiguous_patch_does_not_create_support_authority"}
      ],
      "selection_tie_breakers":[{"field":"acquisition_kind","preferred_order":"minimize"}],
      "meaning_template_ref_by_alternative":{"rectangle.observed_commitment":"rule.observed_rectangular_commitment","rectangle.changed_preview_commitment":"rule.observed_rectangular_commitment","rectangle.control_change":"rule.observed_rectangular_control","rectangle.no_effect":"rule.observed_rectangular_no_effect"}
    },
    {
      "id":"rule.observed_rectangular_commitment","kind":"rule",
      "reason_refs":["reason.persistent_patch_and_moved_outline_open_control_question"],
      "evaluation":"project_requested_conclusions","supported_operators":["DERIVE"],
      "input_contract":"yf_arc3_v5.authority_input.derivation.v1",
      "output_contract":"yf_arc3_v5.authority_output.derivation.v1","relation_family":"dynamic",
      "premises":["one_observed_perimeter_change_with_persistent_nonmodal_patch"],
      "invariants":["input_is_scoped_observation_not_general_placement_law","no_load_or_stability_certification"],
      "falsifiers":["persistent_patch_disappears","outline_not_revalidated","new_context_epoch"],
      "term_templates":[{
        "id_pattern":"event.rectangular_commitment.{context_epoch}.{rectangular_change_token}",
        "kind":"event","label":"persistent rectangular patch and displaced preview supposition",
"required_fields":["context_epoch","rectangular_change_token","before_bbox","after_bbox","perimeter_value","before_perimeter_value","after_old_patch","action_ref"],
        "static_attributes":{"projection_contract":"yf_arc3_v5.rectangular_commitment.v1","commitment":"revisable","mass_law_established":false,"stability_law_established":false},
        "attribute_bindings":{"context_epoch":"context_epoch","rectangular_change_token":"rectangular_change_token","before_bbox":"before_bbox","after_bbox":"after_bbox","perimeter_value":"perimeter_value","before_perimeter_value":"before_perimeter_value","after_old_patch":"after_old_patch","action_ref":"action_ref"}
      }],
      "claim_templates":[{
        "id_pattern":"claim.rectangular_commitment.{context_epoch}.{rectangular_change_token}",
        "predicate":"observed_rectangle_content_persistence_after_input","family":"dynamic","epistemic_status":"supported",
        "argument_patterns":["event.rectangular_commitment.{context_epoch}.{rectangular_change_token}"],
        "required_fields":["context_epoch","rectangular_change_token"]
      }]
    },
    {
      "id":"rule.observed_rectangular_control","kind":"rule",
      "evaluation":"project_requested_conclusions","supported_operators":["DERIVE"],
      "input_contract":"yf_arc3_v5.authority_input.derivation.v1",
      "output_contract":"yf_arc3_v5.authority_output.derivation.v1","relation_family":"dynamic",
      "reason_refs":["reason.action_changes_preview_geometry_without_changing_committed_patch"],
      "premises":["one_current_outline_correspondence_and_persistent_patch"],
      "invariants":["extent_and_position_are_separate_parameters","observed_delta_is_not_a_universal_stride_or_saturation_law"],
      "falsifiers":["ambiguous_outline_identity","patch_or_current_geometry_not_revalidated"],
      "term_templates":[{
        "id_pattern":"method.rectangular_control.{context_epoch}.{rectangular_control_token}",
        "kind":"procedure","label":"observed scoped preview position or extent change",
"required_fields":["context_epoch","rectangular_control_token","action_ref","control_before_bbox","control_after_bbox","control_delta_row","control_delta_column","control_delta_width","control_perimeter_value","parent_observation_refs"],
        "static_attributes":{"projection_contract":"yf_arc3_v5.rectangular_control.v1","commitment":"revisable","stability_law_established":false},
        "attribute_bindings":{"context_epoch":"context_epoch","rectangular_control_token":"rectangular_control_token","action_ref":"action_ref","control_before_bbox":"control_before_bbox","control_after_bbox":"control_after_bbox","control_delta_row":"control_delta_row","control_delta_column":"control_delta_column","control_delta_width":"control_delta_width","control_perimeter_value":"control_perimeter_value","parent_observation_refs":"parent_observation_refs"}
      }],
      "claim_templates":[{
        "id_pattern":"claim.rectangular_control.{context_epoch}.{rectangular_control_token}",
        "predicate":"observed_scoped_outline_parameter_change","family":"dynamic","epistemic_status":"supported",
        "argument_patterns":["method.rectangular_control.{context_epoch}.{rectangular_control_token}"],
        "required_fields":["context_epoch","rectangular_control_token"]
      }]
    },
    {
      "id":"rule.observed_rectangular_no_effect","kind":"rule",
      "evaluation":"project_requested_conclusions","supported_operators":["DERIVE"],
      "input_contract":"yf_arc3_v5.authority_input.derivation.v1",
      "output_contract":"yf_arc3_v5.authority_output.derivation.v1","relation_family":"dynamic",
      "reason_refs":["reason.no_effect_is_scoped_to_observed_outline_configuration"],
      "premises":["complete_unchanged_public_raster_with_observed_perimeters"],
      "invariants":["no_effect_does_not_mean_globally_inactive_input","outline_roles_are_not_inferred_from_no_effect"],
      "falsifiers":["different_raster_or_outline_configuration"],
      "term_templates":[{
        "id_pattern":"observation.rectangular_no_effect.{context_epoch}.{rectangular_no_effect_token}",
        "kind":"event","label":"input had no visible effect in these perimeter configurations",
        "required_fields":["context_epoch","rectangular_no_effect_token","action_ref","rectangular_before_perimeters"],
        "static_attributes":{"projection_contract":"yf_arc3_v5.rectangular_no_effect.v1","commitment":"revisable"},
        "attribute_bindings":{"context_epoch":"context_epoch","rectangular_no_effect_token":"rectangular_no_effect_token","action_ref":"action_ref","rectangular_before_perimeters":"rectangular_before_perimeters"}
      }],
      "claim_templates":[{
        "id_pattern":"claim.rectangular_no_effect.{context_epoch}.{rectangular_no_effect_token}",
        "predicate":"observed_input_no_effect_in_outline_configuration","family":"dynamic","epistemic_status":"supported",
        "argument_patterns":["observation.rectangular_no_effect.{context_epoch}.{rectangular_no_effect_token}"],
        "required_fields":["context_epoch","rectangular_no_effect_token"]
      }]
    },
    {
      "id":"policy.current_rectangular_commitment_probe_presence","kind":"selection_policy",
      "evaluation":"declared_eligibility_single","supported_operators":["SELECT"],
      "input_contract":"yf_arc3_v5.authority_input.selection.v1",
      "output_contract":"yf_arc3_v5.authority_output.selection.v1",
      "selection_eligibility_conditions":[
        {"field":"active_goal_ref","operator":"equals","expected":"goal.qualify_rectangular_commitment_controls"}
      ],
      "reason_refs":["reason.observed_commitment_opens_current_control_question"]
    }
  ]
}
