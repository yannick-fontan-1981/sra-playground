{
  "module_id": "material_observed_comparison_a",
  "declarations": [
    {
      "id": "policy.material_observed_comparison_a",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.material_exact_observed_comparison",
        "reason.material_loading_missing"
      ],
      "declared_alternative_refs": [
        "material_observed_comparison_a.current",
        "material_observed_comparison_a.unknown"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.material_loading_equivalent",
      "selection_tiers": [
        {
          "id": "tier.material_consumer.current",
          "reason_ref": "reason.material_exact_observed_comparison",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "material_observed_comparison_a.current"
            },
            {
              "field": "comparison_current",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.material_consumer.unknown",
          "reason_ref": "reason.material_loading_missing",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "material_observed_comparison_a.unknown"
            }
          ]
        }
      ],
      "meaning_template_ref_by_alternative": {
        "material_observed_comparison_a.current": "rule.material_observed_comparison_a"
      },
      "configuration": {}
    },
    {
      "id": "rule.material_observed_comparison_a",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "reason_refs": [
        "reason.material_exact_observed_comparison"
      ],
      "invariants": [
        "current_independent_observation",
        "exact_dispatched_prefix_and_sealed_interval",
        "existing_k40_comparison_only",
        "unobserved_microevents_remain_missing",
        "no_method_truth_or_action_release"
      ],
      "term_templates": [
        {
          "id_pattern": "{output_term_ref}",
          "kind": "value",
          "label": "Observed material comparison with explicit transaction coverage",
          "required_fields": [
            "request_ref",
            "parent_goal_ref",
            "consumer_ref",
            "next_item_ref",
            "epoch",
            "evidence_revision_ref",
            "model_revision_ref",
            "frame_ref",
            "why_digest",
            "payload",
            "payload_digest",
            "output_term_ref",
            "output_claim_ref"
          ],
          "attribute_bindings": {
            "request_ref": "request_ref",
            "parent_goal_ref": "parent_goal_ref",
            "consumer_ref": "consumer_ref",
            "next_item_ref": "next_item_ref",
            "epoch": "epoch",
            "evidence_revision_ref": "evidence_revision_ref",
            "model_revision_ref": "model_revision_ref",
            "frame_ref": "frame_ref",
            "why_digest": "why_digest",
            "payload": "payload",
            "payload_digest": "payload_digest"
          },
          "static_attributes": {
            "source_kind_ref": "material.observed_comparison.v1",
            "action_release_authorized": false,
            "physical_execution_observed": false,
            "physical_reconciliation_complete": false,
            "method_truth_promoted": false
          }
        }
      ],
      "claim_templates": [
        {
          "id_pattern": "{output_claim_ref}",
          "predicate": "qualifies_material_observed_comparison",
          "family": "epistemic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "{output_term_ref}",
            "{parent_goal_ref}"
          ],
          "required_term_patterns": [
            "{output_term_ref}"
          ],
          "required_fields": [
            "request_ref",
            "parent_goal_ref",
            "consumer_ref",
            "next_item_ref",
            "epoch",
            "evidence_revision_ref",
            "model_revision_ref",
            "frame_ref",
            "why_digest",
