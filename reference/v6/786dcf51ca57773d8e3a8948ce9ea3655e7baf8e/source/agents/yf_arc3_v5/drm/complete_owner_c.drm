        "complete_owner.delegated_pending",
        "complete_owner.binding_unknown"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "applicable",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.policy.complete_owner_bind_c.0",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "complete_owner.inherited"
            },
            {
              "field": "inherited_licensed",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "applicable": true,
            "disposition_ref": "complete_owner.inherited"
          }
        },
        {
          "id": "projection.policy.complete_owner_bind_c.1",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "complete_owner.delegated_pending"
            },
            {
              "field": "delegated_licensed",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "applicable": true,
            "disposition_ref": "complete_owner.delegated_pending"
          }
        },
        {
          "id": "projection.policy.complete_owner_bind_c.2",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "complete_owner.binding_unknown"
            },
            {
              "field": "binding_qualified",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "applicable": true,
            "disposition_ref": "complete_owner.binding_unknown"
          }
        }
      ],
      "selection_tiers": [
        {
          "id": "tier.policy.complete_owner_bind_c.0",
          "all_conditions": [
            {
              "field": "disposition_ref",
              "operator": "equals",
              "expected": "complete_owner.inherited"
            }
          ],
          "reason_ref": "reason.explicit_non_delegation_preserves_inherited_composition"
        },
        {
          "id": "tier.policy.complete_owner_bind_c.1",
          "all_conditions": [
            {
              "field": "disposition_ref",
              "operator": "equals",
              "expected": "complete_owner.delegated_pending"
            }
          ],
          "reason_ref": "reason.one_registered_complete_primitive_owner_suppresses_duplicate_phases"
        },
        {
          "id": "tier.policy.complete_owner_bind_c.2",
          "all_conditions": [
            {
              "field": "disposition_ref",
              "operator": "equals",
              "expected": "complete_owner.binding_unknown"
            }
          ],
          "reason_ref": "reason.unknown_ownership_blocks_work_without_arbitrary_owner"
        }
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.ownership_return_does_not_release_physical_action",
      "reason_refs": [
        "reason.explicit_non_delegation_preserves_inherited_composition",
        "reason.one_registered_complete_primitive_owner_suppresses_duplicate_phases",
        "reason.unknown_ownership_blocks_work_without_arbitrary_owner"
      ]
    },
