        {"id":"projection.recipe_projectile.unknown","all_conditions":[
          {"field":"alternative_ref","operator":"equals","expected":"recipe_projectile.unknown"},
          {"field":"observed_projectile_link_current","operator":"equals","expected":false}
        ],"static_facts":{"eligible":true}}
      ],
      "meaning_template_ref_by_alternative":{"recipe_projectile.publish":"rule.recipe_projectile_link_root"}
