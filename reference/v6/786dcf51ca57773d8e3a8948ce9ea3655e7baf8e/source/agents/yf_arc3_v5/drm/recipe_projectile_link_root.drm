      "output_contract":"yf_arc3_v5.authority_output.derivation.v1","relation_family":"epistemic",
      "reason_refs":["reason.current_impact_packet_has_separate_observed_world_change"],
      "term_templates":[],
      "claim_templates":[{
        "id_pattern":"{support_claim_ref}","predicate":"associates_observed_projectile_packet_change",
        "family":"epistemic","epistemic_status":"supported",
        "argument_patterns":["{packet_term_ref}","{effect_ref}","{world_variable_ref}"],
        "required_term_patterns":["{packet_term_ref}"],
        "required_fields":["support_claim_ref","observed_link","observed_link_digest"],
        "scope_bindings":{"parent_goal_ref":"parent_goal_ref","scope_ref":"scope_ref",
