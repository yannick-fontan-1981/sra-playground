{
  "module_id": "arc3.directed_flow_acquisition_d",
  "declarations": [
    {
      "id": "policy.directed_flow_acquisition_d", "kind": "selection_policy", "evaluation": "declared_eligibility_single",
      "supported_operators": ["SELECT"], "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1", "reason_refs": ["reason.actual_directed_flow_fields_are_independently_acquired"],
      "configuration": {"support_predicate_ref": "qualifies_acquired_directed_flow_state", "source_kind_ref": "directed_flow.acquired_state.v1"},
      "declared_alternative_refs": ["flow_state.publish", "flow_state.unknown"],
      "selection_eligibility_conditions": [{"field": "eligible", "operator": "equals", "expected": true}],
      "fact_projections": [
        {"id": "projection.flow_state.publish", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "flow_state.publish"},
          {"field": "acquired_flow_state_complete", "operator": "equals", "expected": true}
        ], "static_facts": {"eligible": true}},
        {"id": "projection.flow_state.unknown", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "flow_state.unknown"},
          {"field": "acquired_flow_state_complete", "operator": "equals", "expected": false}
        ], "static_facts": {"eligible": true}}
      ],
      "meaning_template_ref_by_alternative": {"flow_state.publish": "rule.directed_flow_acquired_state_d"},
      "invariants": ["rigid_objects_sources_active_fronts_trace_and_events_distinct", "known_empty_or_none_requires_actual_field",
        "exact_lineage_and_attachment_ownership", "current_full_owner_scope", "no_flow_law_or_role_confirmation", "no_action_authority"]
    },
    {
      "id": "rule.directed_flow_acquired_state_d", "kind": "rule", "evaluation": "project_requested_conclusions",
      "supported_operators": ["DERIVE"], "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1", "relation_family": "epistemic",
      "reason_refs": ["reason.actual_directed_flow_fields_are_independently_acquired"],
      "term_templates": [{"id_pattern": "{state_term_ref}", "kind": "value", "label": "Current acquired directed-flow state",
        "required_fields": ["state_term_ref", "value", "state_digest", "frame_ref", "observation_record_ref"],
        "attribute_bindings": {"value": "value", "state": "value", "epoch": "epoch", "timeline_ref": "timeline_ref",
          "state_digest": "state_digest", "frame_ref": "frame_ref",
          "observation_record_ref": "observation_record_ref", "raw_input_ref": "raw_input_ref",
          "field_provenance": "field_provenance", "field_provenance_digest": "field_provenance_digest"},
        "static_attributes": {"source_kind_ref": "directed_flow.acquired_state.v1",
          "projection_contract_ref": "directed_flow.acquired_state.v1", "flow_laws_confirmed": false, "no_action_authority": true}}],
      "claim_templates": [{"id_pattern": "{state_support_claim_ref}", "predicate": "qualifies_acquired_directed_flow_state",
        "family": "epistemic", "epistemic_status": "supported", "argument_patterns": ["{state_term_ref}", "{observation_record_ref}"],
        "required_term_patterns": ["{state_term_ref}"], "required_fields": ["state_support_claim_ref", "state_digest", "field_provenance_digest"],
        "attribute_bindings": {"state_digest": "state_digest", "field_provenance_digest": "field_provenance_digest"},
        "scope_bindings": {"frame_ref": "frame_ref", "raw_input_ref": "raw_input_ref", "timeline_ref": "timeline_ref",
          "observation_record_ref": "observation_record_ref", "parent_goal_ref": "parent_goal_ref", "parent_contribution_ref": "parent_contribution_ref",
          "consumer_ref": "consumer_ref", "caller_ref": "caller_ref", "scope_ref": "scope_ref", "episode_ref": "episode_ref",
          "level_scope_ref": "level_scope_ref", "epoch": "epoch", "input_revision_ref": "input_revision_ref",
          "evidence_revision_ref": "evidence_revision_ref", "model_revision_ref": "model_revision_ref", "event_owner_ref": "event_owner_ref"},
        "static_attributes": {"no_action_authority": true, "no_physical_goal_confirmation": true}}]
    }
  ]
}
