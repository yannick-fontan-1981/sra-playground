              "field": "alternative_ref",
              "operator": "equals",
              "expected": "reference_admission.proposal"
            }
          ],
          "reason_ref": "reason.reference_goal_admission_requires_current_qualified_means"
        }
      ],
      "meaning_template_ref_by_alternative": {
        "*": "rule.reference_goal_current_means_receipt"
      },
      "invariants": [
        "goal_inventory_is_not_admission_or_exclusivity",
        "indirect_probe_preserves_siblings_and_does_not_establish_control",
        "direct_means_reuse_existing_alignment_or_recipe",
        "root_why_and_act_validation_remain_independent"
      ],
      "reason_refs": [
        "reason.reference_goal_admission_requires_current_qualified_means"
      ],
      "selection_tie_breakers": [
        {
          "field": "reference_guided_goal_admitted",
          "preferred_order": "maximize"
        }
      ]
    },
    {
      "id": "rule.reference_goal_current_means_receipt",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "relation_family": "structural",
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "premises": [
        "source_disposition_from_current_means_and_separate_goal_inventory"
      ],
      "invariants": [
        "absence_of_qualified_means_is_not_goal_refutation",
        "indirect_admission_does_not_establish_control",
        "receipt_does_not_authorize_action"
      ],
      "falsifiers": [
        "current_frame_or_role_binding_has_changed"
      ],
      "reason_refs": [
        "reason.reference_goal_admission_requires_current_qualified_means"
      ],
      "term_templates": [
        {
          "id_pattern": "receipt.reference_goal_admission.{frame_token}.{reference_guided_goal_admission_kind}",
          "kind": "schema",
          "label": "current Source admission separate from goal inventory and exclusivity",
          "required_fields": [
            "frame_ref",
            "reference_guided_goal_admission_kind",
            "reference_guided_goal_exclusive"
          ],
          "static_attributes": {
            "projection_contract": "yf_arc3_v5.current_reference_goal_admission.v1",
            "commitment": "revisable",
            "action_authorization": false,
            "indirect_control_not_established": true
          },
          "attribute_bindings": {
            "observation_ref": "frame_ref",
            "operational_scene_ref": "frame_ref",
            "admission_kind": "reference_guided_goal_admission_kind",
            "admitted": "reference_guided_goal_admitted",
            "exclusive": "reference_guided_goal_exclusive",
            "raw_goal_count": "declared_reference_guided_goal_count"
          }
        }
      ],
      "claim_templates": [
        {
          "id_pattern": "claim.reference_goal_admission.{frame_token}.{reference_guided_goal_admission_kind}",
          "predicate": "current_reference_goal_means_admission_receipt",
          "family": "structural",
          "epistemic_status": "supported",
          "required_fields": [
            "frame_ref",
            "reference_guided_goal_admission_kind"
          ],
          "required_term_patterns": [
            "receipt.reference_goal_admission.{frame_token}.{reference_guided_goal_admission_kind}"
          ],
          "argument_patterns": [
