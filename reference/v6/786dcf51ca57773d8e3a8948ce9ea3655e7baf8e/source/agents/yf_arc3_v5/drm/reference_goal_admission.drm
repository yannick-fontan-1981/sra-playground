          },
          "bound_facts": {
            "reference_goal_admission_frame_ref": "frame_ref"
          }
        },
        {
          "id": "projection.reference_admission.direct",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "reference_admission.direct"
            }
          ],
          "static_facts": {
            "reference_admission_disposition_declared": true,
            "reference_guided_goal_admitted": true,
            "reference_guided_goal_exclusive": false,
            "reference_guided_goal_admission_kind": "direct_continuation",
            "applicable": false,
            "reference_goal_continuation_route_ref": "route.existing_verified_alignment_or_recipe"
          },
          "templated_facts": {
            "reference_goal_admission_claim_ref": "claim.reference_goal_admission.{frame_token}.direct_continuation"
          },
          "bound_facts": {
            "reference_goal_admission_frame_ref": "frame_ref"
          }
        },
        {
