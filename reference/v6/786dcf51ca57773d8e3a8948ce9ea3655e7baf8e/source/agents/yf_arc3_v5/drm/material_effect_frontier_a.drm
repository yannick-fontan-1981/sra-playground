      "relation_family": "epistemic",
      "reason_refs": [
        "reason.material_actual_effect_frontier"
      ],
      "invariants": [
        "actual_owned_sealed_command_and_independent_states",
        "source_declared_facets_only",
        "unknown_laws_preserved",
        "whole_observed_yield_not_microevents",
        "official_score_separate_from_filled_holders",
        "existing_native_publisher_owns_invalidation"
      ],
      "term_templates": [
        {
          "id_pattern": "{packet_term_ref}",
          "kind": "value",
          "label": "Exact material accounting responses for the sealed effect",
          "required_fields": [
