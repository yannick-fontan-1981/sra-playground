        "alternative_ref"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "eligible",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.program.effect.complete",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program.effect.complete"
            },
            {
              "field": "complete",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "eligible": true
          }
        },
        {
          "id": "projection.program.effect.bounded",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program.effect.bounded"
            },
            {
              "field": "bounded",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "eligible": true
          }
        }
      ],
      "premises": [
        "existing_typed_K27_output_preserved"
      ],
