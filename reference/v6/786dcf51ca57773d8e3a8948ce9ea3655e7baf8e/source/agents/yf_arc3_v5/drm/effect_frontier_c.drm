        "no_synthetic_native_family_result",
        "computed_prefix_not_acceptance",
        "no_ACT"
      ],
      "falsifiers": [
        "wrong_typed_output",
        "wrong_declared_operation"
      ],
      "reason_refs": [
        "reason_program_scope_boundary_retains_its_actual_type"
      ]
    },
