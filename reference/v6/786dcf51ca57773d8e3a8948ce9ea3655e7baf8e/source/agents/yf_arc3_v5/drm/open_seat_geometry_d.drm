{
  "module_id": "arc3.open_seat_geometry_d",
  "declarations": [
    {
      "id": "policy.open_seat_geometry_d", "kind": "selection_policy",
      "evaluation": "declared_eligibility_single", "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": ["reason.actual_open_cell_complement_is_geometry_not_acceptance"],
      "configuration": {"catalogue_predicate_ref": "qualifies_acquired_open_seat_geometry_catalogue",
        "geometry_predicate_ref": "qualifies_observed_open_seat_geometry",
        "source_kind_ref": "seating.acquired_open_geometry.v1"},
      "declared_alternative_refs": ["open_geometry.catalogue", "open_geometry.unknown"],
      "selection_eligibility_conditions": [{"field": "eligible", "operator": "equals", "expected": true}],
      "fact_projections": [
        {"id": "projection.open_geometry.catalogue", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "open_geometry.catalogue"},
          {"field": "seat_catalogue_complete", "operator": "equals", "expected": true}
        ], "static_facts": {"eligible": true}},
        {"id": "projection.open_geometry.unknown", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "open_geometry.unknown"},
          {"field": "seat_catalogue_complete", "operator": "equals", "expected": false}
        ], "static_facts": {"eligible": true}}
      ],
      "meaning_template_ref_by_alternative": {"open_geometry.catalogue": "rule.open_seat_geometry_catalogue_d"},
      "invariants": ["geometry_role_revisable", "no_type_or_acceptance_inference", "no_free_terrain_proof",
        "only_requested_population_not_universal_all_seats", "current_acquired_cell_support", "no_action_authority"]
    },
    {
      "id": "policy.open_seat_geometry_row_d", "kind": "selection_policy",
      "evaluation": "declared_eligibility_single", "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": ["reason.actual_open_cell_complement_is_geometry_not_acceptance"],
      "declared_alternative_refs": ["open_geometry.row", "open_geometry.row_unknown"],
      "selection_eligibility_conditions": [{"field": "eligible", "operator": "equals", "expected": true}],
      "fact_projections": [{"id": "projection.open_geometry.row", "all_conditions": [
        {"field": "alternative_ref", "operator": "equals", "expected": "open_geometry.row"},
        {"field": "seat_geometry_complete", "operator": "equals", "expected": true}
      ], "static_facts": {"eligible": true}},
      {"id": "projection.open_geometry.row_unknown", "all_conditions": [
        {"field": "alternative_ref", "operator": "equals", "expected": "open_geometry.row_unknown"},
        {"field": "seat_geometry_complete", "operator": "equals", "expected": false}
      ], "static_facts": {"eligible": true}}],
      "meaning_template_ref_by_alternative": {"open_geometry.row": "rule.open_seat_geometry_row_d"}
    },
    {
      "id": "rule.open_seat_geometry_row_d", "kind": "rule",
      "evaluation": "project_requested_conclusions", "supported_operators": ["DERIVE"],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic", "reason_refs": ["reason.actual_open_cell_complement_is_geometry_not_acceptance"],
      "term_templates": [],
      "claim_templates": [{
        "id_pattern": "{geometry_claim_ref}", "predicate": "qualifies_observed_open_seat_geometry",
        "family": "epistemic", "epistemic_status": "supported",
        "argument_patterns": ["{seat_ref}", "{observation_record_ref}"],
        "required_fields": ["seat_ref", "geometry_claim_ref", "seat_digest", "observation_record_ref"],
        "attribute_bindings": {"seat_digest": "seat_digest", "armature_cell_bounds": "armature_cell_bounds",
          "core_cell_bounds": "core_cell_bounds", "mouth_vector": "mouth_vector", "inward_delta": "inward_delta",
          "calibration_ref": "calibration_ref", "coordinate_axis_order": "coordinate_axis_order"},
        "scope_bindings": {"frame_ref": "frame_ref", "raw_input_ref": "raw_input_ref", "timeline_ref": "timeline_ref",
          "observation_record_ref": "observation_record_ref", "parent_goal_ref": "parent_goal_ref",
          "parent_contribution_ref": "parent_contribution_ref", "consumer_ref": "consumer_ref", "caller_ref": "caller_ref",
          "scope_ref": "scope_ref", "episode_ref": "episode_ref", "level_scope_ref": "level_scope_ref", "epoch": "epoch",
          "input_revision_ref": "input_revision_ref", "evidence_revision_ref": "evidence_revision_ref",
          "model_revision_ref": "model_revision_ref", "event_owner_ref": "event_owner_ref"},
        "static_attributes": {"receptacle_role_status": "proposed", "acceptance_confirmed": false,
          "type_compatibility_confirmed": false, "free_terrain_confirmed": false,
          "open_face_count": 1, "continuous_flanks_and_backstop": true, "no_action_authority": true}
      }]
    },
    {
      "id": "rule.open_seat_geometry_catalogue_d", "kind": "rule",
      "evaluation": "project_requested_conclusions", "supported_operators": ["DERIVE"],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic", "reason_refs": ["reason.actual_open_cell_complement_is_geometry_not_acceptance"],
      "term_templates": [{
        "id_pattern": "{catalogue_term_ref}", "kind": "value", "label": "Requested acquired open-cell geometry catalogue",
        "required_fields": ["catalogue_term_ref", "value", "binding_digest", "frame_ref", "observation_record_ref"],
        "attribute_bindings": {"value": "value", "binding_digest": "binding_digest", "frame_ref": "frame_ref",
          "raw_input_ref": "raw_input_ref", "observation_record_ref": "observation_record_ref",
          "requested_seat_refs": "requested_seat_refs", "geometry_claim_refs": "geometry_claim_refs",
          "calibration_ref": "calibration_ref", "coordinate_axis_order": "coordinate_axis_order"},
        "static_attributes": {"source_kind_ref": "seating.acquired_open_geometry.v1",
          "receptacle_role_confirmed": false, "acceptance_confirmed": false, "type_relation_domain_complete": false,
          "empty_accepted_types_not_generic_acceptance": true, "all_world_seats_complete": false}
      }],
      "claim_templates": [{
        "id_pattern": "{catalogue_support_claim_ref}", "predicate": "qualifies_acquired_open_seat_geometry_catalogue",
        "family": "epistemic", "epistemic_status": "supported",
        "argument_patterns": ["{catalogue_term_ref}", "{observation_record_ref}"],
        "required_term_patterns": ["{catalogue_term_ref}"],
        "required_fields": ["catalogue_support_claim_ref", "catalogue_term_ref", "binding_digest", "observation_record_ref"],
        "attribute_bindings": {"binding_digest": "binding_digest", "geometry_claim_refs": "geometry_claim_refs"},
        "scope_bindings": {"frame_ref": "frame_ref", "raw_input_ref": "raw_input_ref", "timeline_ref": "timeline_ref",
          "observation_record_ref": "observation_record_ref", "parent_goal_ref": "parent_goal_ref",
          "parent_contribution_ref": "parent_contribution_ref", "consumer_ref": "consumer_ref", "caller_ref": "caller_ref",
          "scope_ref": "scope_ref", "episode_ref": "episode_ref", "level_scope_ref": "level_scope_ref", "epoch": "epoch",
          "input_revision_ref": "input_revision_ref", "evidence_revision_ref": "evidence_revision_ref",
          "model_revision_ref": "model_revision_ref", "event_owner_ref": "event_owner_ref"},
        "static_attributes": {"no_action_authority": true, "no_physical_goal_confirmation": true}
      }]
    }
  ]
}
