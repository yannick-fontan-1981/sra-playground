        "program_solving.factorized_return",
        "program_solving.return"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.program_solving.exact_return",
      "selection_tiers": [
        {
          "id": "tier.program_solving.validation_ready",
          "reason_ref": "reason.current_configuration_uses_one_exposed_validation_input",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program_solving.validation_ready"
            },
            {
              "field": "calculation_bound",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "program_validation_configuration_equal",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.program_solving.factorized_stock",
          "reason_ref": "reason.shared_calls_reduce_measured_flat_program_resource_deficit",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program_solving.factorized_return"
            },
            {
              "field": "calculation_bound",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "program_fragment_projection_complete",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "program_call_fragment_count",
              "operator": "greater_than",
              "expected": 0
            },
            {
              "field": "program_termination_or_evidenced_prefix_count",
              "operator": "greater_than",
              "expected": 0
            },
            {
              "field": "program_flat_stock_deficit",
              "operator": "greater_than",
              "expected": 0
            },
            {
              "field": "program_input_domain_complete",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.program_solving.factorized_socket",
          "reason_ref": "reason.shared_calls_reduce_measured_flat_program_resource_deficit",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program_solving.factorized_return"
            },
            {
              "field": "calculation_bound",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "program_fragment_projection_complete",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "program_call_fragment_count",
              "operator": "greater_than",
              "expected": 0
            },
            {
              "field": "program_termination_or_evidenced_prefix_count",
              "operator": "greater_than",
              "expected": 0
            },
            {
              "field": "program_flat_socket_deficit",
              "operator": "greater_than",
              "expected": 0
            },
            {
              "field": "program_input_domain_complete",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.program_solving.return",
          "reason_ref": "reason.current_exact_native_parent_evidence",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program_solving.return"
            },
            {
              "field": "calculation_bound",
              "operator": "equals",
              "expected": true
            }
          ]
        }
      ],
      "meaning_template_ref_by_alternative": {
        "program_solving.return": "rule.program_solving_return_d",
        "program_solving.factorized_return": "rule.program_solving_return_d",
        "program_solving.validation_ready": "rule.program_solving_return_d"
      }
    },
    {
      "id": "rule.program_solving_return_d",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "reason_refs": [
        "reason.current_exact_native_parent_evidence"
      ],
      "invariants": [
        "exact_current_acquired_inputs_and_original_native_identity",
        "bounded_is_not_complete_or_official_acceptance",
        "unchanged_principal_goal_frozen_why_and_siblings",
        "no_action_authority",
        "no_goal_or_method_inferred"
      ],
      "term_templates": [
        {
          "id_pattern": "{return_term_ref}",
          "kind": "value",
          "label": "Exact bounded typed program return to the unchanged parent",
          "static_attributes": {
            "projection_contract_ref": "d.program_solving.parent_return.v1",
            "no_execution_authority": true
          },
          "attribute_bindings": {
            "normalized_return": "normalized_return",
            "exact_demand": "exact_demand",
            "frozen_why": "frozen_why",
            "program_boundary_information_need_refs": "program_boundary_information_need_refs",
            "program_validation_information_need_refs": "program_validation_information_need_refs",
            "program_validation_proposal": "program_validation_proposal",
            "program_validation_release_descriptor": "program_validation_release_descriptor"
          }
        }
      ],
      "claim_templates": [
        {
          "id_pattern": "{return_claim_ref}",
          "predicate": "records_current_exact_program_parent_return",
          "family": "epistemic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "{return_term_ref}",
            "{parent_goal_ref}"
          ],
          "required_term_patterns": [
            "{return_term_ref}",
            "{parent_goal_ref}"
          ],
          "required_fields": [
            "return_term_ref",
            "return_claim_ref",
            "parent_goal_ref",
            "normalized_return",
            "exact_demand",
            "frozen_why"
          ],
          "scope_bindings": {
            "parent_goal_ref": "parent_goal_ref",
            "epoch": "epoch",
            "episode_ref": "episode_ref",
            "level_scope_ref": "level_scope_ref",
            "input_revision_ref": "input_revision_ref",
            "scope_ref": "scope_ref"
          },
          "attribute_bindings": {
            "normalized_return": "normalized_return",
            "exact_demand": "exact_demand",
            "frozen_why": "frozen_why",
            "program_boundary_information_need_refs": "program_boundary_information_need_refs",
            "program_validation_information_need_refs": "program_validation_information_need_refs",
            "program_validation_proposal": "program_validation_proposal",
            "program_validation_release_descriptor": "program_validation_release_descriptor"
          },
          "static_attributes": {
            "no_execution_authority": true
          }
        }
      ]
    },
    {
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
