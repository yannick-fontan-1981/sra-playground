              "expected": "program_validation.missing"
            },
            {
              "field": "proposal_present",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.program_validation.absent",
          "reason_ref": "reason.current_configured_program_uses_one_bound_validation_input",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program_validation.absent"
            }
          ]
        }
      ]
    },
    {
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": [
