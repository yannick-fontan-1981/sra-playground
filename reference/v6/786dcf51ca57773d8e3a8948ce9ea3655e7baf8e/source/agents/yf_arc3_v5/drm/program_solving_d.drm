{
  "module_id": "arc3.program_solving_d",
  "declarations": [
    {
      "id": "policy.program_calculation_operation_d",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.exact_program_operation_preserves_shared_definitions"
      ],
      "declared_alternative_refs": [
        "program_calculation.joint_fit",
        "program_calculation.existing",
        "program_calculation.compile_edit",
        "program_calculation.validation"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.program_calculation.exact_operation",
      "selection_tiers": [
        {
          "id": "tier.program_calculation.joint_fit",
          "reason_ref": "reason.exact_program_operation_preserves_shared_definitions",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program_calculation.joint_fit"
            },
            {
              "field": "operation_ref",
              "operator": "equals",
              "expected": "mechanics.typed_recursive_program.joint_fit"
            }
          ]
        },
        {
          "id": "tier.program_calculation.assignment_domains",
          "reason_ref": "reason.exact_program_operation_preserves_shared_definitions",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program_calculation.existing"
            },
            {
              "field": "operation_ref",
              "operator": "equals",
              "expected": "mechanics.typed_recursive_program.assignment_domains"
            }
          ]
        },
        {
          "id": "tier.program_calculation.edit_successor",
          "reason_ref": "reason.exact_program_operation_preserves_shared_definitions",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program_calculation.existing"
            },
            {
              "field": "operation_ref",
              "operator": "equals",
              "expected": "mechanics.typed_recursive_program.edit_successor"
            }
          ]
        },
        {
          "id": "tier.program_calculation.bounded_interpret",
          "reason_ref": "reason.exact_program_operation_preserves_shared_definitions",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program_calculation.existing"
            },
            {
              "field": "operation_ref",
              "operator": "equals",
              "expected": "mechanics.typed_recursive_program.bounded_interpret"
            }
          ]
        },
        {
          "id": "tier.program_calculation.compile_edit",
          "reason_ref": "reason.exact_program_operation_preserves_shared_definitions",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program_calculation.compile_edit"
            },
            {
              "field": "operation_ref",
              "operator": "equals",
              "expected": "mechanics.typed_recursive_program.compile_edit"
            }
          ]
        },
        {
          "id": "tier.program_calculation.validation",
          "reason_ref": "reason.exact_program_operation_preserves_shared_definitions",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program_calculation.validation"
            },
            {
              "field": "operation_ref",
              "operator": "equals",
              "expected": "mechanics.typed_recursive_program.validation_precondition"
            }
          ]
        }
      ],
      "invariants": [
        "no_assignment_selected_or_action_released",
        "one_shared_definition_map_for_all_call_sites",
        "bounded_search_never_proves_impossibility"
      ]
    },
    {
      "id": "policy.program_solving_question_d",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.current_exact_native_parent_evidence"
      ],
      "declared_alternative_refs": [
