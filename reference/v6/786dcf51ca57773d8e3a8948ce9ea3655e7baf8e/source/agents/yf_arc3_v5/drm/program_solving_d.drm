          "field": "program_validation_bound",
          "operator": "equals",
          "expected": true
        }
      ],
      "selection_required_fact_fields": [
        "alternative_ref",
        "action_ref",
        "active_goal_ref",
        "premise_claim_refs",
        "expected_configuration_or_goal_delta_ref",
        "explicit_falsifier_ref"
      ],
      "invariants": [
