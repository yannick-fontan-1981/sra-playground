        "program_solving.missing"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.program_solving.exact_return",
      "selection_tiers": [
        {
          "id": "tier.program_solving.calculate",
          "reason_ref": "reason.current_exact_native_parent_evidence",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program_solving.calculate"
            },
            {
              "field": "question_bound",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "no_execution_authority",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.program_solving.missing",
          "reason_ref": "reason.current_exact_native_parent_evidence",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "program_solving.missing"
            }
          ]
        }
      ],
      "configuration": {
        "required_emission_future_field": "required_emitted_values",
        "instruction_typing_predicate_ref": "supports_observed_program_instruction_type",
        "instruction_typing_rule_ref": "rule.effect_frontier_c",
        "return_predicate_ref": "records_current_exact_program_parent_return",
        "return_projection_contract_ref": "d.program_solving.parent_return.v1",
        "prefix_acceptance_predicate_ref": "supports_observed_finite_program_prefix_acceptance",
        "prefix_acceptance_rule_ref": "rule.effect_frontier_c",
        "program_kernel_ref": "mechanics.typed_recursive_program",
        "validation_control_predicate_ref": "records_current_program_validation_control",
        "validation_point_scope_ref": "probe_scope.access_witness_only",
        "return_rule_ref": "rule.program_solving_return_d"
      }
    },
    {
      "id": "policy.program_solving_return_d",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.current_exact_native_parent_evidence",
        "reason.shared_calls_reduce_measured_flat_program_resource_deficit",
