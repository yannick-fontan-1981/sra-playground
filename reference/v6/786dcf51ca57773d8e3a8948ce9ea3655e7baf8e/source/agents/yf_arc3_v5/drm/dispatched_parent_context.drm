          "predicate": "source_dispatch_preparation_lineage",
          "family": "control",
          "argument_patterns": [
            "{source_dispatch_context_revision_ref}"
          ],
          "epistemic_status": "supported",
          "required_fields": [
            "source_dispatch_context_revision_ref",
            "source_prepared_context",
            "qualified_actual_intent_ref",
            "dispatch_ref"
          ],
          "static_attributes": {
            "source_dispatch_preparation_lineage_matches": true,
            "action_released": false
          },
          "attribute_bindings": {
            "source_prepared_context": "source_prepared_context",
            "source_preparation_frame_ref": "source_preparation_frame_ref",
