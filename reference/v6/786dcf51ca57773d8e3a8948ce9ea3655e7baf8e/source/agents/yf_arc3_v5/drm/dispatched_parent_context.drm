            "equivalent_source_preparation_count": "equivalent_source_preparation_count",
            "source_preparation_timeline_ref": "source_preparation_timeline_ref",
            "source_release_checkpoint_ref": "source_release_checkpoint_ref",
            "source_checkpoint_refs": "source_checkpoint_refs",
