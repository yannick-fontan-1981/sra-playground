{
  "module_id": "arc3.cargo_terminal_goal_projection_b",
  "declarations": [
    {
      "id": "policy.b_cargo_terminal_goal_projection",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason_declared_delivery_goal_implies_released_allowed_pose_for_every_beneficiary_without_promoting_a_goal_or_law"
      ],
      "configuration": {
        "sidecar_source_kind_ref": "cargo.current_terminal_contract.b.v1",
        "sidecar_support_predicate_ref": "current_source_cargo_terminal_contract_bound",
        "epistemic_pair_projection": {
          "proposed/proposed": "proposed",
          "proposed/supported": "proposed",
          "proposed/established": "proposed",
          "supported/proposed": "proposed",
          "supported/supported": "supported",
          "supported/established": "supported",
          "established/proposed": "proposed",
          "established/supported": "supported",
          "established/established": "established"
        },
        "requirement_ref": "ALL_DECLARED_CARGO_RELEASED_IN_ALLOWED_POSES",
        "beneficiary_quantifier_ref": "ALL_DECLARED_BENEFICIARIES",
        "required_goal_scope_fields": [
          "parent_goal_ref",
          "scope_ref",
          "epoch",
          "input_revision_ref",
          "level_scope_ref"
        ],
        "clause_projection": [
          {
            "predicate_map_ref": "delivered",
            "field_ref": "cargo_by_ref",
            "suffix_path": [
              "delivery_acquired"
            ],
            "comparison": "EQ",
            "expected": true,
            "expected_from_allowed_poses": false
          },
          {
            "predicate_map_ref": "released",
            "field_ref": "cargo_by_ref",
            "suffix_path": [
              "holder_ref"
            ],
            "comparison": "EQ",
            "expected": null,
            "expected_from_allowed_poses": false
          },
          {
            "predicate_map_ref": "allowed_pose",
            "field_ref": "cargo_pose_by_ref",
            "suffix_path": [],
            "comparison": "IN",
            "expected": null,
            "expected_from_allowed_poses": true
          }
        ]
      },
      "declared_alternative_refs": [
        "cargo_goal.supported",
        "cargo_goal.established",
        "cargo_goal.proposed",
        "cargo_goal.missing"
      ],
      "meaning_template_ref_by_alternative": {
        "cargo_goal.supported": "rule.b_supported_cargo_terminal_future",
        "cargo_goal.proposed": "rule.b_proposed_cargo_terminal_future",
        "cargo_goal.established": "rule.b_established_cargo_terminal_future"
      },
      "selection_eligibility_conditions": [
        {
          "field": "eligible",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.cargo_goal.supported",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cargo_goal.supported"
            },
            {
              "field": "terminal_contract_current",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "terminal_goal_supported",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "projection_epistemic_status",
              "operator": "equals",
              "expected": "supported"
            }
          ],
          "static_facts": {
            "eligible": true,
            "reason_ref": "reason_declared_delivery_goal_implies_released_allowed_pose_for_every_beneficiary_without_promoting_a_goal_or_law",
            "no_dispatch_or_action_authority": true
          }
        },
        {
          "id": "projection.cargo_goal.established",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cargo_goal.established"
            },
            {
              "field": "terminal_contract_current",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "terminal_goal_supported",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "projection_epistemic_status",
              "operator": "equals",
              "expected": "established"
            }
          ],
          "static_facts": {
            "eligible": true,
            "reason_ref": "reason_declared_delivery_goal_implies_released_allowed_pose_for_every_beneficiary_without_promoting_a_goal_or_law",
