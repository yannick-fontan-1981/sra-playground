              "operator": "equals",
              "expected": true
            },
            {
              "field": "canonical_record_equal",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "projection_contract_ref",
              "operator": "equals",
              "expected": "parent.measurement_method.b.v1"
            }
          ],
          "static_facts": {
            "eligible": true
          }
        },
        {
          "id": "projection.parent_source.bindings",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "parent_source.bindings"
            },
            {
              "field": "record_bindings_current",
              "operator": "equals",
              "expected": true
            },
            {
