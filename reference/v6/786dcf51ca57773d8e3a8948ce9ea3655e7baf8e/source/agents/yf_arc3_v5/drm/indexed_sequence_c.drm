{
  "module_id": "indexed_sequence_c",
  "declarations": [
    {
      "id": "policy.indexed_sequence_c",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "premises": [
        "native_ordinal_domains_and_observations_are_explicit"
      ],
      "applicability": [
        "sequence_or_finite_inventory_projection"
      ],
      "invariants": [
        "masked_or_unobserved_slot_not_removed",
        "original_index_not_renumbered",
        "content_background_occlusion_outside_distinct",
        "competing_domains_remain_alternatives",
        "no_hidden_content_prediction"
      ],
      "falsifiers": [
        "future_or_stale_observation",
        "duplicate_or_unsupported_domain",
        "actual_projection_bound"
      ],
      "selection_required_fact_fields": [
        "alternative_ref"
      ],
      "declared_alternative_refs": [
        "sequence.archive_noncurrent_projection",
        "sequence.retain_bounded_domain_frontier",
        "sequence.retain_domain_or_content_ambiguity",
        "sequence.use_current_ordinal_projection"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "applicable",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.indexed_sequence_c.0",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "sequence.archive_noncurrent_projection"
            },
            {
              "field": "scope_current",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "applicable": true,
            "disposition_ref": "sequence.archive_noncurrent_projection"
          }
        },
        {
          "id": "projection.indexed_sequence_c.1",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "sequence.retain_bounded_domain_frontier"
            },
            {
              "field": "scope_current",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "budget_reached",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "applicable": true,
            "disposition_ref": "sequence.retain_bounded_domain_frontier"
          }
        },
        {
          "id": "projection.indexed_sequence_c.2",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "sequence.retain_domain_or_content_ambiguity"
            },
            {
              "field": "scope_current",
              "operator": "equals",
              "expected": true
            }
          ],
          "any_conditions": [
            {
              "field": "domains_present",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "domain_refs_unique",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "ordinal_indices_valid",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "domains_currently_evidenced",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "unsupported_content_present",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "contradictory_content_present",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "applicable": true,
            "disposition_ref": "sequence.retain_domain_or_content_ambiguity"
          }
        },
        {
          "id": "projection.indexed_sequence_c.3",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "sequence.use_current_ordinal_projection"
            },
            {
              "field": "scope_current",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "budget_reached",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "domains_present",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "domain_refs_unique",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "ordinal_indices_valid",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "domains_currently_evidenced",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "unsupported_content_present",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "contradictory_content_present",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "applicable": true,
            "disposition_ref": "sequence.use_current_ordinal_projection"
          }
        }
      ],
      "selection_tiers": [
        {
          "id": "tier.indexed_sequence_c.0",
          "all_conditions": [
            {
              "field": "disposition_ref",
              "operator": "equals",
              "expected": "sequence.archive_noncurrent_projection"
            }
          ],
          "reason_ref": "reason.current_ordinal_domain_without_gap_compaction"
        },
        {
          "id": "tier.indexed_sequence_c.1",
          "all_conditions": [
            {
              "field": "disposition_ref",
              "operator": "equals",
              "expected": "sequence.retain_bounded_domain_frontier"
            }
          ],
          "reason_ref": "reason.current_ordinal_domain_without_gap_compaction"
        },
        {
          "id": "tier.indexed_sequence_c.2",
          "all_conditions": [
            {
              "field": "disposition_ref",
              "operator": "equals",
