{
  "module_id": "arc3.directed_flow_command_d",
  "declarations": [
    {
      "id": "policy.directed_flow_command_d",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.actual_flow_command_fields_and_dispatch_are_distinct_evidence"
      ],
      "configuration": {
        "support_predicate_ref": "qualifies_acquired_directed_flow_command",
        "source_kind_ref": "directed_flow.acquired_command.v1",
        "causal_predicate_by_operation": {
          "CONFIGURE": "flow_configuration_translation_observed",
          "RELEASE": "flow_release_emission_observed"
        },
        "carry_predicate_ref": "current_scoped_flow_carry_incidence_supported"
      },
      "declared_alternative_refs": [
        "flow_command.publish",
        "flow_command.unknown"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "eligible",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.flow_command.publish",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "flow_command.publish"
            },
            {
              "field": "flow_command_complete",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "eligible": true
          }
        },
        {
          "id": "projection.flow_command.unknown",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "flow_command.unknown"
            },
            {
              "field": "flow_command_complete",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "eligible": true
          }
        }
      ],
      "meaning_template_ref_by_alternative": {
        "flow_command.publish": "rule.directed_flow_command_d"
      },
      "invariants": [
        "every_command_field_independently_bound",
        "real_dispatch_not_an_intended_action",
        "no_configuration_or_trigger_meaning_inferred",
        "no_action_authority"
      ]
    },
    {
      "id": "rule.directed_flow_command_d",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "reason_refs": [
        "reason.actual_flow_command_fields_and_dispatch_are_distinct_evidence"
      ],
      "term_templates": [
        {
          "id_pattern": "{command_term_ref}",
          "kind": "value",
          "label": "Actual acquired directed-flow command",
          "required_fields": [
            "command_term_ref",
            "value",
            "command_digest",
            "frame_ref",
            "observation_record_ref"
          ],
          "attribute_bindings": {
            "value": "value",
            "command_digest": "command_digest",
            "field_provenance_digest": "field_provenance_digest",
            "field_provenance": "field_provenance",
            "dispatch_record_ref": "dispatch_record_ref",
            "frame_ref": "frame_ref",
            "observation_record_ref": "observation_record_ref"
          },
          "static_attributes": {
            "source_kind_ref": "directed_flow.acquired_command.v1",
            "no_action_authority": true
          }
        }
      ],
      "claim_templates": [
        {
          "id_pattern": "{command_support_claim_ref}",
          "predicate": "qualifies_acquired_directed_flow_command",
          "family": "epistemic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "{command_term_ref}",
            "{observation_record_ref}"
          ],
          "required_term_patterns": [
            "{command_term_ref}"
          ],
          "required_fields": [
            "command_support_claim_ref",
            "command_digest",
            "dispatch_record_ref"
          ],
          "attribute_bindings": {
            "command_digest": "command_digest",
            "dispatch_record_ref": "dispatch_record_ref"
          },
          "scope_bindings": {
            "frame_ref": "frame_ref",
            "raw_input_ref": "raw_input_ref",
            "timeline_ref": "timeline_ref",
            "observation_record_ref": "observation_record_ref",
            "parent_goal_ref": "parent_goal_ref",
            "parent_contribution_ref": "parent_contribution_ref",
            "consumer_ref": "consumer_ref",
            "caller_ref": "caller_ref",
            "scope_ref": "scope_ref",
            "episode_ref": "episode_ref",
            "level_scope_ref": "level_scope_ref",
            "epoch": "epoch",
            "input_revision_ref": "input_revision_ref",
            "evidence_revision_ref": "evidence_revision_ref",
            "model_revision_ref": "model_revision_ref",
            "event_owner_ref": "event_owner_ref"
          },
          "static_attributes": {
            "no_action_authority": true,
            "no_physical_goal_confirmation": true
          }
        },
        {
          "id_pattern": "{causal_support_claim_ref}.configure",
          "predicate": "flow_configuration_translation_observed",
          "family": "dynamic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "{command_term_ref}",
            "{dispatch_record_ref}"
          ],
          "required_term_patterns": [
            "{command_term_ref}"
          ],
          "required_fields": [
            "causal_support_claim_ref",
            "causal_row_digest"
          ],
          "all_conditions": [
            {
              "field": "causal_measurements_present",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "rigid_translation_count",
              "operator": "greater_than",
              "expected": 0
            },
            {
              "field": "front_count_before",
              "operator": "equals",
              "expected": 0
            },
            {
              "field": "front_count_after",
              "operator": "equals",
              "expected": 0
            },
            {
              "field": "new_trace_position_count",
              "operator": "equals",
              "expected": 0
            },
            {
              "field": "removed_trace_position_count",
              "operator": "equals",
              "expected": 0
            }
          ],
          "attribute_bindings": {
            "causal_row_digest": "causal_row_digest"
          },
          "scope_bindings": {
            "parent_goal_ref": "parent_goal_ref",
            "epoch": "epoch",
            "episode_ref": "episode_ref",
            "level_scope_ref": "level_scope_ref"
          },
          "static_attributes": {
            "single_incidence_only": true,
            "no_universal_control_law": true,
            "no_action_authority": true
          }
        },
        {
          "id_pattern": "{causal_support_claim_ref}.release",
          "predicate": "flow_release_emission_observed",
          "family": "dynamic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "{command_term_ref}",
            "{dispatch_record_ref}"
          ],
          "required_term_patterns": [
            "{command_term_ref}"
          ],
          "required_fields": [
            "causal_support_claim_ref",
            "causal_row_digest"
          ],
          "all_conditions": [
            {
              "field": "causal_measurements_present",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "whole_rigid_population_unchanged",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "front_count_before",
              "operator": "equals",
              "expected": 0
            },
            {
              "field": "front_or_trace_count_increased",
              "operator": "equals",
              "expected": true
            }
          ],
          "attribute_bindings": {
            "causal_row_digest": "causal_row_digest"
          },
          "scope_bindings": {
            "parent_goal_ref": "parent_goal_ref",
            "epoch": "epoch",
            "episode_ref": "episode_ref",
            "level_scope_ref": "level_scope_ref"
          },
          "static_attributes": {
            "single_incidence_only": true,
            "no_universal_trigger_law": true,
            "no_action_authority": true
          }
        },
        {
          "id_pattern": "{carry_support_claim_ref}",
          "predicate": "current_scoped_flow_carry_incidence_supported",
          "family": "dynamic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "{carry_object_ref}",
            "{carry_input_ref}",
            "{parent_goal_ref}"
          ],
          "required_term_patterns": [
            "{command_term_ref}"
          ],
          "required_fields": [
            "carry_support_claim_ref",
            "carry_before_state_digest",
            "carry_after_state_digest",
            "carry_command_digest"
          ],
          "all_conditions": [
            {
              "field": "carry_publication_requested",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "carry_incidence_matches",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "operation_kind",
              "operator": "equals",
              "expected": "CONFIGURE"
            },
            {
              "field": "configuration_kind",
              "operator": "equals",
              "expected": "MOVE"
            }
          ],
          "attribute_bindings": {
            "carry_before_state_digest": "carry_before_state_digest",
            "carry_after_state_digest": "carry_after_state_digest",
            "carry_command_digest": "carry_command_digest",
            "carry_delta_rc": "carry_delta_rc",
            "carried_object_refs": "carried_object_refs",
            "carried_source_refs": "carried_source_refs"
          },
          "scope_bindings": {
            "frame_ref": "frame_ref",
            "raw_input_ref": "raw_input_ref",
            "timeline_ref": "timeline_ref",
            "observation_record_ref": "observation_record_ref",
            "parent_goal_ref": "parent_goal_ref",
            "parent_contribution_ref": "parent_contribution_ref",
            "consumer_ref": "consumer_ref",
            "caller_ref": "caller_ref",
            "scope_ref": "scope_ref",
            "episode_ref": "episode_ref",
            "level_scope_ref": "level_scope_ref",
            "epoch": "epoch",
            "input_revision_ref": "input_revision_ref",
            "evidence_revision_ref": "evidence_revision_ref",
            "model_revision_ref": "model_revision_ref",
            "event_owner_ref": "event_owner_ref"
          },
          "static_attributes": {
            "no_action_authority": true,
            "single_observed_translation_only": true,
            "universal_carry_law_not_proved": true
          }
        }
      ]
    }
  ]
}
