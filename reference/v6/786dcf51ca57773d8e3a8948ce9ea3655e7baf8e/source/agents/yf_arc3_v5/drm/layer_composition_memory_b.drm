          "required_fields": [
            "layer_current_binding_token",
            "layer_recalled_model_ref"
          ],
          "required_term_patterns": [
            "binding.layer_composition.{layer_current_binding_token}",
            "{layer_recalled_model_ref}"
          ],
          "static_attributes": {
            "commitment": "revisable",
            "partial_only": true,
            "complete_model_applicability_not_established": true,
            "unassigned_support_inquiry": true,
            "composition_membership_unestablished": true,
            "conditional_query_only": true
          },
          "attribute_bindings": {
            "memory_revalidation_observation_ref": "layer_binding_frame_ref",
            "model_premise_claim_refs": "layer_recalled_premise_claim_refs"
          }
        }
      ]
    }
  ]
}
