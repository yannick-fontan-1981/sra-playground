{
  "module_id": "arc3.layer_composition_memory_b",
  "declarations": [
    {
      "id": "principle.layer_composition_memory_requires_current_binding",
      "kind": "principle",
      "family_ref": "family.interaction_configuration",
      "abstraction_level": "causal_variant",
      "reason_refs": [
        "reason.observed_composition_survives_absent_pure_reference_values"
      ],
      "premises": [
        "native_historical_composition_evidence"
      ],
      "invariants": [
        "palette_is_not_an_intrinsic_role",
        "current_masks_and_selection_are_revalidated",
        "historical_positions_are_not_a_method"
      ]
    },
    {
      "id": "policy.acquire_layer_composition_memory",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "declared_alternative_refs": [
        "layer_memory.acquire"
      ],
      "reason_refs": [
        "reason.official_boundary_history_preserves_supported_composition"
      ],
      "configuration": {
        "measurement_contract": {
          "evidence_contract": "yf_arc3_v5.terminal_outcome_evidence.v1",
          "boundary_predicate": "level_completed",
          "allowed_statuses": [
            "supported",
            "established"
          ],
          "maximum_capsules": 8,
          "maximum_history_inputs": 64,
          "game_scope_field": "game_id",
          "action_field": "last_action",
          "model_term_pattern": "memory.layer_composition.{model_token}",
          "model_claim_pattern": "claim.memory.layer_composition.{model_token}",
          "current_claim_pattern": "claim.memory.layer_composition.current.{binding_token}"
        }
      },
      "selection_eligibility_conditions": [
        {
          "field": "eligible",
          "operator": "equals",
          "expected": true
        }
      ],
      "meaning_template_ref_by_alternative": {
        "layer_memory.acquire": "rule.acquire_layer_composition_memory"
      },
      "fact_projections": [
        {
          "id": "projection.layer_memory.acquire",
          "all_conditions": [
            {
              "field": "has_measurements",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "description_count",
              "operator": "equals",
              "expected": 1
            },
            {
              "field": "intersection_observed_count",
              "operator": "greater_than",
              "expected": 0
            },
            {
              "field": "intersection_mismatch_count",
              "operator": "equals",
              "expected": 0
            }
          ],
          "static_facts": {
            "eligible": true
          }
        }
      ]
    },
    {
      "id": "rule.acquire_layer_composition_memory",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "reason_refs": [
        "reason.historical_effects_support_a_revisable_contribution_table"
      ],
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "premises": [
        "source_qualified_complete_native_boundary_history"
      ],
      "invariants": [
        "acquisition_does_not_bind_current_scene",
        "operators_retain_observed_scope"
      ],
      "term_templates": [
        {
          "id_pattern": "memory.layer_composition.{model_token}",
          "kind": "schema",
          "label": "supported portable two-support composition method",
          "required_fields": [
            "model_token",
            "palette_description",
            "historical_action_motions"
          ],
          "static_attributes": {
            "projection_contract": "yf_arc3_v5.layer_composition_model.v1",
            "canonical_fact_projection_enabled": true,
            "commitment": "revisable",
            "memory_scope": "same_game",
            "drop_scene_local_bindings": true,
            "uniform_pose_query": {
              "contract": "yf_arc3_v5.uniform_support_pose_query.v1",
              "body_requirement": "unique_connected_support_exceeding_patch_area",
              "rotation_anchor_assumption": "visible_body_minimum_corner",
              "anchor_epistemic_status": "supposed",
              "outline_occlusion_assumption": "opposite_support_pixels_across_current_frame_outline",
              "presentation_overlay_requirement": "observed_current_selection_marker_only",
              "translation_requirement": "observed_axis_quanta_with_revisable_inverse",
              "maximum_translation_extent": 64,
              "require_unclipped_body": true,
              "require_unique_compatible_pose": true,
              "result_mode": "all_minimum_primitive_count_compatible_poses"
            },
            "current_claim_pattern": "claim.memory.layer_composition.current.{binding_token}",
            "canonical_role_link_constraints": {
              "allowed_statuses": [
                "supported",
                "established"
              ],
              "disposition": "active",
              "polarity": "positive",
              "no_contradictions": true,
              "no_defeaters": true
            }
          },
          "attribute_bindings": {
            "game_id": "game_id",
            "palette_description": "palette_description",
            "historical_action_motions": "historical_action_motions",
            "model_claim_ref": "model_claim_ref",
            "role_premise_claim_refs": "model_premise_claim_refs"
          }
        }
      ],
      "claim_templates": [
        {
          "id_pattern": "claim.memory.layer_composition.{model_token}",
          "predicate": "supports_revisable_layer_composition_model",
          "family": "epistemic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "memory.layer_composition.{model_token}"
          ],
          "required_fields": [
            "model_token",
            "palette_description",
            "historical_action_motions"
          ],
          "required_term_patterns": [
            "memory.layer_composition.{model_token}"
          ],
          "static_attributes": {
            "commitment": "revisable",
            "falsifier": "current_intersection_or_operator_contradicts_recalled_composition"
          }
        }
      ]
    },
