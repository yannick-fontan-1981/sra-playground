{
  "module_id": "arc3.agenda_receipt_root",
  "declarations": [
    {
      "id": "policy.agenda_receipt_publication_root",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": ["reason.exact_computational_return_preserves_parent_and_siblings"],
      "declared_alternative_refs": ["agenda_receipt.publish", "agenda_receipt.already_current", "agenda_receipt.blocked"],
      "selection_eligibility_conditions": [{"field": "eligible", "operator": "equals", "expected": true}],
      "fact_projections": [
        {"id": "projection.agenda_receipt.publish", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "agenda_receipt.publish"},
          {"field": "canonical_bindings_current", "operator": "equals", "expected": true},
          {"field": "canonical_payload_equal", "operator": "equals", "expected": false}
        ], "static_facts": {"eligible": true}},
        {"id": "projection.agenda_receipt.already_current", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "agenda_receipt.already_current"},
          {"field": "canonical_bindings_current", "operator": "equals", "expected": true},
          {"field": "canonical_payload_equal", "operator": "equals", "expected": true}
        ], "static_facts": {"eligible": true}},
        {"id": "projection.agenda_receipt.blocked", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "agenda_receipt.blocked"},
          {"field": "canonical_bindings_current", "operator": "equals", "expected": false}
        ], "static_facts": {"eligible": true}}
      ],
      "meaning_template_ref_by_alternative": {"agenda_receipt.publish": "rule.agenda_receipt_publication_root"},
      "invariants": ["original_extension_unchanged", "siblings_and_dependencies_preserved",
        "computational_return_is_not_physical_goal_confirmation", "no_action_authority"]
    },
    {
      "id": "rule.agenda_receipt_publication_root",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": ["DERIVE"],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "reason_refs": ["reason.exact_computational_return_preserves_parent_and_siblings"],
      "term_templates": [{
        "id_pattern": "{agenda_term_ref}", "kind": "value",
        "label": "canonical family dependency agenda",
        "required_fields": ["agenda_term_ref", "proposed_agenda_payload", "frozen_extension_payload", "receipt_chain_digest"],
        "static_attributes": {"projection_contract_ref": "family_agenda.canonical_snapshot.v1"},
        "attribute_bindings": {"family_agenda": "proposed_agenda_payload", "frozen_extension": "frozen_extension_payload",
          "receipt_chain": "receipt_chain", "receipt_chain_digest": "receipt_chain_digest"}
      }],
      "claim_templates": [{
        "id_pattern": "{receipt_claim_ref}",
        "predicate": "records_exact_current_computational_return",
        "family": "epistemic", "epistemic_status": "supported",
        "argument_patterns": ["{agenda_term_ref}", "{receipt_ref}", "{consumer_ref}"],
        "required_term_patterns": ["{agenda_term_ref}", "{consumer_ref}"],
        "required_fields": ["receipt_claim_ref", "receipt_ref", "receipt_link"],
        "scope_bindings": {"parent_goal_ref": "parent_goal_ref", "epoch": "epoch",
          "episode_ref": "episode_ref", "level_scope_ref": "level_scope_ref",
          "input_revision_ref": "input_revision_ref", "scope_ref": "scope_ref"},
        "attribute_bindings": {"receipt_link": "receipt_link"},
        "static_attributes": {"no_dispatch_or_action_authority": true,
          "falsifier": "changed_exact_demand_return_scope_or_source_evidence"}
      }]
    }
  ]
}
