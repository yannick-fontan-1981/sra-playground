{
  "module_id": "material_loading_simulation_a",
  "declarations": [
    {
      "id": "policy.material_loading_simulation_a",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.material_exact_predicted_primitive_prefix",
        "reason.material_loading_missing"
      ],
      "declared_alternative_refs": [
        "material_loading_simulation_a.current",
        "material_loading_simulation_a.unknown"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.material_loading_equivalent",
      "selection_tiers": [
        {
          "id": "tier.material_consumer.current",
          "reason_ref": "reason.material_exact_predicted_primitive_prefix",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "material_loading_simulation_a.current"
            },
            {
              "field": "simulation_current",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.material_consumer.unknown",
          "reason_ref": "reason.material_loading_missing",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "material_loading_simulation_a.unknown"
            }
          ]
        }
      ],
      "meaning_template_ref_by_alternative": {
        "material_loading_simulation_a.current": "rule.material_loading_simulation_a"
      },
      "configuration": {}
    },
