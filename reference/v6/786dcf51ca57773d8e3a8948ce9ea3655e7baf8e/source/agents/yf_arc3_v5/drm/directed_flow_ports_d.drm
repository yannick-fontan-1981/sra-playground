{
  "module_id": "arc3.directed_flow_ports_d",
  "declarations": [
    {
      "id": "policy.directed_flow_ports_d",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason_current_collision_relief_and_incoming_direction_license_outlet_candidates"
      ],
      "configuration": {
        "port_predicate_ref": "proposes_current_directed_flow_outlet_geometry",
        "port_status_ref": "proposed",
        "source_kind_ref": "directed_flow.current_port_candidates.v1",
        "conditional_inverse_candidates_allowed": true,
        "required_scope_fields": [
          "frame_ref",
          "observation_record_ref",
          "raw_input_ref",
          "timeline_ref",
          "parent_goal_ref",
          "parent_contribution_ref",
          "consumer_ref",
          "caller_ref",
          "scope_ref",
          "episode_ref",
          "level_scope_ref",
          "epoch",
          "input_revision_ref",
          "evidence_revision_ref",
          "model_revision_ref",
          "event_owner_ref"
        ],
        "upstream_dependency_construction_allowed": true,
        "prospective_configuration_domain_allowed": true,
        "configuration_witness_order_ref": "source_ordered_commands_breadth_first_current_geometry",
        "configuration_witness_limit": 3
      },
      "declared_alternative_refs": [
        "flow_ports.publish",
        "flow_ports.unknown"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt_equivalent_current_flow_port_geometry",
      "selection_tiers": [
        {
          "id": "tier.ports.current_geometry",
          "reason_ref": "reason_current_collision_relief_and_incoming_direction_license_outlet_candidates",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "flow_ports.publish"
            },
            {
              "field": "port_premises_current",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.ports.unknown",
          "reason_ref": "reason_current_collision_relief_and_incoming_direction_license_outlet_candidates",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "flow_ports.unknown"
            }
          ]
        }
      ],
      "meaning_template_ref_by_alternative": {
        "flow_ports.publish": "rule.directed_flow_ports_d"
      },
      "invariants": [
        "actual_current_relief_receipt",
        "current_incoming_front",
        "no_collider_centre_alignment",
        "candidate_not_split_law",
        "no_receiver_connection_or_route_proof",
        "no_action_authority",
        "upstream_graph_not_executable_route",
        "ambiguous_source_assignment_remains_open",
        "joint_surplus_and_trace_proof_required",
        "prospective_states_not_future_observation_frames",
        "configuration_costs_preserved",
        "projected_commands_have_no_operational_payload_lease"
      ]
    },
    {
      "id": "rule.directed_flow_ports_d",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "reason_refs": [
        "reason_current_collision_relief_and_incoming_direction_license_outlet_candidates"
      ],
      "term_templates": [
        {
          "id_pattern": "{output_term_ref}",
          "kind": "value",
          "label": "Current directed-flow outlet candidates",
          "required_fields": [
            "output_term_ref",
            "value",
            "port_geometry_digest"
          ],
          "attribute_bindings": {
            "value": "value",
            "port_geometry_digest": "port_geometry_digest",
            "physical_state_digest": "physical_state_digest",
            "relief_receipt_digest": "relief_receipt_digest",
            "receiving_geometry": "receiving_geometry",
            "receiving_geometry_digest": "receiving_geometry_digest",
            "routing_candidates": "routing_candidates",
            "routing_candidate_digest": "routing_candidate_digest",
            "frame_ref": "frame_ref",
            "observation_record_ref": "observation_record_ref",
            "upstream_dependencies": "upstream_dependencies",
            "upstream_dependency_digest": "upstream_dependency_digest"
          },
          "static_attributes": {
            "no_action_authority": true,
            "candidate_only": true,
            "no_native_port_connection_authority": true,
            "source_kind_ref": "directed_flow.current_port_candidates.v1",
            "conditional_inverse_domain_only": true
          }
        }
      ],
      "claim_templates": [
        {
          "id_pattern": "{output_claim_ref}",
          "predicate": "proposes_current_directed_flow_outlet_geometry",
          "family": "epistemic",
          "epistemic_status": "proposed",
          "argument_patterns": [
            "{output_term_ref}",
            "{observation_record_ref}"
          ],
          "required_term_patterns": [
            "{output_term_ref}"
          ],
          "required_fields": [
            "output_claim_ref",
            "port_geometry_digest",
            "physical_state_digest",
            "relief_receipt_digest"
          ],
          "attribute_bindings": {
            "port_geometry_digest": "port_geometry_digest",
            "physical_state_digest": "physical_state_digest",
            "relief_receipt_digest": "relief_receipt_digest",
            "receiving_geometry_digest": "receiving_geometry_digest",
            "routing_candidate_digest": "routing_candidate_digest",
            "front_ref": "front_ref",
            "upstream_dependency_digest": "upstream_dependency_digest"
          },
          "scope_bindings": {
            "frame_ref": "frame_ref",
            "observation_record_ref": "observation_record_ref",
            "raw_input_ref": "raw_input_ref",
            "timeline_ref": "timeline_ref",
            "parent_goal_ref": "parent_goal_ref",
            "parent_contribution_ref": "parent_contribution_ref",
            "consumer_ref": "consumer_ref",
            "caller_ref": "caller_ref",
            "scope_ref": "scope_ref",
            "episode_ref": "episode_ref",
            "level_scope_ref": "level_scope_ref",
            "epoch": "epoch",
            "input_revision_ref": "input_revision_ref",
            "evidence_revision_ref": "evidence_revision_ref",
            "model_revision_ref": "model_revision_ref",
            "event_owner_ref": "event_owner_ref"
          },
          "static_attributes": {
            "no_action_authority": true,
            "split_and_capture_not_proved": true,
            "conditional_inverse_domain_only": true
          }
        }
      ]
    }
  ]
}
