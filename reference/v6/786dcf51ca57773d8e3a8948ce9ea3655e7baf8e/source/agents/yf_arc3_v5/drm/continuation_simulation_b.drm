        {"id": "projection.continuation_simulation.open", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "continuation_simulation.open"},
          {"field": "simulation_complete", "operator": "equals", "expected": false}], "static_facts": {"eligible": true}}
      ]
    },
    {
