          {"field": "information_prefix", "operator": "equals", "expected": false}],
          "static_facts": {"eligible": true, "prediction_status_ref": "predicted_until_sealed"}},
        {"id": "projection.continuation_simulation.information_prefix", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "continuation_simulation.information_prefix"},
          {"field": "simulation_complete", "operator": "equals", "expected": true},
          {"field": "information_prefix", "operator": "equals", "expected": true}],
          "static_facts": {"eligible": true, "prediction_status_ref": "predicted_until_sealed",
