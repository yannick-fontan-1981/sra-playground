      "reason_refs": ["reason_current_canonical_closure_and_unknown_cut_precede_simulation"],
      "invariants": ["no_new_physics", "no_implicit_completion_boundary", "unknown_suffix_is_withheld",
        "untested_surface_or_pivot_alone_does_not_cut_a_complete_conditional_series"],
      "declared_alternative_refs": ["continuation_simulation_input.current", "continuation_simulation_input.open"],
      "selection_eligibility_conditions": [{"field": "eligible", "operator": "equals", "expected": true}],
      "fact_projections": [
        {"id": "projection.continuation_simulation_input.current", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "continuation_simulation_input.current"},
          {"field": "input_current", "operator": "equals", "expected": true}], "static_facts": {"eligible": true}},
        {"id": "projection.continuation_simulation_input.open", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "continuation_simulation_input.open"},
          {"field": "input_current", "operator": "equals", "expected": false}], "static_facts": {"eligible": true}}
      ]
    },
    {
      "id": "policy.b_continuation_simulation_return",
