        "returned_response_capture_is_not_world_settlement",
        "missing_body_or_viewport_proof_remains_unknown",
        "no_capture_fact_authorizes_ACT_or_WHO"
      ],
      "falsifiers": [
        "observed_command_breaks_the_declared_root_and_axis_geometry"
      ],
      "configuration": {
