{
  "module_id": "mechanical_calculation_result",
  "declarations": [
    {
      "id": "principle.mechanical_calculation_result_is_caller_scoped",
      "kind": "principle",
      "invariants": [
        "retain_request_caller_epoch_revision_and_model_assumptions",
        "mismatched_signature_preserves_sibling_requests",
        "an_incomplete_domain_never_proves_empty_world_or_robustness",
        "a_mechanical_result_never_selects_a_goal_or_releases_an_action"
      ],
      "falsifiers": [
        "unknown_prerequisite_is_hidden_by_an_empty_domain"
      ],
      "reason_refs": [
        "reason.mechanical_calculation_returns_exact_caller_scoped_measurements"
      ]
    },
    {
      "id": "policy.mechanical_calculation_result",
      "reason_refs": [
        "reason.mechanical_calculation_returns_exact_caller_scoped_measurements"
      ],
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "canonical_equivalence_tie_break_debt_ref": "debt.canonical_lexicographic_equivalence_tie_break",
      "supported_operators": [
        "SELECT"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "declared_alternative_refs": [
        "mechanical_calculation.signature_mismatch",
        "mechanical_calculation.missing_implementation",
        "mechanical_calculation.missing_prerequisite",
        "mechanical_calculation.bounded_partial",
        "mechanical_calculation.complete_domain",
        "mechanical_calculation.incomplete_domain"
      ],
      "premises": [
        "principle.mechanical_calculation_result_is_caller_scoped"
      ],
      "selection_tiers": [
        {
          "id": "tier.mechanical_calculation.signature_mismatch",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "mechanical_calculation.signature_mismatch"
            },
            {
              "field": "signature_supported",
              "operator": "equals",
              "expected": false
            }
          ],
          "reason_ref": "reason.mechanical_calculation_returns_exact_caller_scoped_measurements"
        },
        {
          "id": "tier.mechanical_calculation.missing_implementation",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "mechanical_calculation.missing_implementation"
            },
            {
              "field": "signature_supported",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "implementation_complete",
              "operator": "equals",
              "expected": false
            }
          ],
          "reason_ref": "reason.mechanical_calculation_returns_exact_caller_scoped_measurements"
        },
        {
          "id": "tier.mechanical_calculation.missing_prerequisite",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "mechanical_calculation.missing_prerequisite"
            },
            {
              "field": "signature_supported",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "prerequisites_empty",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "implementation_complete",
              "operator": "equals",
              "expected": true
            }
          ],
          "reason_ref": "reason.mechanical_calculation_returns_exact_caller_scoped_measurements"
        },
        {
          "id": "tier.mechanical_calculation.bounded_partial",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "mechanical_calculation.bounded_partial"
            },
            {
              "field": "signature_supported",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "prerequisites_empty",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "domain_complete",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "computation_bound_reached",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "implementation_complete",
              "operator": "equals",
              "expected": true
            }
          ],
          "reason_ref": "reason.mechanical_calculation_returns_exact_caller_scoped_measurements"
        },
        {
          "id": "tier.mechanical_calculation.complete_domain",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "mechanical_calculation.complete_domain"
            },
            {
              "field": "signature_supported",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "prerequisites_empty",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "domain_complete",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "implementation_complete",
              "operator": "equals",
              "expected": true
            }
          ],
          "reason_ref": "reason.mechanical_calculation_returns_exact_caller_scoped_measurements"
        },
        {
          "id": "tier.mechanical_calculation.incomplete_domain",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "mechanical_calculation.incomplete_domain"
            },
            {
              "field": "signature_supported",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "prerequisites_empty",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "domain_complete",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "computation_bound_reached",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "implementation_complete",
              "operator": "equals",
              "expected": true
            }
          ],
          "reason_ref": "reason.mechanical_calculation_returns_exact_caller_scoped_measurements"
        }
      ]
    },
    {
      "id": "principle.mechanical_signature_precedes_calculation",
      "kind": "principle",
      "reason_refs": [
        "reason.mechanical_signature_binds_exact_supplied_pair"
      ],
      "invariants": [
        "bind_exact_supplied_operation_and_mode_before_calculation",
        "never_infer_replace_or_coerce_a_requested_operation"
      ],
      "falsifiers": [
        "kernel_called_before_src_signature_case"
      ]
    },
