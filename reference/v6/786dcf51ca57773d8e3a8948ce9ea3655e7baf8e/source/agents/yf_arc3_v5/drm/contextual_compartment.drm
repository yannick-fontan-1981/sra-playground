{
  "module_id": "contextual_compartment",
  "declarations": [
    {
      "id": "principle.observed_compartment_changes_open_contextual_lifecycle_experiments",
      "kind": "principle",
      "family_ref": "family.interaction_configuration",
      "abstraction_level": "causal_variant",
      "general_principle_refs": [
        "principle.action_conditioned_multiframe_transition_opens_process_supposition"
      ],
      "premises": [
        "equal_framed_contents_adjoin_one_pattern_and_one_parallel_cavity",
        "graphical_identity_can_propose_but_not_confirm_a_transfer",
        "jointly_present_contents_can_motivate_one_activation_experiment",
        "local_activity_can_motivate_one_progress_experiment",
        "new_parallel_content_can_motivate_one_contextual_dispatch_experiment"
      ],
      "invariants": [
        "retain_occlusion_displacement_and_transformation_alternatives",
        "no_complete_recipe_or_timing_law_from_appearance_alone",
        "method_recall_never_renews_current_evidence",
        "canonical_why_and_act_remain_independent"
      ],
      "falsifiers": [
        "current_frame_geometry_or_sealed_transition_disagrees",
        "two_relevant_experiments_remain_and_no_common_prefix_is_justified"
      ],
      "reason_refs": [
        "reason.current_contextual_compartment_question"
      ]
    },
    {
      "id": "policy.contextual_compartment_scope",
