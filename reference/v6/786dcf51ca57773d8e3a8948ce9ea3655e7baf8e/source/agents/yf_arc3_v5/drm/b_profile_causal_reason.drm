          ],
          "static_facts": {
            "eligible": true
          }
        }
      ]
    },
    {
      "id": "rule.b_profile_conditional_parent_reason",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "premises": [
        "source_selected_current_candidate_serves_parent_demand"
      ],
      "applicability": [
        "qualified_handoff_or_future_matching_contribution"
      ],
      "invariants": [
        "conditional_future_keeps_unresolved_dependencies",
        "no_candidate_becomes_executable_by_derivation"
      ],
      "falsifiers": [
        "future_or_current_model_refuted"
      ],
      "reason_refs": [
        "reason_intermediate_effect_must_serve_current_parent_demand"
      ],
      "term_templates": [
        {
          "id_pattern": "{reason_candidate_ref}",
          "kind": "value",
          "label": "Conditional means for the current parent demand",
          "required_fields": [
            "reason_candidate_ref",
            "candidate"
          ],
          "static_attributes": {
            "projection_contract_ref": "mechanical.causal_reason.b.v1",
            "no_dispatch_or_action_authority": true
          },
          "attribute_bindings": {
            "candidate": "candidate",
            "intermediate_kind": "intermediate_kind",
            "causal_reason_ref": "causal_reason_ref",
            "unresolved_dependency_refs": "unresolved_dependency_refs",
            "utility_reason_ref": "utility_reason_ref",
            "desired_future": "desired_future",
            "goal_contract": "goal_contract",
            "consumer_refs": "consumer_refs",
            "preservation_refs": "preservation_refs",
            "model_ref": "model_ref",
            "model_alternatives_ref": "model_alternatives_ref",
            "native_response_ref": "native_response_ref",
            "next_item_ref": "next_item_ref",
            "sibling_item_refs": "sibling_item_refs"
          }
        }
      ],
      "claim_templates": [
        {
          "id_pattern": "claim.{reason_candidate_ref}",
          "predicate": "proposes_conditional_means_for_parent_demand",
          "family": "epistemic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "{reason_candidate_ref}",
            "{parent_goal_ref}",
            "{question_ref}"
          ],
          "required_term_patterns": [
            "{reason_candidate_ref}",
            "{parent_goal_ref}",
            "{question_ref}"
          ],
          "required_fields": [
            "reason_candidate_ref",
            "parent_goal_ref",
            "question_ref",
            "causal_reason_ref"
          ],
          "scope_bindings": {
            "parent_goal_ref": "parent_goal_ref",
            "epoch": "epoch",
            "input_revision_ref": "input_revision_ref",
            "scope_ref": "scope_ref"
          },
          "attribute_bindings": {
            "candidate": "candidate",
            "intermediate_kind": "intermediate_kind",
            "causal_reason_ref": "causal_reason_ref",
            "unresolved_dependency_refs": "unresolved_dependency_refs",
            "utility_reason_ref": "utility_reason_ref",
            "desired_future": "desired_future",
            "goal_contract": "goal_contract",
            "consumer_refs": "consumer_refs",
            "preservation_refs": "preservation_refs",
            "model_ref": "model_ref",
            "model_alternatives_ref": "model_alternatives_ref",
            "native_response_ref": "native_response_ref",
            "next_item_ref": "next_item_ref",
            "sibling_item_refs": "sibling_item_refs"
          },
          "static_attributes": {
            "conditional_model_only": true,
            "no_dispatch_or_action_authority": true
          }
        }
      ]
    }
  ]
}
