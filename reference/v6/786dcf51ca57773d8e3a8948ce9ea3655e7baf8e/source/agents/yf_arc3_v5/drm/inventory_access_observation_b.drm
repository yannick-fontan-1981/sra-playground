{
  "module_id": "arc3.inventory_access_observation_b",
  "declarations": [
    {
      "id": "policy.record_observed_inventory_access",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "declared_alternative_refs": [
        "interpretation.inventory_shape_transfer",
        "interpretation.inventory_conditioned_entry",
        "interpretation.inventory_boundary_possession_supposition",
        "interpretation.inventory_episode_display_basis_change"
      ],
      "fact_projections": [
        {
          "id": "projection.inventory_access_observation_claim_binding",
          "templated_facts": {
            "source_claim_ref": "claim.inventory_access.{observation_token}"
          }
        },
        {
          "id": "projection.inventory_shape_transfer",
          "all_conditions": [
            {
              "field": "observation_kind",
              "operator": "equals",
              "expected": "local_shape_transfer_to_edge_display"
            },
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "interpretation.inventory_shape_transfer"
            }
          ],
          "static_facts": {
            "inventory_observation_eligible": true
          }
        },
        {
          "id": "projection.inventory_conditioned_entry",
          "all_conditions": [
            {
              "field": "observation_kind",
              "operator": "equals",
              "expected": "display_conditioned_adjacent_entry"
            },
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "interpretation.inventory_conditioned_entry"
            }
          ],
          "static_facts": {
            "inventory_observation_eligible": true
          }
        },
        {
          "id": "projection.inventory_access.exact_measured_complement_supports_observation",
          "all_conditions": [
            {
              "field": "compatible_access_relation_observed",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "inventory_observation_basis_qualified": true
          }
        },
        {
          "id": "projection.inventory_access.acquired_slot_supports_new_part_transfer",
          "all_conditions": [
            {
              "field": "observation_kind",
              "operator": "equals",
              "expected": "local_shape_transfer_to_edge_display"
            },
            {
              "field": "display_count_scope",
              "operator": "equals",
              "expected": "acquired_slot_pattern"
            },
            {
              "field": "slot_acquisition_support_ref_count",
              "operator": "greater_than",
              "expected": 0
            }
          ],
          "static_facts": {
            "inventory_observation_basis_qualified": true
          }
        },
        {
          "id": "projection.inventory_access.boundary_mask_keeps_revisable_episode_candidate",
          "all_conditions": [
            {
              "field": "observation_kind",
              "operator": "equals",
              "expected": "boundary_display_patch_change"
            },
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "interpretation.inventory_boundary_possession_supposition"
            },
            {
              "field": "display_before_equals_acquired_sample",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "display_after_equals_empty_sample",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "display_after_equals_acquired_sample",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "display_after_empty_delta_is_single_palette_support",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "display_after_empty_delta_value_count",
              "operator": "equals",
              "expected": 1
            },
            {
              "field": "display_after_empty_delta_value_is_new",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "inventory_observation_eligible": true,
            "inventory_observation_basis_qualified": true
          }
        },
        {
          "id": "projection.inventory_access.observed_basis_change",
          "all_conditions": [
            {
              "field": "observation_kind",
              "operator": "equals",
              "expected": "episode_display_basis_change"
            },
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "interpretation.inventory_episode_display_basis_change"
            },
            {
              "field": "observed_basis_patch_changed",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "inventory_observation_eligible": true,
            "inventory_observation_basis_qualified": true
          }
        }
      ],
      "selection_eligibility_conditions": [
        {
          "field": "inventory_observation_eligible",
          "operator": "equals",
          "expected": true
        },
        {
          "field": "inventory_observation_basis_qualified",
          "operator": "equals",
          "expected": true
        }
      ],
      "meaning_template_ref_by_alternative": {
        "interpretation.inventory_shape_transfer": "rule.observed_inventory_shape_transfer",
        "interpretation.inventory_conditioned_entry": "rule.observed_inventory_conditioned_entry",
        "interpretation.inventory_boundary_possession_supposition": "rule.boundary_display_supports_episode_possession_supposition",
        "interpretation.inventory_episode_display_basis_change": "rule.observed_episode_display_basis_change"
      },
      "invariants": [
        "one_witness_supports_a_conditional_method_not_a_universal_law",
        "current_possession_requires_current_display_revalidation",
        "exact_capacity_and_hidden_inventory_remain_unknown"
      ],
      "falsifiers": [
        "current_world_display_or_control_scope_contradicts_the_sample"
      ],
      "reason_refs": [
        "reason.coupled_world_display_changes_support_conditional_inventory_methods"
      ],
      "configuration": {
        "meaning_evidence_refs_field": "inventory_evidence_refs"
      }
    },
