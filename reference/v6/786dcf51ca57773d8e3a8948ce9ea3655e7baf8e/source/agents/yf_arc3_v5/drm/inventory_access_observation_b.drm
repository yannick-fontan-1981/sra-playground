    {
      "id": "rule.boundary_display_supports_episode_possession_supposition",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "dynamic",
      "premises": [
        "observed_acquisition_and_exact_last_visible_held_patch",
        "observed_scene_epoch_change",
        "current_compartment_replaced_by_new_uniform_material",
        "current_display_does_not_match_acquired_empty_sample"
      ],
      "invariants": [
        "supported_claim_concerns_a_revisable_supposition_not_hidden_inventory_truth",
        "no_old_route_world_coordinate_or_pending_action_crosses_the_boundary",
        "every_compatible_signature_is_retained",
        "current_epoch_and_display_must_be_revalidated_before_each_use",
        "no_global_policy_of_boundary_inventory_conservation"
      ],
      "falsifiers": [
        "current_display_reverts_to_empty_or_changes_again",
        "current_compatible_access_refuses_the_remembered_possession",
        "observed_consumption_or_drop_or_epoch_change_invalidates_current_use"
      ],
      "term_templates": [
        {
          "id_pattern": "event.inventory_access.{observation_token}",
          "kind": "entity",
          "label": "revisable episode possession at an observed display mask",
          "required_fields": [
            "observation_token",
            "observation_kind",
            "transition_ref",
            "action_ref",
            "before_frame_ref",
            "after_frame_ref",
            "before_context_epoch",
            "context_epoch",
            "display_slot_bbox",
            "display_patch_before",
            "display_patch_after",
            "display_empty_patch",
            "part_shape_ref",
            "part_relative_pixels",
            "inserted_cell_pixels",
            "part_value",
            "acquisition_support_refs",
            "source_claim_ref"
          ],
          "static_attributes": {
            "projection_contract": "yf_arc3_v5.episode_inventory_supposition.v1",
