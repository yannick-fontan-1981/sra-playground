{
  "module_id": "arc3.directed_flow_frontier_d",
  "declarations": [
    {
      "id": "policy.directed_flow_frontier_d", "kind": "selection_policy", "evaluation": "declared_eligibility_single",
      "supported_operators": ["SELECT"], "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1", "reason_refs": ["reason.actual_sealed_flow_history_preserves_separate_processes"],
      "configuration": {"support_predicate_ref": "qualifies_actual_ordered_directed_flow_frontier"},
      "declared_alternative_refs": ["flow_frontier.publish", "flow_frontier.unknown"],
      "selection_eligibility_conditions": [{"field": "eligible", "operator": "equals", "expected": true}],
      "fact_projections": [
        {"id": "projection.flow_frontier.publish", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "flow_frontier.publish"},
          {"field": "flow_frontier_complete", "operator": "equals", "expected": true}
        ], "static_facts": {"eligible": true}},
        {"id": "projection.flow_frontier.unknown", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "flow_frontier.unknown"},
          {"field": "flow_frontier_complete", "operator": "equals", "expected": false}
        ], "static_facts": {"eligible": true}}
      ],
      "meaning_template_ref_by_alternative": {"flow_frontier.publish": "rule.directed_flow_frontier_d"},
      "invariants": ["actual_dispatched_intents_and_acquired_responses", "packet_order_not_invented_ticks",
        "rigid_control_source_front_trace_capture_and_leak_distinct", "lineage_alternatives_preserved",
        "no_safe_capture_from_side_contact_or_fill_alone", "no_volume_or_turning_law_inference", "no_action_authority"]
    },
    {
      "id": "rule.directed_flow_frontier_d", "kind": "rule", "evaluation": "project_requested_conclusions",
      "supported_operators": ["DERIVE"], "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1", "relation_family": "epistemic",
      "reason_refs": ["reason.actual_sealed_flow_history_preserves_separate_processes"],
      "term_templates": [{"id_pattern": "{frontier_term_ref}", "kind": "value", "label": "Actual ordered directed-flow causal measurements",
        "required_fields": ["frontier_term_ref", "value", "frontier_digest", "packet_digest"],
        "attribute_bindings": {"value": "value", "frontier_digest": "frontier_digest", "packet_digest": "packet_digest"},
        "static_attributes": {"source_kind_ref": "directed_flow.acquired_frontier.v1", "flow_laws_confirmed": false, "no_action_authority": true}}],
      "claim_templates": [{"id_pattern": "{frontier_support_claim_ref}", "predicate": "qualifies_actual_ordered_directed_flow_frontier",
        "family": "epistemic", "epistemic_status": "supported", "argument_patterns": ["{frontier_term_ref}", "{packet_term_ref}"],
        "required_term_patterns": ["{frontier_term_ref}", "{packet_term_ref}"], "required_fields": ["frontier_support_claim_ref", "frontier_digest", "packet_digest"],
        "attribute_bindings": {"frontier_digest": "frontier_digest", "packet_digest": "packet_digest"},
        "scope_bindings": {"parent_goal_ref": "parent_goal_ref", "scope_ref": "scope_ref", "epoch": "epoch",
          "input_revision_ref": "input_revision_ref", "current_frame_ref": "current_frame_ref", "episode_ref": "episode_ref", "level_scope_ref": "level_scope_ref"},
        "static_attributes": {"no_action_authority": true, "no_physical_goal_confirmation": true}}]
    }
  ]
}
