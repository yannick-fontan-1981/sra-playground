{
  "module_id":"arc3.recipe_projectile_contact_root",
  "declarations":[
    {
      "id":"policy.recipe_projectile_contact_root","kind":"selection_policy",
      "evaluation":"declared_eligibility_single","supported_operators":["SELECT"],
      "input_contract":"yf_arc3_v5.authority_input.selection.v1",
      "output_contract":"yf_arc3_v5.authority_output.selection.v1",
      "reason_refs":["reason.actual_visible_projectile_mask_contacts_acquired_region"],
      "declared_alternative_refs":["recipe_contact.publish","recipe_contact.unknown"],
      "selection_eligibility_conditions":[{"field":"eligible","operator":"equals","expected":true}],
      "fact_projections":[
        {"id":"projection.recipe_contact.publish","all_conditions":[
          {"field":"alternative_ref","operator":"equals","expected":"recipe_contact.publish"},
          {"field":"visible_contact_current","operator":"equals","expected":true}
        ],"static_facts":{"eligible":true}},
        {"id":"projection.recipe_contact.unknown","all_conditions":[
          {"field":"alternative_ref","operator":"equals","expected":"recipe_contact.unknown"},
          {"field":"visible_contact_current","operator":"equals","expected":false}
        ],"static_facts":{"eligible":true}}
      ],
      "meaning_template_ref_by_alternative":{"recipe_contact.publish":"rule.recipe_projectile_contact_root"},
      "invariants":["actual_visible_mask_contact_only","disappearance_is_not_an_impact_anchor",
        "same_actual_frame_and_coordinate_basis","conditional_remote_effect_identities",
        "no_collision_direction_termination_or_role_law_confirmation","no_action_authority"]
    },
    {
      "id":"rule.recipe_projectile_contact_root","kind":"rule",
      "evaluation":"project_requested_conclusions","supported_operators":["DERIVE"],
      "input_contract":"yf_arc3_v5.authority_input.derivation.v1",
      "output_contract":"yf_arc3_v5.authority_output.derivation.v1","relation_family":"epistemic",
      "reason_refs":["reason.actual_visible_projectile_mask_contacts_acquired_region"],
      "term_templates":[{
        "id_pattern":"{impact_term_ref}","kind":"value","label":"Actual visible projectile contact over a sealed interval",
        "required_fields":["impact_term_ref","observed_impact","observed_impact_digest","packet_digest","frame_ref","observation_record_ref"],
        "attribute_bindings":{"observed_impact":"observed_impact","observed_impact_digest":"observed_impact_digest",
          "packet_digest":"packet_digest","frame_ref":"frame_ref","observation_record_ref":"observation_record_ref",
          "coordinate_axis_order":"coordinate_axis_order"},
        "static_attributes":{"source_kind_ref":"recipe.observed_projectile_contact.v1","remote_effect_identity_is_conditional":true,"collision_law_confirmed":false,"no_action_authority":true}
      }],
      "claim_templates":[{
        "id_pattern":"{impact_claim_ref}","predicate":"qualifies_observed_recipe_projectile_contact",
        "family":"epistemic","epistemic_status":"supported",
        "argument_patterns":["{impact_term_ref}","{observation_record_ref}"],
        "required_term_patterns":["{impact_term_ref}","{packet_term_ref}"],
        "required_fields":["impact_claim_ref","observed_impact","observed_impact_digest","packet_digest"],
        "scope_bindings":{"parent_goal_ref":"parent_goal_ref","scope_ref":"scope_ref",
          "episode_ref":"episode_ref","level_scope_ref":"level_scope_ref","epoch":"epoch","input_revision_ref":"input_revision_ref"},
        "attribute_bindings":{"observed_impact":"observed_impact","observed_impact_digest":"observed_impact_digest","packet_digest":"packet_digest"},
        "static_attributes":{"remote_effect_identity_is_conditional":true,"collision_law_confirmed":false,"no_action_authority":true}
      }]
    }
  ]
}
