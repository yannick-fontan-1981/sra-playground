      "meaning_template_ref_by_alternative":{"shape_binding.publish":"rule.shape_native_field_binding_c"},
      "premises":["actual_acquired_canonical_source","exact_native_field_and_current_scope"],
      "invariants":["binding_is_not_new_physical_law","no_action_authority"],
      "falsifiers":["source_revision_changes","unsupported_or_wrong_polarity_source"],
