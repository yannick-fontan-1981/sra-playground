        "attribute_bindings":{"native_field_ref":"native_field_ref"},
        "static_attributes":{"projection_contract_ref":"shape.native_field_binding.c.v1"}}],
      "premises":["supported_actual_acquired_field"],"invariants":["exact_scope_and_value","no_dispatch_authority"],
      "falsifiers":["canonical_source_changes"],"reason_refs":["reason.current_acquired_shape_field_binds_requested_calculation"]
    },
