{
  "module_id": "shape_solving_c",
  "declarations": [
    {
      "id": "policy.shape_solving_c",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "premises": [
        "current_complete_contour_parent_question"
      ],
      "applicability": [
        "K26_requested_operation"
      ],
      "invariants": [
        "supported_contact_shape_law",
        "complete_internal_geometry_and_layer_collision",
        "current_shape_body_state",
        "current_contact_and_aspect_phase_scope",
        "no_act"
      ],
      "falsifiers": [
        "unbound_complete_contour",
        "wrong_transit_or_restoration_receipt",
        "ungrounded_contact_or_colour"
      ],
      "selection_required_fact_fields": [
        "alternative_ref"
      ],
      "declared_alternative_refs": [
        "shape_solving.native",
        "shape_solving.missing"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "applicable",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.shape_solving.0",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "shape_solving.native"
            },
            {
              "field": "current_shape_question",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "applicable": true,
            "disposition_ref": "shape_solving.native"
          }
        },
        {
          "id": "projection.shape_solving.1",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "shape_solving.missing"
            },
            {
              "field": "current_shape_question",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "applicable": true,
            "disposition_ref": "shape_solving.missing"
          }
        }
      ],
      "selection_tiers": [
        {
          "id": "tier.shape_solving.0",
          "all_conditions": [
            {
              "field": "disposition_ref",
              "operator": "equals",
              "expected": "shape_solving.native"
            }
          ],
          "reason_ref": "reason.supported_contact_supplies_final_contour_and_aspect"
        },
        {
          "id": "tier.shape_solving.1",
          "all_conditions": [
            {
              "field": "disposition_ref",
              "operator": "equals",
              "expected": "shape_solving.missing"
            }
          ],
          "reason_ref": "reason.shape_question_requires_current_evidence"
        }
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.shape_solving_activation_unverified",
      "reason_refs": [
        "reason.supported_contact_supplies_final_contour_and_aspect",
        "reason.shape_question_requires_current_evidence"
      ]
    },
    {
      "id":"policy.shape_binding_publication_c","kind":"selection_policy","evaluation":"declared_eligibility_single",
      "supported_operators":["SELECT"],"input_contract":"yf_arc3_v5.authority_input.selection.v1",
