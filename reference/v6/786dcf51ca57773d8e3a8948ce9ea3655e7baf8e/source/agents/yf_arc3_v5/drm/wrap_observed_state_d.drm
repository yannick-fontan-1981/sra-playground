{
  "module_id": "arc3.wrap_observed_state_d",
  "declarations": [
    {
      "id": "policy.wrap_observed_state_d", "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order", "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": ["reason.wrap_current_acquired_state", "reason.wrap_acquisition_missing"],
      "declared_alternative_refs": ["wrap_observed.publish_complete", "wrap_observed.unknown"],
      "selection_tie_breakers": [{"field": "alternative_ref", "preferred_order": "minimize"}],
      "canonical_equivalence_tie_break_debt_ref": "debt.wrap_equivalent_state",
      "selection_tiers": [
        {"id": "tier.wrap_observed.complete", "reason_ref": "reason.wrap_current_acquired_state",
         "all_conditions": [
           {"field": "alternative_ref", "operator": "equals", "expected": "wrap_observed.publish_complete"},
           {"field": "observed_wrap_state_complete", "operator": "equals", "expected": true}
         ]},
        {"id": "tier.wrap_observed.unknown", "reason_ref": "reason.wrap_acquisition_missing",
         "all_conditions": [{"field": "alternative_ref", "operator": "equals", "expected": "wrap_observed.unknown"}]}
      ],
      "meaning_template_ref_by_alternative": {"wrap_observed.publish_complete": "rule.wrap_acquired_state_d"},
      "configuration": {"support_predicate_ref": "qualifies_acquired_wrap_state", "source_kind_ref": "wrap.acquired_state.v1"}
    },
    {
      "id": "rule.wrap_acquired_state_d", "kind": "rule",
      "evaluation": "project_requested_conclusions", "supported_operators": ["DERIVE"],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic", "reason_refs": ["reason.wrap_current_acquired_state"],
      "invariants": ["mandatory_fields_have_acquisition_even_if_empty", "body_axes_explicit", "role_status_not_promoted", "no_action_authority"],
      "term_templates": [{
        "id_pattern": "{state_term_ref}", "kind": "value", "label": "Current acquired WrapState",
        "required_fields": ["state_term_ref", "value", "state_digest", "frame_ref", "observation_record_ref"],
        "static_attributes": {"source_kind_ref": "wrap.acquired_state.v1", "role_truth_promoted": false},
        "attribute_bindings": {"value": "value", "state_digest": "state_digest", "type_relations": "type_relations", "state_view_type": "state_view_type",
          "field_provenance": "field_provenance", "field_provenance_digest": "field_provenance_digest",
          "frame_ref": "frame_ref", "raw_input_ref": "raw_input_ref", "observation_record_ref": "observation_record_ref"}
      }],
      "claim_templates": [{
        "id_pattern": "{state_support_claim_ref}", "predicate": "qualifies_acquired_wrap_state",
        "family": "epistemic", "epistemic_status": "supported",
        "argument_patterns": ["{state_term_ref}", "{observation_record_ref}"], "required_term_patterns": ["{state_term_ref}"],
        "required_fields": ["state_support_claim_ref", "state_term_ref", "observation_record_ref", "state_digest"],
        "attribute_bindings": {"state_digest": "state_digest", "field_provenance_digest": "field_provenance_digest", "state_view_type": "state_view_type"},
        "static_attributes": {"no_action_authority": true, "role_truth_promoted": false},
        "scope_bindings": {
          "frame_ref": "frame_ref", "raw_input_ref": "raw_input_ref", "timeline_ref": "timeline_ref",
          "observation_record_ref": "observation_record_ref", "parent_goal_ref": "parent_goal_ref",
          "parent_contribution_ref": "parent_contribution_ref", "consumer_ref": "consumer_ref", "caller_ref": "caller_ref",
          "scope_ref": "scope_ref", "episode_ref": "episode_ref", "level_scope_ref": "level_scope_ref", "epoch": "epoch",
          "input_revision_ref": "input_revision_ref", "evidence_revision_ref": "evidence_revision_ref",
          "model_revision_ref": "model_revision_ref", "event_owner_ref": "event_owner_ref"
        }
      }]
    }
  ]
}
