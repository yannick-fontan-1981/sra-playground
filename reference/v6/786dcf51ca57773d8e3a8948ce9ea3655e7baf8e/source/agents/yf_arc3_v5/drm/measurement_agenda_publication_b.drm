          }
        },
        {
          "id": "projection.measurement_need.blocked",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "measurement_need.blocked"
            },
            {
              "field": "need_bindings_current",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "eligible": true
          }
        }
      ],
      "meaning_template_ref_by_alternative": {
        "measurement_need.license": "rule.parent_measurement_need_b"
      },
      "configuration": {
        "measurement_need_predicate_ref": "requires_exact_specialized_measurement",
        "need_statuses": [
          "supported",
          "established"
        ],
        "premise_status_map": {
          "proposed": "PROVISIONAL",
          "supported": "SUPPORTED",
          "established": "SUPPORTED"
        },
        "premise_scope_fields": {
          "epoch": "premise_epoch",
          "input_revision_ref": "premise_revision_ref",
          "scope_ref": "premise_scope_ref"
        },
        "consumer_scope_fields": {
          "input_revision_ref": "current_input_revision_ref",
          "scope_ref": "current_scope_ref"
        },
        "extension_policy_ref": "policy.measurement_extension_c",
        "admitted_disposition_refs": [
          "measurement_extension.append_exact_request",
          "measurement_extension.reuse_existing_request"
        ],
        "append_disposition_ref": "measurement_extension.append_exact_request",
        "projection_contract_ref": "family_agenda.canonical_snapshot.v1",
        "question_projection_contract_ref": "projection.parent_dependency_revalidation_question.v1"
      }
    },
    {
      "id": "rule.parent_measurement_need_b",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
