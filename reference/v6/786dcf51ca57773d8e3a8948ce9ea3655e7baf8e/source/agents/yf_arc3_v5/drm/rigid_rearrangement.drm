    {
      "id": "principle.rigid_rearrangement.unique_approach_clearance_is_a_focused_question",
      "kind": "principle",
      "premises": [
        "a_static_independent_unit_translation_model_is_currently_admitted",
        "the_beneficiary_has_exactly_one_admitted_non_goal_predecessor_for_final_entry",
        "complete_bounded_incidence_measurement_yields_one_participant_set_for_clearance"
      ],
      "applicability": [
        "source_rigid_rearrangement_search_request"
      ],
      "invariants": [
        "a_blocker_endpoint_must_leave_the_whole_approach_footprint",
        "an_optional_helper_has_a_currently_free_endpoint_preserving_approach_and_blocker_endpoint",
        "retain_the_current_focus_in_the_participant_set",
        "all_other_bodies_remain_in_full_state_and_collision_masks",
        "only_selection_operator_domain_is_restricted",
        "K09_still_computes_every_route_and_detour",
        "partial_enumeration_never_proves_uniqueness",
        "focused_failure_widens_to_the_preserved_full_question_within_the_existing_watchdog",
        "restricted_minimality_or_exhaustion_never_means_global_minimality_or_impossibility"
      ],
      "falsifiers": [
        "admissions_or_poses_change",
        "a_non_unit_or_coupled_transition_is_required",
        "geometry_measurement_is_incomplete",
        "several_participant_sets_remain"
      ],
      "reason_refs": [
        "reason.rigid_rearrangement.unique_clearance_incidence_prepares_existing_search"
      ]
    },
