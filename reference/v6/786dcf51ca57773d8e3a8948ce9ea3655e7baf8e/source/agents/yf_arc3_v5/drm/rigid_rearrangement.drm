      "id": "principle.rigid_scene.current_marked_frame_is_not_a_single_color_mask",
      "kind": "principle",
      "premises": [
        "a_closed_frame_encloses_several_current_components",
        "the_enclosed_components_share_the_current_input_aligned_translation"
      ],
      "applicability": [
        "current_observed_rigid_scene_acquisition"
      ],
      "invariants": [
        "preserve_the_outer_frame_and_each_interior_component_separately",
        "a_marking_is_not_a_hole_or_another_body_by_color_alone",
        "infer_a_rigid_body_only_as_a_revisable_effect_backed_supposition",
        "derive_quantum_from_observed_translation_not_a_game_constant",
        "keep_palette_correspondence_distinct_from_collision_class_membership"
      ],
      "falsifiers": [
        "enclosed_components_move_differently",
        "the_frame_is_incomplete",
        "a_same_class_object_passes_over_another"
      ],
      "reason_refs": [
        "reason.rigid_scene.current_cotranslated_frame_preserves_marked_body_identity",
        "reason.rigid_scene.certified_clearance_word_serves_the_preserved_parent"
      ]
    },
