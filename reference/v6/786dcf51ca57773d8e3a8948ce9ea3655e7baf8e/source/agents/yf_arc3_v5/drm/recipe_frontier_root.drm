{
  "module_id": "arc3.recipe_frontier_root",
  "declarations": [
    {
      "id": "policy.recipe_frontier_measurement_root",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.recipe_actual_current_facet",
        "reason.recipe_facet_missing_premise"
      ],
      "declared_alternative_refs": [
        "recipe_frontier.measure",
        "recipe_frontier.input_missing"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.recipe_facet_equivalent_measurements",
      "selection_tiers": [
        {
          "id": "tier.recipe_frontier.measure",
          "reason_ref": "reason.recipe_actual_current_facet",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "recipe_frontier.measure"
            },
            {
              "field": "native_input_current",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.recipe_frontier.input_missing",
          "reason_ref": "reason.recipe_actual_current_facet",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "recipe_frontier.input_missing"
            }
          ]
        }
      ]
    },
    {
      "id": "policy.recipe_frontier_interpretation_root",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.recipe_actual_current_facet",
        "reason.recipe_facet_missing_premise"
      ],
      "declared_alternative_refs": [
        "recipe_frontier.recipe_edit",
        "recipe_frontier.demonstration",
        "recipe_frontier.resize",
        "recipe_frontier.projectile",
        "recipe_frontier.transport",
        "recipe_frontier.missing"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.recipe_facet_equivalent_measurements",
      "selection_tiers": [
        {
          "id": "tier.recipe_frontier.recipe_edit",
          "reason_ref": "reason.recipe_actual_current_facet",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "recipe_frontier.recipe_edit"
            },
            {
              "field": "facet_kind",
              "operator": "equals",
              "expected": "RECIPE_EDIT"
            },
            {
              "field": "interpretation_ready",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "native_effect_matches",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "known_trigger_premises",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.recipe_frontier.demonstration",
          "reason_ref": "reason.recipe_actual_current_facet",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "recipe_frontier.demonstration"
            },
            {
              "field": "facet_kind",
              "operator": "equals",
              "expected": "DEMONSTRATION"
            },
            {
              "field": "interpretation_ready",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "native_effect_matches",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "demo_supported",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.recipe_frontier.resize",
          "reason_ref": "reason.recipe_actual_current_facet",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "recipe_frontier.resize"
            },
            {
              "field": "facet_kind",
              "operator": "equals",
              "expected": "RESIZE"
            },
            {
              "field": "interpretation_ready",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "native_effect_matches",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "resize_quantum_known",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "target_signature_preserved",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "preservation_fields_preserved",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.recipe_frontier.projectile",
          "reason_ref": "reason.recipe_actual_current_facet",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "recipe_frontier.projectile"
            },
            {
              "field": "facet_kind",
              "operator": "equals",
              "expected": "PROJECTILE"
            },
            {
              "field": "interpretation_ready",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "native_effect_matches",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "projectile_impact_known",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "collision_order_supported",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "projectile_trajectory_current",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "projectile_world_effect_links_current",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.recipe_frontier.transport",
          "reason_ref": "reason.recipe_actual_current_facet",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "recipe_frontier.transport"
            },
            {
              "field": "facet_kind",
              "operator": "equals",
              "expected": "TRANSPORT"
            },
            {
              "field": "interpretation_ready",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "native_effect_matches",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "transport_landing_supported",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "destination_domain_complete",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.recipe_frontier.missing",
          "reason_ref": "reason.recipe_actual_current_facet",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "recipe_frontier.missing"
            }
          ]
        }
      ],
      "meaning_template_ref_by_alternative": {
        "recipe_frontier.recipe_edit": "rule.recipe_frontier_interpretation_root",
        "recipe_frontier.demonstration": "rule.recipe_frontier_interpretation_root",
        "recipe_frontier.resize": "rule.recipe_frontier_interpretation_root",
        "recipe_frontier.projectile": "rule.recipe_frontier_interpretation_root",
        "recipe_frontier.transport": "rule.recipe_frontier_interpretation_root"
      },
      "configuration": {
        "interpretation_predicate_ref": "supports_current_recipe_facet_interpretation",
        "unresolved_demonstration_alternative_refs": [
          "recipe_cause.demonstration", "recipe_cause.failed_execution", "recipe_cause.rollback",
          "recipe_cause.same_value_application", "recipe_cause.hidden_phase"
        ]
      }
    },
    {
      "id": "rule.recipe_frontier_interpretation_root",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "reason_refs": [
        "reason.recipe_actual_current_facet"
      ],
      "invariants": [
        "only_selected_facet",
        "original_parent_why",
        "siblings_preserved",
        "no_role_or_action_authority",
        "native_result_not_game_victory"
      ],
      "term_templates": [
        {
          "id_pattern": "{interpretation_ref}",
          "kind": "value",
          "label": "Current selected recipe effect description",
          "required_fields": [
            "interpretation_ref",
            "interpretation_payload",
            "interpretation_digest"
          ],
          "static_attributes": {
            "source_kind_ref": "recipe.frontier_interpretation.root.v1",
            "no_action_authority": true
          },
          "attribute_bindings": {
            "interpretation": "interpretation_payload",
            "interpretation_digest": "interpretation_digest"
          }
        }
      ],
      "claim_templates": [
        {
          "id_pattern": "{interpretation_claim_ref}",
          "predicate": "supports_current_recipe_facet_interpretation",
          "family": "epistemic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "{interpretation_ref}",
            "{facet_ref}",
            "{parent_goal_ref}",
            "{packet_term_ref}"
          ],
          "required_term_patterns": [
            "{interpretation_ref}",
            "{facet_ref}",
            "{parent_goal_ref}",
            "{packet_term_ref}"
          ],
          "required_fields": [
            "interpretation_claim_ref",
            "interpretation_ref",
            "facet_ref",
            "parent_goal_ref",
            "packet_term_ref",
            "interpretation_digest"
          ],
          "attribute_bindings": {
            "interpretation_digest": "interpretation_digest"
          },
          "static_attributes": {
            "no_action_authority": true,
            "no_universal_mechanism_confirmation": true
          },
          "scope_bindings": {
            "parent_goal_ref": "parent_goal_ref",
            "scope_ref": "scope_ref",
            "episode_ref": "episode_ref",
            "level_scope_ref": "level_scope_ref",
            "epoch": "epoch",
            "input_revision_ref": "input_revision_ref",
            "model_alternatives": "model_alternatives"
          }
        }
      ]
    }
  ]
}
