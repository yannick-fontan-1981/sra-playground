{
  "module_id": "transport",
  "declarations": [
    {
      "id": "policy.close_observed_framed_reception_scope", "kind": "selection_policy",
      "evaluation": "declared_eligibility_single", "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "declared_alternative_refs": ["interpretation.framed_reception_scope_achieved"],
      "selection_eligibility_conditions": [{"field": "framed_replacement_border_preserved", "operator": "equals", "expected": true}],
      "fact_projections": [{"id": "projection.observed_framed_goal_closure",
        "all_conditions": [{"field": "framed_replacement_border_preserved", "operator": "equals", "expected": true}],
        "static_facts": {"meaning_applicable": true}}],
      "meaning_template_ref_by_alternative": {"interpretation.framed_reception_scope_achieved": "rule.observed_framed_reception_scope_achieved"},
      "invariants": ["SRC_requires_exact_released_scope_reference_equality", "uniform_entry_closes_only_the_preparation_child", "principal_goal_and_unobserved_dependencies_remain_open"],
      "falsifiers": ["received_shape_or_frame_changes_or_the_goal_scope_differs"],
      "reason_refs": ["reason.observed_child_effect_refreshes_the_unchanged_parent_means"]
    },
    {
      "id": "rule.observed_framed_reception_scope_achieved", "kind": "rule",
      "evaluation": "project_requested_conclusions", "supported_operators": ["DERIVE"],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1", "relation_family": "control",
      "premises": ["observed_preserved_frame_entry", "the_exact_released_goal_scope_matches_the_observed_shape_and_entry_kind"],
      "invariants": ["close_only_the_evidenced_dependency", "refresh_existing_parent_continuations_without_complete_metaplanning"],
      "falsifiers": ["reception_or_preservation_is_contradicted"],
      "claim_templates": [{
        "id_pattern": "claim.framed_reception_scope.lifecycle.{framed_replacement_reconcile_goal_ref}.{framed_replacement_token}",
        "predicate": "goal_lifecycle_status", "family": "control", "epistemic_status": "supported",
        "argument_patterns": ["{framed_replacement_reconcile_goal_ref}", "locally_satisfied"],
        "required_fields": ["framed_replacement_reconcile_goal_ref", "framed_replacement_token"],
        "static_attributes": {"lifecycle_status": "locally_satisfied", "achievement_scope": "observed_framed_entry_dependency", "commitment": "revisable"},
        "attribute_bindings": {"transition_ref": "framed_replacement_transition_ref", "context_epoch": "framed_replacement_context_epoch"}
      }, {
        "id_pattern": "claim.framed_reception_scope.achieved.{framed_replacement_reconcile_goal_ref}.{framed_replacement_token}",
        "predicate": "goal_achieved", "family": "control", "epistemic_status": "supported",
        "argument_patterns": ["{framed_replacement_reconcile_goal_ref}", "{framed_replacement_transition_ref}"],
        "required_fields": ["framed_replacement_reconcile_goal_ref", "framed_replacement_token", "framed_replacement_transition_ref"],
        "static_attributes": {"achievement_scope": "observed_framed_entry_dependency", "official_level_success_asserted": false, "commitment": "revisable"},
        "attribute_bindings": {"mask_digest": "framed_replacement_mask_digest", "marker_frame_bbox": "framed_replacement_marker_frame_bbox", "context_epoch": "framed_replacement_context_epoch"}
      }],
      "reason_refs": ["reason.observed_child_effect_refreshes_the_unchanged_parent_means"]
    },
    {
      "id": "policy.record_observed_framed_replacement", "kind": "selection_policy",
