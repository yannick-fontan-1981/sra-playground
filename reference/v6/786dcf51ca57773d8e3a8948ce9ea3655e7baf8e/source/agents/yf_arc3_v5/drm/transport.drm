        "templated_facts": {"framed_replacement_reconcile_goal_ref": "goal.reproduce_matching_frame_reception.{framed_replacement_mask_digest}"}
      }, {
        "id": "projection.framed_replacement_uniform_dependency_scope",
        "all_conditions": [{"field": "framed_replacement_marker_uniform", "operator": "equals", "expected": true}],
        "bound_facts": {"framed_replacement_executed_scope_ref": "framed_replacement_prior_subgoal_ref"},
        "templated_facts": {"framed_replacement_reconcile_goal_ref": "subgoal.prepare_uniform_receiver.{framed_replacement_mask_digest}"}
      }],
      "meaning_template_ref_by_alternative": {"interpretation.observed_framed_replacement": "rule.observed_framed_replacement"},
      "invariants": ["separate_uniform_frame_entry_from_matching_shape_replacement", "preserve_marker_identity_despite_appearance_replacement", "reception_and_state_switch_remain_competing_causal_hypotheses"],
      "falsifiers": ["the_displaced_object_is_not_uniquely_preserved", "the_replaced_shape_or_frame_differs"],
      "reason_refs": ["reason.unique_displaced_shape_replacing_its_homologue_supports_revisable_reception"]
    },
    {
