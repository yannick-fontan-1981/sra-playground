    {
      "id": "principle.horizontal_ordered_focus_advances_in_reading_direction",
      "kind": "principle",
      "premises": [
        "one_bounded_horizontal_member_row_is_enclosed_by_a_support",
        "one_local_hollow_contour_uniquely_encloses_the_current_member",
        "the_contour_moves_to_the_immediate_right_successor_after_an_action"
      ],
      "applicability": [
        "ordered_member_action_learning_and_continuation"
      ],
      "invariants": [
        "horizontal_reading_order_runs_from_leftmost_member_to_immediate_right_successor",
        "the_action_is_bound_to_the_normalized_shape_of_the_pre_action_outlined_member_only_after_exact_successor_progress",
        "palette_value_position_and_named_shape_are_not_action_roles",
        "the_correspondence_remains_revisable_and_requires_current_scene_revalidation",
        "vertical_rows_right_to_left_orders_and_skipped_successors_are_outside_this_principle"
      ],
      "falsifiers": [
        "the_member_row_or_local_contour_is_not_unique",
        "the_contour_does_not_advance_exactly_one_ordinal_to_the_right",
        "the_normalized_member_order_changes",
        "later_same_shape_action_evidence_fails_to_advance_the_current_outline"
      ],
      "reason_refs": [
        "reason.current_left_to_right_outlined_member_requires_one_distinct_action_test",
        "reason.observed_right_successor_progress_reuses_the_action_for_the_same_normalized_member_shape"
      ]
    },
