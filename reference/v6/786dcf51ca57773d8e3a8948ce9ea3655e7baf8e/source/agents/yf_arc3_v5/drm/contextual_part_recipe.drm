{
  "module_id": "contextual_part_recipe",
  "declarations": [
    {
      "id": "policy.revalidate_pending_contextual_part_observation",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "configuration": {
        "current_binding_measurement": {
          "projection_contract": "yf_arc3_v5.contextual_part_recipe_binding.v1",
          "maximum_rows": 64,
          "required_attributes": {"binding_operational": false},
          "accepted_observation_phases": ["contextual_change", "pending_configuration_revalidated"],
          "required_fields": [
            "recipe_token", "core_entity_ref", "part_entity_ref", "context_epoch",
            "core_signature", "changed_part_signature", "contact_offset",
            "recipe_premise_claim_refs", "operator_action_ref", "operator_transition_ref",
            "original_part_signature", "original_core_bbox", "original_part_bbox"
          ],
          "proof_predicate": "observed_contextual_part_recipe_sample",
          "proof_statuses": ["supported", "established"],
          "proof_disposition": "active",
          "proof_polarity": "positive",
          "require_current_undefeated_proofs": true,
          "require_common_motion": false,
          "require_original_pose": true,
          "revalidated_phase": "pending_configuration_revalidated"
        }
      },
      "reason_refs": ["reason.retain_contextual_part_change_and_following_common_motion_separately"],
      "invariants": [
        "only_exact_current_identities_signatures_and_relative_pose_are_revalidated",
        "revalidation_preserves_an_open_question_and_does_not_infer_attachment",
        "common_motion_and_action_authority_remain_unacquired"
      ]
    },
    {
      "id": "policy.capture_contextual_command_assembly_appearance",
