        {
          "id": "projection.memory_capture.contextual_command_assembly",
          "all_conditions": [],
          "static_facts": {
            "canonical_learning_projection": {
              "term_attributes": {
                "role": "controlled_assembly_supposition",
                "morphology_mode": "exact_contextual_command_group"
              },
              "member_entity_refs_attribute": "member_refs",
              "require_common_nonzero_member_translation": true,
              "link_predicate": "proposes_role_candidate",
              "proof_rule": "rule.observed_contextual_part_recipe",
              "allowed_link_statuses": [
                "proposed",
                "supported",
                "established"
              ],
              "link_disposition": "active",
              "link_polarity": "positive",
              "entity_attribute": "entity_ref",
              "component_attribute": null,
              "transition_attribute": "transition_ref",
              "action_attribute": "action_ref",
              "claim_entity_argument_index": 0,
              "dedup_entry_id_pattern": "supposition.memory.association.{association_token}",
              "static_learning_facts": {
                "causal_role_ref": "role.controlled_assembly_supposition",
                "mechanism_schema_refs": [
                  "rule.observed_contextual_part_recipe"
                ],
                "disables_source_entity_role_projection": false,
                "archives_source_role_fact_projection": false,
                "falsifier_refs": [
                  "falsifier.member_cotranslation_breaks_rigid_support"
                ],
                "action_conditioned_role_evidence_present": true
              },
              "alternative_current_pose_proof": {
                "predicate": "observed_anchored_pose_part_correspondence",
                "frame_attribute": "operational_scene_ref",
                "transition_attribute": "observation_transition_ref",
                "epoch_attribute": "context_epoch",
                "prior_refs_attribute": "prior_pose_evidence_refs",
                "prior_predicate": "observed_contextual_part_recipe_sample",
                "prior_motion_attribute": "common_motion_transition_ref",
                "statuses": [
                  "supported",
                  "established"
                ],
                "disposition": "active",
                "polarity": "positive"
              }
            }
          }
        }
      ],
      "meaning_template_ref_by_alternative": {
        "memory_capture.canonical_cursor": "rule.captured_canonical_role_appearances"
      },
      "premises": [
        "observed_common_motion_or_unique_current_pose_with_prior_common_motion",
        "existing_core_control_is_preserved"
      ],
      "invariants": [
        "use_the_shared_role_acquisition_receipt_and_current_revalidation",
        "members_remain_distinct",
        "push_and_attachment_remain_revisable",
        "no_universal_operator_law"
