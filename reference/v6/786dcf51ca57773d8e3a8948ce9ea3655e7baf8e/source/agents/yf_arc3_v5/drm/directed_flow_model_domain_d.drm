{
  "module_id": "arc3.directed_flow_model_domain_d",
  "declarations": [
    {
      "id": "policy.directed_flow_model_domain_d", "kind": "selection_policy", "evaluation": "declared_eligibility_single",
      "supported_operators": ["SELECT"], "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1", "reason_refs": ["reason_current_flow_component_population_preserves_each_proposed_model"],
      "configuration": {"support_predicate_ref": "current_source_directed_flow_model_domain_bound", "source_kind_ref": "directed_flow.current_model_domain.v1",
        "required_scope_fields": ["frame_ref", "observation_record_ref", "raw_input_ref", "timeline_ref", "parent_goal_ref", "parent_contribution_ref", "consumer_ref", "caller_ref", "scope_ref", "episode_ref", "level_scope_ref", "epoch", "input_revision_ref", "evidence_revision_ref", "model_revision_ref", "event_owner_ref"]},
      "declared_alternative_refs": ["flow_models.publish", "flow_models.unknown"],
      "selection_eligibility_conditions": [{"field": "eligible", "operator": "equals", "expected": true}],
      "fact_projections": [
        {"id": "projection.flow_models.publish", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "flow_models.publish"},
          {"field": "model_domain_complete", "operator": "equals", "expected": true}
        ], "static_facts": {"eligible": true}},
        {"id": "projection.flow_models.unknown", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "flow_models.unknown"},
          {"field": "model_domain_complete", "operator": "equals", "expected": false}
        ], "static_facts": {"eligible": true}}
      ], "meaning_template_ref_by_alternative": {"flow_models.publish": "rule.directed_flow_model_domain_d"},
      "invariants": ["all_requested_components_current", "no_duplicate_model_identity", "all_model_alternatives_retained", "no_model_law_upgrade", "no_action_authority"]
    },
    {
      "id": "rule.directed_flow_model_domain_d", "kind": "rule", "evaluation": "project_requested_conclusions",
      "supported_operators": ["DERIVE"], "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1", "relation_family": "epistemic",
      "reason_refs": ["reason_current_flow_component_population_preserves_each_proposed_model"],
      "term_templates": [{"id_pattern": "{model_term_ref}", "kind": "value", "label": "Current complete proposed flow model domain",
        "required_fields": ["model_term_ref", "value", "domain_digest", "component_provenance_digest"],
        "attribute_bindings": {"value": "value", "domain_digest": "domain_digest", "component_provenance_digest": "component_provenance_digest",
          "component_provenance": "component_provenance", "frame_ref": "frame_ref", "observation_record_ref": "observation_record_ref"},
        "static_attributes": {"source_kind_ref": "directed_flow.current_model_domain.v1", "no_action_authority": true, "flow_laws_confirmed": false}}],
      "claim_templates": [{"id_pattern": "{model_support_claim_ref}", "predicate": "current_source_directed_flow_model_domain_bound",
        "family": "epistemic", "epistemic_status": "proposed", "argument_patterns": ["{model_term_ref}", "{observation_record_ref}"],
        "required_term_patterns": ["{model_term_ref}"], "required_fields": ["model_support_claim_ref", "domain_digest", "component_provenance_digest"],
        "attribute_bindings": {"domain_digest": "domain_digest", "component_provenance_digest": "component_provenance_digest"},
        "scope_bindings": {"frame_ref": "frame_ref", "observation_record_ref": "observation_record_ref", "raw_input_ref": "raw_input_ref", "timeline_ref": "timeline_ref",
          "parent_goal_ref": "parent_goal_ref", "parent_contribution_ref": "parent_contribution_ref", "consumer_ref": "consumer_ref", "caller_ref": "caller_ref",
          "scope_ref": "scope_ref", "episode_ref": "episode_ref", "level_scope_ref": "level_scope_ref", "epoch": "epoch", "input_revision_ref": "input_revision_ref",
          "evidence_revision_ref": "evidence_revision_ref", "model_revision_ref": "model_revision_ref", "event_owner_ref": "event_owner_ref"},
        "static_attributes": {"no_action_authority": true, "no_physical_law_confirmation": true}}]
    }
  ]
}
