{
  "module_id": "mechanical_family_d_result",
  "declarations": [
    {
      "id": "principle.d_mechanical_parent_scope_is_immutable",
      "kind": "principle",
      "reason_refs": [
        "reason.d_mechanical_exact_caller_bound_signature_and_result"
      ],
      "invariants": [
        "operation_and_mode_are_caller_bound_not_inferred",
        "all_unrejected_models_and_actual_bounds_are_preserved",
        "incomplete_domain_never_proves_robustness_or_empty_world",
        "a_return_does_not_release_an_action_or_replace_parent_and_siblings"
      ],
      "falsifiers": [
        "lost_parent_revision_or_owner",
        "unknown_law_guessed"
      ]
    },
    {
      "id": "policy.d_mechanical_result",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "reason_refs": [
        "reason.d_mechanical_exact_caller_bound_signature_and_result"
      ],
      "supported_operators": [
        "SELECT"
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.d_dispatch_equivalent_alternative_order",
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "declared_alternative_refs": [
        "d_result.complete",
        "d_result.needs_evidence",
        "d_result.not_applicable",
        "d_result.unqualified"
      ],
      "selection_tiers": [
        {
          "id": "tier.d_result.complete",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "d_result.complete"
            },
            {
              "field": "status",
              "operator": "equals",
              "expected": "COMPLETE"
            },
            {
              "field": "domain_complete",
              "operator": "equals",
              "expected": true
            }
          ],
          "reason_ref": "reason.d_mechanical_exact_caller_bound_signature_and_result"
        },
        {
          "id": "tier.d_result.needs_evidence",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "d_result.needs_evidence"
            },
            {
              "field": "status",
              "operator": "equals",
              "expected": "NEEDS_EVIDENCE"
            }
          ],
          "reason_ref": "reason.d_mechanical_exact_caller_bound_signature_and_result"
        },
        {
          "id": "tier.d_result.not_applicable",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "d_result.not_applicable"
            },
            {
              "field": "status",
              "operator": "equals",
              "expected": "NOT_APPLICABLE"
            }
          ],
          "reason_ref": "reason.d_mechanical_exact_caller_bound_signature_and_result"
        },
        {
          "id": "tier.d_result.unqualified",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "d_result.unqualified"
            }
          ],
          "reason_ref": "reason.d_mechanical_exact_caller_bound_signature_and_result"
        }
      ]
    },
