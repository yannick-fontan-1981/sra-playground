        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.exact_request_scoped_model_and_actual_bounds_precede_a_pure_case"
      ],
      "premises": [
        "immutable_request_with_caller_parent_epoch_revision_and_return_type"
      ],
      "invariants": [
        "only_selected_operation_runs",
        "no_external_environment_input",
        "no_action_release_from_returned_domain",
        "observations_and_unrejected_model_alternatives_remain_separate",
        "unknown_prerequisites_are_not_guessed",
        "exact_domain_exhaustion_is_distinct_from_budget_reached",
        "direct_automatic_and_acceptance_phases_have_one_owner",
        "creator_oracle_does_not_enter_request",
        "caller_resumes_its_existing_contribution_pipeline"
      ],
      "falsifiers": [
        "operation_or_mode_mismatch",
        "required_input_unknown",
        "state_or_model_revision_changes",
        "work_bound_reached"
      ],
