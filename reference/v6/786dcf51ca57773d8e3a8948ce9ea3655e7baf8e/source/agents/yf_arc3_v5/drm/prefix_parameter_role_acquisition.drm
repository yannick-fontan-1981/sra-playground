      }
    },
    {
      "id": "policy.canonical_role_capture_variant",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "declared_alternative_refs": [
        "capture_variant.existing",
        "capture_variant.prefix_parameter"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "applicable",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.capture_variant.existing",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "capture_variant.existing"
            },
            {
              "field": "learning_policy_ref",
              "operator": "not_equals",
              "expected": "policy.capture_canonical_prefix_parameter_selector_appearance"
            }
          ],
          "static_facts": {
            "applicable": true
          }
        },
        {
          "id": "projection.capture_variant.prefix_parameter",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "capture_variant.prefix_parameter"
            },
            {
              "field": "learning_policy_ref",
              "operator": "equals",
              "expected": "policy.capture_canonical_prefix_parameter_selector_appearance"
            }
          ],
          "static_facts": {
            "applicable": true
          }
        }
      ],
      "premises": [
        "exact_acknowledged_effect_and_source_participant"
      ],
      "invariants": [
        "knowledge_admission_never_releases_an_action",
        "unknowns_are_preserved"
      ],
      "falsifiers": [
        "source_ack_or_causal_join_is_invalid"
      ],
      "reason_refs": [
        "reason.capture_only_the_acknowledged_parameter_participant"
      ]
    }
  ]
