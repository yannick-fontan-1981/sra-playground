            },
            {
              "field": "all_declared_bounds_supported",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "all_native_bound_refs_present",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "authorized_prefix_primitive_count_fits",
