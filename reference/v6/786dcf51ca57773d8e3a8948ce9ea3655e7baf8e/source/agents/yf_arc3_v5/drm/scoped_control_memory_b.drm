      "claim_templates": [
        {
          "id_pattern": "claim.control.application_scope.{lookup_token}",
          "predicate": "records_current_control_application_disposition",
          "family": "epistemic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "{application_ref}",
            "control.application_scope.{lookup_token}"
          ],
          "scope_bindings": {
            "parent_goal_ref": "parent_goal_ref",
