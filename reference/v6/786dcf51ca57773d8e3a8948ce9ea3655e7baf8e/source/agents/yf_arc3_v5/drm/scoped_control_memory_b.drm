      "fact_projections": [
        {
          "id": "projection.control_scope.negative_current",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "control_scope.negative_current"
            },
            {
              "field": "lookup_bindings_current",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "exact_negative_count",
              "operator": "greater_than",
              "expected": 0
            }
          ],
          "static_facts": {
            "eligible": true,
            "scope_disposition_ref": "control_scope.negative_current"
          }
        },
        {
          "id": "projection.control_scope.reopened",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "control_scope.reopened"
            },
            {
              "field": "lookup_bindings_current",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "exact_negative_count",
              "operator": "equals",
              "expected": 0
            },
            {
              "field": "newly_satisfied_count",
              "operator": "greater_than",
              "expected": 0
            }
          ],
          "static_facts": {
            "eligible": true,
            "scope_disposition_ref": "control_scope.reopened"
          }
        },
        {
          "id": "projection.control_scope.untried",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "control_scope.untried"
            },
            {
              "field": "lookup_bindings_current",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "exact_negative_count",
              "operator": "equals",
              "expected": 0
            },
            {
              "field": "newly_satisfied_count",
              "operator": "equals",
              "expected": 0
            }
          ],
          "static_facts": {
            "eligible": true,
            "scope_disposition_ref": "control_scope.untried"
          }
        },
        {
          "id": "projection.control_scope.open",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "control_scope.open"
            },
            {
              "field": "lookup_bindings_current",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "eligible": true,
            "scope_disposition_ref": "control_scope.open"
          }
        }
      ],
      "invariants": [
        "six_prerequisite_dimensions_are_current_and_bound",
        "no_global_reprobe",
        "exact_current_negative_overrides_an_older_reopening",
        "historical_negative_records_are_preserved"
      ]
    },
    {
      "id": "rule.b_scoped_control_lookup",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "reason_refs": [
