{
  "module_id": "mechanical_common_c",
  "declarations": [
    {
      "id": "policy.common_events_signature",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "premises": [
        "the_exact_request_and_current_measurement_are_supplied"
      ],
      "applicability": [
        "common_mechanical_library"
      ],
      "invariants": [
        "no_action_release",
        "preserve_unknown_bounds_and_model_alternatives",
        "explicit_empty_action_domain_is_not_missing_actions",
        "empty_action_domain_does_not_imply_goal_acceptance",
        "unknown_response_domain_never_closed_by_vacuity"
      ],
      "falsifiers": [
        "identity_or_signature_mismatch",
        "incomplete_domain"
      ],
      "selection_required_fact_fields": [
        "alternative_ref"
      ],
      "declared_alternative_refs": [
        "common.events.supported",
        "common.events.unsupported"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "applicable",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.common.events.COMPOSE",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "common.events.supported"
            },
            {
              "field": "mode",
              "operator": "equals",
              "expected": "COMPOSE"
            },
            {
              "field": "operation_ref",
              "operator": "equals",
              "expected": "mechanics.composition.event_ownership"
            },
            {
              "field": "kernel_ref",
              "operator": "equals",
              "expected": "mechanics.composition"
            },
            {
              "field": "expected_return_type",
              "operator": "equals",
              "expected": "EventCompositionResultC"
            }
          ],
          "static_facts": {
            "applicable": true,
            "supported": true
          }
        },
        {
          "id": "projection.common.events.unsupported",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "common.events.unsupported"
            }
          ],
          "static_facts": {
            "applicable": true
