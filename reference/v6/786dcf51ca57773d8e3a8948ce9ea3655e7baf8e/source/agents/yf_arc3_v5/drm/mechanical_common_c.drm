      "selection_tiers": [
        {
          "id": "tier.common.events.exact_signature",
          "all_conditions": [
            {
              "field": "supported",
              "operator": "equals",
              "expected": true
            }
          ],
          "reason_ref": "reason.common_mechanical_current_contract"
        }
      ],
      "reason_refs": [
        "reason.common_mechanical_current_contract"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.common_c_equivalent_signature_order_never_proves_meaning"
