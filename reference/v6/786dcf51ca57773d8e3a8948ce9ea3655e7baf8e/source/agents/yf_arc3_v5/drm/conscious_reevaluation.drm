        {
          "id": "projection.conscious_stop.work_bound_suspension",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "deliberation.work_bound_suspension"
            },
            {
              "field": "work_remaining",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "work_bound_reached",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "eligible": true,
            "deliberation_disposition": "work_bound_suspension"
          }
        }
      ]
    }
  ]
}
