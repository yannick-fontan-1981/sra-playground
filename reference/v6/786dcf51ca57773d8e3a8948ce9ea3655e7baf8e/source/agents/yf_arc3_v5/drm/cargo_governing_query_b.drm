{
  "module_id": "arc3.cargo_governing_query_b",
  "declarations": [
    {
      "id": "policy.b_cargo_governing_query",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason_current_terminal_goal_licenses_only_a_distinct_uncommitted_query_delta_preserving_original_authority"
