      },
      "selection_eligibility_conditions": [
        {
          "field": "eligible",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.cargo_query.bound",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cargo_query.bound"
            },
            {
              "field": "governing_query_binding_current",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "eligible": true,
            "reason_ref": "reason_current_terminal_goal_licenses_only_a_distinct_uncommitted_query_delta_preserving_original_authority",
            "no_dispatch_or_action_authority": true
          }
        },
        {
          "id": "projection.cargo_query.missing",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cargo_query.missing"
            },
            {
              "field": "governing_query_binding_current",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "eligible": true,
            "reason_ref": "reason_current_terminal_goal_licenses_only_a_distinct_uncommitted_query_delta_preserving_original_authority",
            "no_dispatch_or_action_authority": true
          }
        }
      ]
    },
    {
      "id": "rule.b_distinct_cargo_governing_query",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
