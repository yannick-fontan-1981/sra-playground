{
  "module_id": "joystick_acquisition_a",
  "declarations": [
    {
      "id": "policy.joystick_acquisition_a",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.joystick_acquisition_from_actual_observations",
        "reason.joystick_observed_acquisition_unknown"
      ],
      "declared_alternative_refs": [
        "joystick_acquisition_a.current",
        "joystick_acquisition_a.unknown"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.joystick_acquisition_equivalent_observed_support",
      "selection_tiers": [
        {
          "id": "tier.joystick_acq.mask",
          "reason_ref": "reason.joystick_acquisition_from_actual_observations",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "joystick_acquisition_a.current"
            },
            {
              "field": "acquisition_complete",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "owner_bindings_current",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.joystick_acq.unknown",
          "reason_ref": "reason.joystick_observed_acquisition_unknown",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "joystick_acquisition_a.unknown"
            }
          ]
        }
      ],
      "meaning_template_ref_by_alternative": {
        "joystick_acquisition_a.current": "rule.joystick_acquired_observation_a"
      },
      "configuration": {}
    },
    {
