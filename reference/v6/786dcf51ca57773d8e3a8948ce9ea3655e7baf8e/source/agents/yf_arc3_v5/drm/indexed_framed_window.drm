{
  "module_id":"indexed_framed_window",
  "declarations":[
    {
      "id":"policy.current_indexed_window_probe_presence","kind":"selection_policy",
      "evaluation":"declared_eligibility_single","supported_operators":["SELECT"],
      "input_contract":"yf_arc3_v5.authority_input.selection.v1",
      "output_contract":"yf_arc3_v5.authority_output.selection.v1",
      "selection_eligibility_conditions":[
        {"field":"active_goal_ref","operator":"equals","expected":"goal.qualify_literal_framed_correspondence"},
        {"field":"indexed_window_action_eligible","operator":"equals","expected":true}
      ],
      "reason_refs":["reason.new_current_window_evidence_requires_fresh_probe_projection_before_a_saved_exploration_order"]
    },
    {
      "id":"principle.sealed_packet_acquisition_requires_current_epoch_and_complete_domain",
      "kind":"principle",
      "invariants":["one_source_owned_sealed_packet","no_action_between_internal_images",
        "same_context_epoch","one_exact_window_in_the_measured_indexed_domain",
        "acquisition_is_not_active_view_or_acceptance"],
      "falsifiers":["incomplete_selector_domain","inconsistent_indexed_rasters","changed_reference_patch"],
      "reason_refs":["reason.sealed_packet_acquisition_precedes_active_view_proposal"]
    },
    {
      "id":"policy.indexed_framed_window_acquisition","kind":"selection_policy",
      "evaluation":"declared_lexicographic_order","supported_operators":["SELECT"],
      "input_contract":"yf_arc3_v5.authority_input.selection.v1",
      "output_contract":"yf_arc3_v5.authority_output.selection.v1",
      "declared_alternative_refs":["packet.indexed_framed_window","packet.no_qualified_window"],
      "fact_projections":[
        {"id":"projection.packet.indexed_literal_window",
          "all_conditions":[
            {"field":"alternative_ref","operator":"equals","expected":"packet.indexed_framed_window"},
            {"field":"packet_same_context_epoch","operator":"equals","expected":true},
            {"field":"framed_packet_pair_count","operator":"equals","expected":1},
            {"field":"framed_packet_exact_match_count","operator":"equals","expected":1},
            {"field":"framed_packet_comparison_domain_complete","operator":"equals","expected":true},
            {"field":"uniform_support_ordinal_coverage_complete","operator":"equals","expected":true}
          ],
          "static_facts":{"acquisition_kind":"indexed_framed_literal_window","applicable":true,
            "acceptance_law_established":false,"point_control_law_established":false}},
        {"id":"projection.packet.no_qualified_window",
          "all_conditions":[{"field":"alternative_ref","operator":"equals","expected":"packet.no_qualified_window"}],
          "static_facts":{"applicable":true,"acquisition_kind":"unqualified_packet"}}
      ],
      "selection_tiers":[
        {"id":"tier.complete_indexed_literal_evidence",
          "all_conditions":[{"field":"acquisition_kind","operator":"equals","expected":"indexed_framed_literal_window"}],
          "reason_ref":"reason.scoped_packet_has_one_literal_window_in_a_complete_indexed_domain"},
        {"id":"tier.preserve_unqualified_acquisition",
          "all_conditions":[{"field":"acquisition_kind","operator":"equals","expected":"unqualified_packet"}],
          "reason_ref":"reason.incomplete_or_ambiguous_packet_cannot_bind_a_window"}
      ],
      "selection_tie_breakers":[{"field":"acquisition_kind","preferred_order":"minimize"}],
      "meaning_template_ref_by_alternative":{"packet.indexed_framed_window":"rule.observed_indexed_framed_window"},
      "reason_refs":["reason.scoped_packet_has_one_literal_window_in_a_complete_indexed_domain"]
    },
    {
      "id":"rule.observed_indexed_framed_window","kind":"rule",
      "evaluation":"project_requested_conclusions","supported_operators":["DERIVE"],
      "input_contract":"yf_arc3_v5.authority_input.derivation.v1",
      "output_contract":"yf_arc3_v5.authority_output.derivation.v1","relation_family":"dynamic",
      "premises":["one_current_stable_framed_patch","one_indexed_varying_domain","complete_literal_comparison"],
      "invariants":["observed_photo_is_not_the_active_photo","exact_pixels_include_background",
        "literal_match_is_not_acceptance_law","new_epoch_requires_revalidation"],
      "falsifiers":["changed_reference_patch","incompatible_selector_support","proposal_is_rejected"],
      "term_templates":[{
        "id_pattern":"event.indexed_framed_window.{context_epoch}.{framed_packet_geometry_token}",
        "kind":"event","label":"observed indexed exact window awaiting active-view proposal",
        "required_fields":["context_epoch","framed_packet_geometry_token","fixed_patch_bbox","fixed_patch_rows",
          "varying_patch_bbox","uniform_support_bboxes","matching_marker_ordinal","matching_window_bbox","comparison_evidence_ref"],
        "static_attributes":{"projection_contract":"yf_arc3_v5.indexed_framed_window.v1",
          "commitment":"revisable","acceptance_law_established":false,"point_control_law_established":false},
        "attribute_bindings":{"context_epoch":"context_epoch","framed_packet_geometry_token":"framed_packet_geometry_token",
          "fixed_patch_bbox":"fixed_patch_bbox","fixed_patch_rows":"fixed_patch_rows","varying_patch_bbox":"varying_patch_bbox",
          "uniform_support_bboxes":"uniform_support_bboxes","matching_marker_ordinal":"matching_marker_ordinal",
          "matching_window_bbox":"matching_window_bbox","comparison_evidence_ref":"comparison_evidence_ref"}
      }],
      "claim_templates":[{
        "id_pattern":"claim.indexed_literal_window.{context_epoch}.{framed_packet_geometry_token}",
        "predicate":"observed_indexed_exact_framed_window","family":"dynamic","epistemic_status":"supported",
        "argument_patterns":["event.indexed_framed_window.{context_epoch}.{framed_packet_geometry_token}"],
        "required_fields":["context_epoch","framed_packet_geometry_token"],
        "static_attributes":{"acceptance_law_established":false}
      }],
      "reason_refs":["reason.scoped_packet_has_one_literal_window_in_a_complete_indexed_domain"]
    }
  ]
}
