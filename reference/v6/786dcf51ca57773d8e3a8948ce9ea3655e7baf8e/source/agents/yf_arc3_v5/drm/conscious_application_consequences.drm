{
  "module_id": "conscious_application_consequences",
  "declarations": [
    {
      "id": "policy.conscious_application_consequences",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.compare_predicted_relations_to_the_declared_goal_without_inventing_success"
      ],
      "invariants": [
        "all_predicted_and_uncalculated_candidates_preserved",
        "no_target_immobility_inferred_from_its_name",
        "unknown_preservation_is_not_safety",
        "missing_target_is_not_a_wildcard",
        "all_unresolved_target_candidates_remain_represented",
        "a_means_origin_goal_is_not_the_owner_of_every_future_application",
        "current_goal_owned_relations_take_precedence_over_historical_participants",
        "ambiguous_or_contradicted_current_bindings_never_fall_back_to_the_origin_goal",
        "conditional_local_relation_is_not_observed_level_completion",
        "responsibility_for_an_experiment_does_not_establish_a_possible_goal_benefit",
        "possible_benefit_requires_a_goal_owned_conditional_contribution_reason",
        "no_candidate_ranking_or_action_release"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "eligible",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.conscious_application_consequences.unknown",
          "all_conditions": [],
          "static_facts": {
            "eligible": true,
            "possible_beneficiary_declared": false,
            "comparison_goal_bound": false,
            "requirement_declared": false,
            "conditional_relation_satisfied": null,
            "relative_progress_predicted": null,
            "relative_regression_predicted": null,
            "consequence_disposition_ref": "consequence.goal_requirement_unbound",
            "question_ref": "question.which_exact_relation_or_state_does_this_goal_require",
            "preservation_status_ref": "preservation.unverified",
            "action_release_authorized": false,
            "observed_goal_achievement": false
          }
        },
        {
          "id": "projection.conscious_application_consequences.same_goal_legacy_binding",
          "all_conditions": [
            {"field": "goal_relation_evidence_present", "operator": "equals", "expected": false},
            {"field": "mechanism_goal_matches", "operator": "equals", "expected": true}
          ],
          "static_facts": {
            "comparison_goal_bound": true,
            "comparison_binding_basis_ref": "binding.original_means_and_current_goal_are_identical"
          }
        },
        {
          "id": "projection.conscious_application_consequences.current_goal_owned_binding",
          "all_conditions": [
            {"field": "current_goal_binding_qualified", "operator": "equals", "expected": true}
          ],
          "static_facts": {
            "comparison_goal_bound": true,
            "comparison_binding_basis_ref": "binding.current_goal_owned_relation_independent_of_means_origin"
          },
          "bound_facts": {
            "subject_ref": "current_goal_subject_ref",
            "target_ref": "current_goal_target_ref",
            "distinct_participants_bound": "current_goal_distinct_participants_bound",
            "alignment_axis": "current_goal_alignment_axis",
            "current_gaps_twice": "current_goal_current_gaps_twice",
            "predicted_gaps_twice": "current_goal_predicted_gaps_twice",
            "current_and_predicted_pair_bound": "current_goal_current_and_predicted_pair_bound",
            "compared_target_bound": "current_goal_compared_target_bound",
            "declared_target_matches": "current_goal_declared_target_matches",
            "symbolic_shape_pair_bound": "current_goal_symbolic_shape_pair_bound",
            "symbolic_appearance_pair_bound": "current_goal_symbolic_appearance_pair_bound",
            "observed_symbolic_states": "current_goal_observed_symbolic_states",
            "predicted_symbolic_states": "current_goal_predicted_symbolic_states",
            "shape_equal_current": "current_goal_shape_equal_current",
            "shape_equal_predicted": "current_goal_shape_equal_predicted",
            "appearance_equal_current": "current_goal_appearance_equal_current",
            "appearance_equal_predicted": "current_goal_appearance_equal_predicted",
            "row_equal_predicted": "current_goal_row_equal_predicted",
            "row_gap_smaller": "current_goal_row_gap_smaller",
            "row_gap_larger": "current_goal_row_gap_larger",
            "column_equal_predicted": "current_goal_column_equal_predicted",
            "column_gap_smaller": "current_goal_column_gap_smaller",
            "column_gap_larger": "current_goal_column_gap_larger",
            "both_equal_predicted": "current_goal_both_equal_predicted",
            "both_gaps_no_larger": "current_goal_both_gaps_no_larger",
            "at_least_one_gap_smaller": "current_goal_at_least_one_gap_smaller"
          }
        },
        {
          "id": "projection.conscious_application_consequences.goal_owned_target_declaration",
          "all_conditions": [
            {"field": "current_goal_binding_qualified", "operator": "equals", "expected": true},
            {"field": "target_declaration_well_formed", "operator": "equals", "expected": true},
            {"field": "target_domain_declared", "operator": "equals", "expected": false}
          ],
          "static_facts": {
            "target_domain_declared": true,
            "target_binding_ambiguous": false,
            "declared_target_matches": true
