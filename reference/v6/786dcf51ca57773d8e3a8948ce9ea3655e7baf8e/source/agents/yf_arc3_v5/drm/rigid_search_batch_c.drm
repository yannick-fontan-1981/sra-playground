          {"field":"all_native_complete","operator":"equals","expected":true},
          {"field":"all_native_statuses_complete","operator":"equals","expected":true},
          {"field":"all_packets_present","operator":"equals","expected":true},
          {"field":"all_packet_identities_equal","operator":"equals","expected":true},
