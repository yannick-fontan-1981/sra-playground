          {"field":"first_incomplete_native_cause","operator":"equals","expected":"TIME_BOUND"}],
          "static_facts":{"applicable":true,"case_ref":"rigid_batch.budget"}},
        {"id":"projection.rigid_batch.retain_native","all_conditions":[
