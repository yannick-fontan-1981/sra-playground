          "static_facts":{"applicable":true,"case_ref":"rigid_batch.retain"}}
      ],
      "selection_tiers":[
        {"id":"tier.rigid_batch.append","all_conditions":[{"field":"case_ref","operator":"equals","expected":"rigid_batch.append"}],"reason_ref":"reason.rigid_batch.every_current_response_boundary_is_complete"},
        {"id":"tier.rigid_batch.native_budget","all_conditions":[{"field":"case_ref","operator":"equals","expected":"rigid_batch.budget"}],"reason_ref":"reason.rigid_batch.actual_work_bound_is_not_impossibility"},
        {"id":"tier.rigid_batch.native_retain","all_conditions":[{"field":"case_ref","operator":"equals","expected":"rigid_batch.retain"}],"reason_ref":"reason.rigid_batch.unknown_current_binding_is_retained"}
      ],
      "selection_tie_breakers":[{"field":"alternative_ref","preferred_order":"minimize"}],
      "canonical_equivalence_tie_break_debt_ref":"debt.rigid_batch.reference_order_is_not_model_or_action_equivalence",
      "reason_refs":["reason.rigid_batch.every_current_response_boundary_is_complete","reason.rigid_batch.actual_work_bound_is_not_impossibility","reason.rigid_batch.unknown_current_binding_is_retained"]
    }
