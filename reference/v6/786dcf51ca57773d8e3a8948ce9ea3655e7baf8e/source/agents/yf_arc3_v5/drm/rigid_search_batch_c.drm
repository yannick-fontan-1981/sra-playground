{
  "module_id":"rigid_search_batch_c",
  "declarations":[
    {
      "id":"principle.rigid_search_batch.fixed_model_not_per_node_reasoning",
      "kind":"principle",
      "premises":["Source_has_admitted_one_current_deterministic_rigid_model_and_its_laws", "the_query_explicitly_requests_bounded_pure_mathematical_batching"],
      "applicability":["counterfactual_K09_STEP_evaluation_without_environment_control"],
      "invariants":["no_second_search_or_physics_engine", "no_symbolic_role_or_strategy_choice_per_node", "each_state_rebind_checks_scope_fields_focus_hit_payload_and_digest", "each_D_kernel_rechecks_signature_admission_whole_mask_collision_checkpoints_and_native_work_bounds", "each_C_packet_rechecks_identity_cost_schema_and_before_snapshot", "K03_and_K09_independently_reconcile_each_current_packet", "Source_adopts_or_retains_the_aggregate", "no_standalone_reasoning_contribution_consumption_is_fabricated_per_counterfactual_node", "ordinary_WHY_action_scope_and_permit_validation_remain_independent", "legacy_protocol_remains_default"],
      "falsifiers":["a_state_dependent_guard_is_only_checked_once", "profile_model_or_scope_changes", "any_native_response_is_partial", "a_math_packet_is_used_as_physical_action_authority"],
      "reason_refs":["reason.rigid_batch.fixed_law_allows_repeated_pure_evaluation_not_repeated_meaning_selection"]
    },
    {
      "id":"policy.rigid_search_batch_admission_c",
      "kind":"selection_policy","evaluation":"declared_lexicographic_order","supported_operators":["SELECT"],
      "input_contract":"yf_arc3_v5.authority_input.selection.v1","output_contract":"yf_arc3_v5.authority_output.selection.v1",
      "premises":["the_actual_query_and_every_current_row_binding_are_measured"],
      "applicability":["source_selected_fixed_rigid_batch"],
      "invariants":["unknown_bindings_never_license_math_adoption","no_source_or_action_authority_from_the_kernel"],
      "falsifiers":["binding_revision_or_declared_work_bound_fails"],
      "declared_alternative_refs":["rigid_batch.compute","rigid_batch.legacy","rigid_batch.retain","rigid_batch.budget"],
      "selection_required_fact_fields":["alternative_ref"],
      "selection_eligibility_conditions":[{"field":"applicable","operator":"equals","expected":true}],
      "fact_projections":[
        {"id":"projection.rigid_batch.compute","all_conditions":[
          {"field":"alternative_ref","operator":"equals","expected":"rigid_batch.compute"},
          {"field":"source_opt_in","operator":"equals","expected":true},
          {"field":"fixed_rigid_provider","operator":"equals","expected":true},
          {"field":"source_opt_in_bound","operator":"equals","expected":true},
          {"field":"profile_ref","operator":"equals","expected":"solving.rigid_rearrangement"},
          {"field":"native_type_ref","operator":"equals","expected":"RigidEditPrimitiveRequestD"},
          {"field":"native_operation_ref","operator":"equals","expected":"mechanics.editable_configuration_graph.rigid_edit_external_primitive"},
          {"field":"native_mode_ref","operator":"equals","expected":"STEP"},
          {"field":"native_phase_ref","operator":"equals","expected":"EXTERNAL_COMMAND"},
          {"field":"requested_row_count","operator":"greater_than","expected":0},
          {"field":"all_rows_bound","operator":"equals","expected":true},
          {"field":"missing_binding_count","operator":"equals","expected":0},
          {"field":"step_budget_remaining","operator":"equals","expected":true},
          {"field":"native_node_bound_within_limit","operator":"equals","expected":true}],
          "static_facts":{"applicable":true,"case_ref":"rigid_batch.compute"}},
        {"id":"projection.rigid_batch.step_budget","all_conditions":[
          {"field":"alternative_ref","operator":"equals","expected":"rigid_batch.budget"},
          {"field":"source_opt_in","operator":"equals","expected":true},
          {"field":"fixed_rigid_provider","operator":"equals","expected":true},
          {"field":"step_budget_remaining","operator":"equals","expected":false}],
          "static_facts":{"applicable":true,"case_ref":"rigid_batch.budget"}},
        {"id":"projection.rigid_batch.node_budget","all_conditions":[
          {"field":"alternative_ref","operator":"equals","expected":"rigid_batch.budget"},
          {"field":"source_opt_in","operator":"equals","expected":true},
          {"field":"fixed_rigid_provider","operator":"equals","expected":true},
          {"field":"native_node_bound_within_limit","operator":"equals","expected":false}],
          "static_facts":{"applicable":true,"case_ref":"rigid_batch.budget"}},
        {"id":"projection.rigid_batch.default_legacy","all_conditions":[
          {"field":"alternative_ref","operator":"equals","expected":"rigid_batch.legacy"},
          {"field":"source_opt_in","operator":"equals","expected":false}],
          "static_facts":{"applicable":true,"case_ref":"rigid_batch.legacy"}},
        {"id":"projection.rigid_batch.other_provider_legacy","all_conditions":[
          {"field":"alternative_ref","operator":"equals","expected":"rigid_batch.legacy"},
          {"field":"fixed_rigid_provider","operator":"equals","expected":false}],
          "static_facts":{"applicable":true,"case_ref":"rigid_batch.legacy"}},
        {"id":"projection.rigid_batch.retain_bindings","all_conditions":[
          {"field":"alternative_ref","operator":"equals","expected":"rigid_batch.retain"}],
          "static_facts":{"applicable":true,"case_ref":"rigid_batch.retain"}}
      ],
      "selection_tiers":[
        {"id":"tier.rigid_batch.compute","all_conditions":[{"field":"case_ref","operator":"equals","expected":"rigid_batch.compute"}],"reason_ref":"reason.rigid_batch.fixed_law_allows_repeated_pure_evaluation_not_repeated_meaning_selection"},
        {"id":"tier.rigid_batch.budget","all_conditions":[{"field":"case_ref","operator":"equals","expected":"rigid_batch.budget"}],"reason_ref":"reason.rigid_batch.actual_work_bound_is_not_impossibility"},
        {"id":"tier.rigid_batch.legacy","all_conditions":[{"field":"case_ref","operator":"equals","expected":"rigid_batch.legacy"}],"reason_ref":"reason.rigid_batch.default_protocol_is_preserved"},
        {"id":"tier.rigid_batch.retain","all_conditions":[{"field":"case_ref","operator":"equals","expected":"rigid_batch.retain"}],"reason_ref":"reason.rigid_batch.unknown_current_binding_is_retained"}
      ],
      "selection_tie_breakers":[{"field":"alternative_ref","preferred_order":"minimize"}],
      "canonical_equivalence_tie_break_debt_ref":"debt.rigid_batch.reference_order_is_not_model_or_action_equivalence",
      "reason_refs":["reason.rigid_batch.fixed_law_allows_repeated_pure_evaluation_not_repeated_meaning_selection","reason.rigid_batch.actual_work_bound_is_not_impossibility","reason.rigid_batch.default_protocol_is_preserved","reason.rigid_batch.unknown_current_binding_is_retained"]
    },
    {
      "id":"policy.rigid_search_batch_completion_c",
      "kind":"selection_policy","evaluation":"declared_lexicographic_order","supported_operators":["SELECT"],
