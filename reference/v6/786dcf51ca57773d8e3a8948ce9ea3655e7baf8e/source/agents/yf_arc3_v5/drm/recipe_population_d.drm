{
  "module_id": "arc3.recipe_population_d",
  "declarations": [
    {
      "id": "policy.recipe_population_d", "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order", "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": ["reason.recipe_requested_populations_acquired", "reason.recipe_population_proof_missing"],
      "declared_alternative_refs": ["recipe_population.publish_complete", "recipe_population.unknown"],
      "selection_tie_breakers": [{"field": "alternative_ref", "preferred_order": "minimize"}],
      "canonical_equivalence_tie_break_debt_ref": "debt.recipe_population_equivalent_domain",
      "selection_tiers": [
        {"id": "tier.recipe_population.complete", "reason_ref": "reason.recipe_requested_populations_acquired",
         "all_conditions": [
           {"field": "alternative_ref", "operator": "equals", "expected": "recipe_population.publish_complete"},
           {"field": "requested_populations_acquired", "operator": "equals", "expected": true}
         ]},
        {"id": "tier.recipe_population.unknown", "reason_ref": "reason.recipe_population_proof_missing",
         "all_conditions": [{"field": "alternative_ref", "operator": "equals", "expected": "recipe_population.unknown"}]}
      ],
      "meaning_template_ref_by_alternative": {"recipe_population.publish_complete": "rule.recipe_acquired_populations_d"},
      "configuration": {"input_predicate_ref": "qualifies_acquired_recipe_input_population",
                        "world_predicate_ref": "qualifies_acquired_recipe_requested_world_population"}
    },
    {
      "id": "rule.recipe_acquired_populations_d", "kind": "rule",
      "evaluation": "project_requested_conclusions", "supported_operators": ["DERIVE"],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic", "reason_refs": ["reason.recipe_requested_populations_acquired"],
      "invariants": ["catalogue_geometry_not_input_role", "current_source_role_proof_required",
                     "world_closure_only_parent_requested_domain", "scalar_values_acquired_separately", "no_action_authority"],
      "claim_templates": [
        {
          "id_pattern": "{input_population_claim_ref}", "predicate": "qualifies_acquired_recipe_input_population",
          "family": "epistemic", "epistemic_status": "supported",
          "argument_patterns": ["{input_lattice_ref}", "{observation_record_ref}"],
          "required_term_patterns": ["{input_lattice_ref}"],
          "required_fields": ["input_population_claim_ref", "input_lattice_ref", "observation_record_ref", "input_members", "population_digest"],
          "attribute_bindings": {"members": "input_members", "population_digest": "population_digest",
                                 "acquisition_provenance": "acquisition_provenance"},
          "static_attributes": {"population_complete": true, "no_action_authority": true},
          "scope_bindings": {
            "frame_ref": "frame_ref", "raw_input_ref": "raw_input_ref", "timeline_ref": "timeline_ref",
            "observation_record_ref": "observation_record_ref", "parent_goal_ref": "parent_goal_ref",
            "parent_contribution_ref": "parent_contribution_ref", "consumer_ref": "consumer_ref", "caller_ref": "caller_ref",
            "scope_ref": "scope_ref", "episode_ref": "episode_ref", "level_scope_ref": "level_scope_ref", "epoch": "epoch",
            "input_revision_ref": "input_revision_ref", "evidence_revision_ref": "evidence_revision_ref",
            "model_revision_ref": "model_revision_ref", "event_owner_ref": "event_owner_ref"
          }
        },
        {
          "id_pattern": "{world_population_claim_ref}", "predicate": "qualifies_acquired_recipe_requested_world_population",
          "family": "epistemic", "epistemic_status": "supported",
          "argument_patterns": ["{world_lattice_ref}", "{observation_record_ref}"],
          "required_term_patterns": ["{world_lattice_ref}"],
          "required_fields": ["world_population_claim_ref", "world_lattice_ref", "observation_record_ref", "world_members", "population_digest"],
          "attribute_bindings": {"members": "world_members", "population_digest": "population_digest",
                                 "acquisition_provenance": "acquisition_provenance"},
          "static_attributes": {"population_complete": true, "universal_world_closure": false, "no_action_authority": true},
          "scope_bindings": {
            "frame_ref": "frame_ref", "raw_input_ref": "raw_input_ref", "timeline_ref": "timeline_ref",
            "observation_record_ref": "observation_record_ref", "parent_goal_ref": "parent_goal_ref",
            "parent_contribution_ref": "parent_contribution_ref", "consumer_ref": "consumer_ref", "caller_ref": "caller_ref",
            "scope_ref": "scope_ref", "episode_ref": "episode_ref", "level_scope_ref": "level_scope_ref", "epoch": "epoch",
            "input_revision_ref": "input_revision_ref", "evidence_revision_ref": "evidence_revision_ref",
            "model_revision_ref": "model_revision_ref", "event_owner_ref": "event_owner_ref"
          }
        }
      ]
    }
  ]
}
