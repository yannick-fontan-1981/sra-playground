    {
      "id": "rule.loaded_tool_instance_model_meaning",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "control",
      "premises": [
        "model_instance_ref",
        "tool_signature_ref",
        "mandatory_part_refs",
        "model_observation_origin_refs"
      ],
      "applicability": [
        "source_selected_current_scoped_instance_inventory"
      ],
      "invariants": [
        "membership_proposal_does_not_confirm_attachment",
        "missing_masks_remain_declared_members",
        "subgoal_change_is_not_release_evidence"
      ],
      "falsifiers": [
        "fresh_observation_or_causal_entry_withdrawal_event_refutes_model"
      ],
      "reason_refs": [
        "reason.current_instance_snapshot_preserves_members"
      ],
      "term_templates": [
        {
          "id_pattern": "{model_instance_ref}",
          "kind": "entity",
          "label": "conditional tool and load instance inventory",
