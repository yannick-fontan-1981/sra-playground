{
  "module_id": "loaded_tool_model",
  "declarations": [
    {
      "id": "policy.loaded_tool_instance_model_inventory",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "premises": [
        "canonical_instance_membership_survives_instrumental_goal_changes"
      ],
      "applicability": [
        "before_parent_step_and_path_influence_prediction"
      ],
      "invariants": [
        "missing_current_mask_does_not_remove_membership",
        "axis_overlap_is_possible_load_never_confirmed_attachment",
        "inventory_completeness_is_not_whole_physics_completeness"
      ],
      "falsifiers": [
        "retained_member_has_no_unique_current_footprint",
        "attachment_or_release_event_contradicts_instance_membership"
      ],
      "configuration": {
        "measurement_contract": {
          "model_predicate": "loaded_tool_instance_model",
          "pose_claim_predicate": "piercing_target_scene_hypothesis",
          "control_query_attribute": "role",
          "control_query_value": "cursor_supposition",
          "support_model_predicate": "piercing_observed_model_revision"
        }
      },
      "selection_eligibility_conditions": [
        {
          "field": "applicable",
          "operator": "equals",
          "expected": true
        }
      ],
      "selection_tiers": [
        {
          "id": "tier.loaded_tool.current_scoped_snapshot",
          "all_conditions": [],
          "reason_ref": "reason.current_instance_snapshot_preserves_members"
        }
      ],
      "selection_tie_breakers": [
        {
          "field": "snapshot_admission_rank",
          "preferred_order": "maximize",
          "criterion_ref": "criterion.loaded_tool.admitted_snapshot_precedes_initial",
          "reason_ref": "reason.current_instance_snapshot_preserves_members"
        },
        {
          "field": "prior_model_revision",
          "preferred_order": "maximize",
          "criterion_ref": "criterion.loaded_tool.latest_source_revision",
          "reason_ref": "reason.newer_source_snapshot_retains_reconciled_members"
        }
      ],
      "reason_refs": [
        "reason.current_instance_snapshot_preserves_members"
      ],
      "meaning_template_ref_by_alternative": {
        "*": "rule.loaded_tool_instance_model_meaning"
      },
