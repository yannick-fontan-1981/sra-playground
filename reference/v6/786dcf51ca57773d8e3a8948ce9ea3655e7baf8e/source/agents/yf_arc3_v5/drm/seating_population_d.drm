{
  "module_id": "arc3.seating_population_d",
  "declarations": [
    {
      "id": "policy.seating_requested_population_d", "kind": "selection_policy",
      "evaluation": "declared_eligibility_single", "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": ["reason.current_parent_requests_exact_acquired_member_population"],
      "configuration": {"population_predicate_ref": "qualifies_acquired_requested_seating_population",
        "catalogue_predicate_ref": "qualifies_acquired_seating_member_catalogue",
        "source_kind_ref": "seating.acquired_requested_population.v1"},
      "declared_alternative_refs": ["seating_population.publish", "seating_population.unknown"],
      "selection_eligibility_conditions": [{"field": "eligible", "operator": "equals", "expected": true}],
      "fact_projections": [
        {"id": "projection.seating_population.publish", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "seating_population.publish"},
          {"field": "requested_member_population_complete", "operator": "equals", "expected": true},
          {"field": "parent_condition_kind_ref", "operator": "equals", "expected": "condition.injective_typed_seating_conjunction"}
        ], "static_facts": {"eligible": true}},
        {"id": "projection.seating_population.unknown.missing", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "seating_population.unknown"},
          {"field": "requested_member_population_complete", "operator": "equals", "expected": false}
        ], "static_facts": {"eligible": true}},
        {"id": "projection.seating_population.unknown.kind", "all_conditions": [
          {"field": "alternative_ref", "operator": "equals", "expected": "seating_population.unknown"},
          {"field": "parent_condition_kind_ref", "operator": "not_equals", "expected": "condition.injective_typed_seating_conjunction"}
        ], "static_facts": {"eligible": true}}
      ],
      "meaning_template_ref_by_alternative": {"seating_population.publish": "rule.seating_requested_population_d"},
      "invariants": ["requested_domain_from_current_instrumental_parent", "every_requested_body_type_alive_is_acquired",
        "never_remove_dead_member", "explicit_empty_not_missing", "original_role_and_law_status_preserved",
        "no_universal_world_population", "no_action_authority"]
    },
    {
      "id": "rule.seating_requested_population_d", "kind": "rule",
      "evaluation": "project_requested_conclusions", "supported_operators": ["DERIVE"],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic", "reason_refs": ["reason.current_parent_requests_exact_acquired_member_population"],
      "term_templates": [{
        "id_pattern": "{catalogue_term_ref}", "kind": "value", "label": "Current acquired requested seating members",
        "required_fields": ["catalogue_term_ref", "value", "binding_digest", "frame_ref", "observation_record_ref"],
        "attribute_bindings": {"value": "value", "binding_digest": "binding_digest", "frame_ref": "frame_ref",
          "raw_input_ref": "raw_input_ref", "observation_record_ref": "observation_record_ref",
          "field_provenance": "field_provenance", "field_provenance_digest": "field_provenance_digest"},
        "static_attributes": {"source_kind_ref": "seating.acquired_requested_population.v1",
          "universal_world_closure": false, "physical_control_confirmed": false,
          "original_role_status_preserved_in_provenance": true}
      }],
      "claim_templates": [
        {
          "id_pattern": "{population_claim_ref}", "predicate": "qualifies_acquired_requested_seating_population",
          "family": "epistemic", "epistemic_status": "supported",
          "argument_patterns": ["{population_scope_ref}", "{observation_record_ref}"],
          "required_fields": ["population_claim_ref", "population_scope_ref", "members", "field_provenance_digest"],
          "attribute_bindings": {"members": "members", "field_provenance_digest": "field_provenance_digest"},
          "scope_bindings": {"frame_ref": "frame_ref", "raw_input_ref": "raw_input_ref", "timeline_ref": "timeline_ref",
            "observation_record_ref": "observation_record_ref", "parent_goal_ref": "parent_goal_ref",
            "parent_contribution_ref": "parent_contribution_ref", "consumer_ref": "consumer_ref", "caller_ref": "caller_ref",
            "scope_ref": "scope_ref", "episode_ref": "episode_ref", "level_scope_ref": "level_scope_ref", "epoch": "epoch",
            "input_revision_ref": "input_revision_ref", "evidence_revision_ref": "evidence_revision_ref",
            "model_revision_ref": "model_revision_ref", "event_owner_ref": "event_owner_ref"},
          "static_attributes": {"population_complete": true, "universal_world_closure": false,
            "no_action_authority": true, "no_physical_goal_confirmation": true}
        },
        {
          "id_pattern": "{catalogue_support_claim_ref}", "predicate": "qualifies_acquired_seating_member_catalogue",
          "family": "epistemic", "epistemic_status": "supported",
          "argument_patterns": ["{catalogue_term_ref}", "{observation_record_ref}"],
          "required_term_patterns": ["{catalogue_term_ref}"],
          "required_fields": ["catalogue_support_claim_ref", "catalogue_term_ref", "binding_digest"],
          "attribute_bindings": {"binding_digest": "binding_digest", "field_provenance_digest": "field_provenance_digest"},
          "scope_bindings": {"frame_ref": "frame_ref", "raw_input_ref": "raw_input_ref", "timeline_ref": "timeline_ref",
            "observation_record_ref": "observation_record_ref", "parent_goal_ref": "parent_goal_ref",
            "parent_contribution_ref": "parent_contribution_ref", "consumer_ref": "consumer_ref", "caller_ref": "caller_ref",
            "scope_ref": "scope_ref", "episode_ref": "episode_ref", "level_scope_ref": "level_scope_ref", "epoch": "epoch",
            "input_revision_ref": "input_revision_ref", "evidence_revision_ref": "evidence_revision_ref",
            "model_revision_ref": "model_revision_ref", "event_owner_ref": "event_owner_ref"},
          "static_attributes": {"no_action_authority": true, "no_physical_goal_confirmation": true}
        }
      ]
    }
  ]
}
