          "field": "eligible",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.cargo_memory.correspondence",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cargo_memory.correspondence"
            },
            {
              "field": "recalled_correspondence_domain_current",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "eligible": true,
            "reason_ref": "reason_recalled_content_and_current_canonical_fields_can_propose_correspondence_without_confirming_applicability_or_use",
            "current_applicability_not_confirmed": true,
            "actual_use_not_proved": true,
            "no_dispatch_or_action_authority": true
          }
        },
        {
          "id": "projection.cargo_memory.missing",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cargo_memory.missing"
            },
            {
              "field": "recalled_correspondence_domain_current",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "eligible": true,
            "reason_ref": "reason_recalled_content_and_current_canonical_fields_can_propose_correspondence_without_confirming_applicability_or_use",
            "current_applicability_not_confirmed": true,
            "actual_use_not_proved": true,
            "no_dispatch_or_action_authority": true
          }
        }
      ]
    },
    {
