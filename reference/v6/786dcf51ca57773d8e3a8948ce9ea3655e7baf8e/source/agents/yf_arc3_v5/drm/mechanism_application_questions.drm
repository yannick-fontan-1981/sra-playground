{
  "module_id": "mechanism_application_questions",
  "declarations": [
    {
      "id": "policy.conscious_native_recovery_evidence",
      "kind": "selection_policy", "evaluation": "declared_eligibility_single",
      "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "declared_alternative_refs": ["native_recovery.observed_return_domain"],
      "configuration": {"recovery_budget_endpoint_mode": "all_declared_endpoint_predicates_true"},
      "selection_eligibility_conditions": [{"field": "eligible", "operator": "equals", "expected": true}],
      "reason_refs": ["reason.observed_return_is_a_recovery_candidate_not_a_future_cost_guarantee"],
      "invariants": ["retain_matching_return_alternatives_and_conflicts", "no_observed_path_is_not_proven_impossibility", "no_future_zero_cost_from_missing_evidence", "no_action_authority"],
      "fact_projections": [
        {"id": "projection.native_recovery.default", "all_conditions": [], "static_facts": {
          "eligible": true, "recovery_status": "needs_current_native_review", "future_recovery_established": false,
          "cost_review_status": "unqualified_conditional_costs",
          "conditional_cost_admission_supported": false,
          "conditional_admission_upper_bound": null, "conditional_admission_scope_ref": null,
          "conditional_admission_scope_digest": null, "conditional_admission_unknown_outside_cost_refs": [],
          "next_evidence_refs": ["recovery.current_native_review_and_control_binding"]}},
        {"id": "projection.native_recovery.incomplete", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true}
        ], "static_facts": {"recovery_status": "observed_domain_incomplete",
          "next_evidence_refs": ["recovery.complete_observation_domain", "recovery.current_conditional_route_model", "recovery.current_route_preservation_and_cost"]}},
        {"id": "projection.native_recovery.no_return", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true},
          {"field": "observation_domain_complete", "operator": "equals", "expected": true},
          {"field": "observed_return_count", "operator": "equals", "expected": 0}
        ], "static_facts": {"recovery_status": "no_return_in_reviewed_observations",
          "next_evidence_refs": ["recovery.return_mechanism_or_alternative_means", "recovery.current_route_preservation_and_cost"]}},
        {"id": "projection.native_recovery.unchanged_projection", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true},
          {"field": "observed_unchanged_projection_count", "operator": "greater_than", "expected": 0}
        ], "static_facts": {"recovery_status": "observed_projection_unchanged_requires_current_model_qualification",
          "next_evidence_refs": ["recovery.projected_state_sufficient_for_transition", "recovery.future_outcomes_covered_by_observed_relation", "recovery.current_route_preservation_and_cost"]}},
        {"id": "projection.native_recovery.return", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true},
          {"field": "observation_domain_complete", "operator": "equals", "expected": true},
          {"field": "observed_return_count", "operator": "greater_than", "expected": 0}
        ], "static_facts": {"recovery_status": "observed_return_requires_current_route_qualification",
          "next_evidence_refs": ["recovery.current_conditional_route_model", "recovery.current_route_controls", "recovery.current_route_preservation_and_cost"]}},
        {"id": "projection.native_recovery.conflicts", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true},
          {"field": "conflicting_query_count", "operator": "greater_than", "expected": 0}
        ], "static_facts": {"recovery_status": "conflicting_observed_outcomes",
          "next_evidence_refs": ["recovery.discriminate_conflicting_outcomes", "recovery.current_conditional_route_model", "recovery.current_route_controls", "recovery.current_route_preservation_and_cost"]}},
        {"id": "projection.native_recovery.conditional_policy", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true},
          {"field": "conditional_return_model_count", "operator": "greater_than", "expected": 0}
        ], "static_facts": {"recovery_status": "conditional_return_policy_requires_current_model_qualification",
          "next_evidence_refs": ["recovery.projected_state_sufficient_for_transition", "recovery.future_outcomes_covered_by_observed_relation", "recovery.current_route_controls", "recovery.current_route_preservation_and_cost"]}},
        {"id": "projection.native_recovery.cost_incomplete", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true},
          {"field": "retained_recovery_models_complete", "operator": "equals", "expected": true}
        ], "static_facts": {"cost_review_status": "conditional_cost_or_funding_still_incomplete"}},
        {"id": "projection.native_recovery.cost_funded", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true},
          {"field": "conditional_recovery_models_all_funded", "operator": "equals", "expected": true}
        ], "static_facts": {"cost_review_status": "funded_under_all_retained_models"}},
        {"id": "projection.native_recovery.cost_shortfall", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true},
          {"field": "conditional_recovery_model_bounds_all_exceed_budget", "operator": "equals", "expected": true}
        ], "static_facts": {"cost_review_status": "no_retained_model_guarantees_a_funded_return"}},
        {"id": "projection.native_recovery.cost_model_disagreement", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true},
          {"field": "conditional_recovery_models_disagree_on_budget", "operator": "equals", "expected": true}
        ], "static_facts": {"cost_review_status": "funding_depends_on_recovery_model"}},
        {"id": "projection.native_recovery.cost_resource_ambiguity", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true},
          {"field": "conditional_recovery_resource_models_ambiguous", "operator": "equals", "expected": true}
        ], "static_facts": {"cost_review_status": "funding_depends_on_resource_model"}},
        {"id": "projection.native_recovery.cost_combined_ambiguity", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true},
          {"field": "conditional_recovery_models_disagree_on_budget", "operator": "equals", "expected": true},
          {"field": "conditional_recovery_resource_models_ambiguous", "operator": "equals", "expected": true}
        ], "static_facts": {"cost_review_status": "funding_depends_on_recovery_and_resource_models"}},
        {"id": "projection.native_recovery.known_component_shortfall", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true},
          {"field": "known_trial_component_cost_exceeds_budget", "operator": "equals", "expected": true}
        ], "static_facts": {"cost_review_status": "known_required_trial_cost_exceeds_available_budget"}},
        {"id": "projection.native_recovery.funded_scoped_restoration", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true},
          {"field": "scoped_restoration_complete", "operator": "equals", "expected": true},
          {"field": "scoped_restoration_fits_budgets", "operator": "equals", "expected": true},
          {"field": "scoped_restoration_known_outside_cost_positive", "operator": "equals", "expected": false}
        ], "static_facts": {
          "conditional_cost_admission_supported": true,
          "conditional_cost_admission_reason_ref": "reason.bound_the_complete_restoration_of_the_declared_projection_without_claiming_world_recovery",
          "conditional_admission_scope_ref": "recovery.cost_scope.recorded_joint_projection",
          "cost_review_status": "funded_scoped_restoration_with_outside_cost_debt",
          "actual_future_cost_established": false, "grants_action": false
        }, "bound_facts": {
          "conditional_admission_upper_bound": "scoped_restoration_upper_bound",
          "conditional_admission_scope_digest": "scoped_restoration_cost_digest",
          "conditional_admission_unknown_outside_cost_refs": "scoped_restoration_unknown_outside_cost_refs"
        }},
        {"id": "projection.native_recovery.funded_preserving_conditional_admission", "all_conditions": [
          {"field": "native_review_current", "operator": "equals", "expected": true},
          {"field": "nomination_bound", "operator": "equals", "expected": true},
          {"field": "retained_recovery_models_complete", "operator": "equals", "expected": true},
          {"field": "conditional_recovery_costs_include_progress", "operator": "equals", "expected": true},
          {"field": "conditional_recovery_models_all_funded", "operator": "equals", "expected": true},
          {"field": "conditional_recovery_models_fit_solver_bound", "operator": "equals", "expected": true},
          {"field": "conditional_recovery_losses_zero", "operator": "equals", "expected": true}
        ], "static_facts": {
          "conditional_cost_admission_supported": true,
          "conditional_cost_admission_reason_ref": "reason.complete_retained_recovery_bounds_fit_resources_and_preserve_irreversible_stocks",
          "conditional_admission_scope_ref": "recovery.cost_scope.declared_loss_components",
          "conditional_admission_unknown_outside_cost_refs": [],
          "cost_review_status": "funded_under_all_retained_models",
          "actual_future_cost_established": false,
          "grants_action": false}, "bound_facts": {
          "conditional_admission_upper_bound": "conditional_global_upper_bound",
          "conditional_admission_scope_digest": "conditional_cost_envelope_digest"
        }}
      ]
    },
    {
      "id": "policy.conscious_native_response_question",
      "kind": "selection_policy", "evaluation": "declared_eligibility_single",
      "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "declared_alternative_refs": ["native_question.scoped_response_availability"],
      "selection_eligibility_conditions": [{"field": "eligible", "operator": "equals", "expected": true}],
      "configuration": {"maximum_observation_records": 128},
      "reason_refs": ["reason.response_availability_is_distinct_from_a_proven_causal_law"],
      "invariants": ["only_the_declared_scoped_question_is_examined", "source_open_question_is_not_global_ignorance", "bounded_incomplete_review_is_not_absence", "retain_competing_responses", "no_action_authority"],
      "fact_projections": [
        {"id": "projection.native_question.default", "all_conditions": [], "static_facts": {
          "eligible": true, "question_currently_unanswered": null, "response_status": "needs_requalification", "proves_causal_law": false}},
        {"id": "projection.native_question.open", "all_conditions": [
          {"field": "producer_current", "operator": "equals", "expected": true},
          {"field": "source_question_open", "operator": "equals", "expected": true},
          {"field": "observation_domain_complete", "operator": "equals", "expected": true},
          {"field": "available_response_count", "operator": "equals", "expected": 0},
          {"field": "unqualified_response_count", "operator": "equals", "expected": 0}
        ], "static_facts": {"question_currently_unanswered": true, "response_status": "source_question_still_requires_response"}},
        {"id": "projection.native_question.observed", "all_conditions": [
          {"field": "producer_current", "operator": "equals", "expected": true},
          {"field": "observation_domain_complete", "operator": "equals", "expected": true},
          {"field": "available_response_count", "operator": "greater_than", "expected": 0},
          {"field": "distinct_response_count", "operator": "equals", "expected": 1}
        ], "static_facts": {"question_currently_unanswered": false, "response_status": "matching_observed_response_available"}},
        {"id": "projection.native_question.competing", "all_conditions": [
          {"field": "producer_current", "operator": "equals", "expected": true},
          {"field": "observation_domain_complete", "operator": "equals", "expected": true},
          {"field": "distinct_response_count", "operator": "greater_than", "expected": 1}
        ], "static_facts": {"question_currently_unanswered": null, "response_status": "competing_observed_responses"}}
      ]
    },
    {
      "id": "policy.conscious_native_preparation_evidence",
      "kind": "selection_policy", "evaluation": "declared_eligibility_single",
      "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": ["reason.reuse_current_source_preparation_without_inventing_future_effects"],
      "configuration": {"response_uncertainty_condition_refs": ["condition.effect_not_yet_observed"]},
      "declared_alternative_refs": ["native_preparation.current_evidence"],
      "selection_eligibility_conditions": [{"field": "eligible", "operator": "equals", "expected": true}],
      "invariants": ["missing_premises_are_not_satisfied", "conditional_viability_is_not_complete_preservation", "unknown_response_belongs_to_the_exact_acquisition_question", "declared_constraints_do_not_exhaust_world_preservation", "empty_declared_constraint_conjunction_does_not_establish_world_safety", "no_cost_or_recovery_claim", "no_action_authority"],
      "fact_projections": [
        {"id": "projection.native_preparation.default", "all_conditions": [],
         "static_facts": {"eligible": true, "preconditions_current": false, "protected_conditions_current": false, "source_conditions_ready": false, "preservation_scope_ref": "preservation.declared_preparation_constraints", "world_preservation_established": false, "response_established": false, "grants_action": false}},
        {"id": "projection.native_preparation.current_premises", "all_conditions": [
          {"field": "producer_current", "operator": "equals", "expected": true},
          {"field": "control_bound", "operator": "equals", "expected": true},
          {"field": "premise_count", "operator": "greater_than", "expected": 0},
          {"field": "invalid_premise_count", "operator": "equals", "expected": 0}
        ], "static_facts": {"preconditions_current": true}},
        {"id": "projection.native_preparation.viable_source_conditions", "all_conditions": [
          {"field": "source_viability_current", "operator": "equals", "expected": true},
          {"field": "source_viability_status", "operator": "equals", "expected": "viable"},
          {"field": "source_unresolved_count", "operator": "equals", "expected": 0},
          {"field": "source_missing_evidence_count", "operator": "equals", "expected": 0}
        ], "static_facts": {"source_conditions_ready": true}},
        {"id": "projection.native_preparation.question_owned_response_uncertainty", "all_conditions": [
          {"field": "source_viability_current", "operator": "equals", "expected": true},
          {"field": "source_viability_status", "operator": "equals", "expected": "conditional"},
          {"field": "response_question_bound", "operator": "equals", "expected": true},
          {"field": "response_uncertainty_count", "operator": "greater_than", "expected": 0},
          {"field": "other_unresolved_condition_count", "operator": "equals", "expected": 0},
          {"field": "source_missing_evidence_count", "operator": "equals", "expected": 0}
        ], "static_facts": {"source_conditions_ready": true}},
        {"id": "projection.native_preparation.complete_source_preservation", "all_conditions": [
          {"field": "preconditions_current", "operator": "equals", "expected": true},
          {"field": "source_conditions_ready", "operator": "equals", "expected": true},
          {"field": "uncovered_constraint_count", "operator": "equals", "expected": 0},
          {"field": "violated_constraint_count", "operator": "equals", "expected": 0}
        ], "static_facts": {"protected_conditions_current": true}}
      ]
    },
{
  "id": "policy.conscious_native_continuation_review",
  "kind": "selection_policy",
  "evaluation": "declared_eligibility_single",
  "supported_operators": [
    "SELECT"
  ],
  "input_contract": "yf_arc3_v5.authority_input.selection.v1",
  "output_contract": "yf_arc3_v5.authority_output.selection.v1",
  "declared_alternative_refs": [
    "continuation_review.current_source_selection"
  ],
  "selection_eligibility_conditions": [
    {
      "field": "eligible",
      "operator": "equals",
      "expected": true
    }
  ],
  "reason_refs": [
    "reason.examine_current_source_means_without_claiming_global_infeasibility"
  ],
  "configuration": {
    "maximum_engagement_members": 512,
    "continuation_boolean_fields": [
      "declared_complete_plan_present",
      "committed_verified_repetition",
      "declared_complete_series_authorized",
      "declared_conditional_series_authorized"
    ],
    "continuation_reference_fields": [
      "committed_plan_ref",
      "declared_plan_ref"
    ]
  },
  "invariants": [
    "a_declared_plan_requires_local_revalidation_not_automatic_exploration",
    "absence_is_limited_to_the_exact_current_source_candidate_domain",
    "an_opportunity_does_not_prove_discovery_necessary",
    "no_action_authority"
  ],
  "fact_projections": [
    {
      "id": "projection.native_continuation.default",
      "all_conditions": [],
      "static_facts": {
        "eligible": true,
        "understanding_timing": "not_examined",
        "continuation_review": "not_examined",
        "incoming_engagement_disposition_ref": "engagement.not_examined",
        "incoming_engagement_reason_ref": null,
        "incoming_engagement_resume_condition_ref": null,
        "principal_goal_preserved": true,
        "requires_prior_continuation_revalidation": false,
        "grants_action": false
      }
    },
    {
      "id": "projection.native_continuation.declared_means",
      "all_conditions": [
        {
          "field": "selection_domain_current",
          "operator": "equals",
          "expected": true
        },
        {
          "field": "nonexcluded_marked_candidate_count",
          "operator": "greater_than",
          "expected": 0
        }
      ],
      "static_facts": {
        "continuation_review": "continuation_requires_revalidation",
        "requires_prior_continuation_revalidation": true
      }
    },
    {
      "id": "projection.native_continuation.engaged",
      "all_conditions": [
        {
          "field": "selection_domain_current",
          "operator": "equals",
          "expected": true
        },
        {
          "field": "incoming_engagement_present",
          "operator": "equals",
          "expected": true
        },
        {
          "field": "incoming_engagement_consumption_proved",
          "operator": "equals",
          "expected": false
        }
      ],
      "static_facts": {
        "continuation_review": "continuation_requires_revalidation",
        "requires_prior_continuation_revalidation": true
      }
    },
    {
      "id": "projection.native_continuation.suspend_unexamined_premises",
      "all_conditions": [
        {
          "field": "selection_domain_current",
          "operator": "equals",
          "expected": true
        },
        {
          "field": "incoming_engagement_present",
          "operator": "equals",
          "expected": true
        },
        {
          "field": "incoming_engagement_consumption_proved",
          "operator": "equals",
          "expected": false
        },
        {
          "field": "incoming_dependency_domain_complete",
          "operator": "equals",
          "expected": false
        }
      ],
      "static_facts": {
        "continuation_review": "continuation_requires_revalidation",
        "requires_prior_continuation_revalidation": true,
        "incoming_engagement_disposition_ref": "engagement.suspended_unexamined_premises",
        "incoming_engagement_reason_ref": "reason.requalify_unexamined_premises_before_reusing_engagement",
        "incoming_engagement_resume_condition_ref": "condition.named_dependencies_changed_then_current_continuation_requalified",
        "principal_goal_preserved": true
      }
    },
    {
      "id": "projection.native_continuation.suspend_missing_premises",
      "all_conditions": [
        {
          "field": "selection_domain_current",
          "operator": "equals",
          "expected": true
        },
        {
          "field": "incoming_engagement_present",
          "operator": "equals",
          "expected": true
        },
        {
          "field": "incoming_engagement_consumption_proved",
          "operator": "equals",
          "expected": false
        },
        {
          "field": "incoming_missing_premise_count",
          "operator": "greater_than",
          "expected": 0
        }
      ],
      "static_facts": {
        "continuation_review": "continuation_requires_revalidation",
        "requires_prior_continuation_revalidation": true,
        "incoming_engagement_disposition_ref": "engagement.suspended_missing_premises",
        "incoming_engagement_reason_ref": "reason.requalify_missing_premises_before_reusing_engagement",
        "incoming_engagement_resume_condition_ref": "condition.named_dependencies_changed_then_current_continuation_requalified",
        "principal_goal_preserved": true
      }
    },
    {
      "id": "projection.native_continuation.suspend_expired_premises",
      "all_conditions": [
