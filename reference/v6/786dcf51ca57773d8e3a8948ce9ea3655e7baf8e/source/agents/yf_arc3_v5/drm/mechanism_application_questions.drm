        "symbolic_observation_fields": ["observed_value", "relative_shape_digest", "pixel_area"],
        "maximum_symbolic_transition_edges": 64,
        "recovery_observation_fields": ["bounds", "observed_value", "relative_shape_digest", "pixel_area"],
