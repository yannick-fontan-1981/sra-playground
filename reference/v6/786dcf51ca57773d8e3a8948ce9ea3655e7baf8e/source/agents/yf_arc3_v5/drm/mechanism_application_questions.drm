      ],
      "static_facts": {
        "continuation_review": "continuation_requires_revalidation",
        "requires_prior_continuation_revalidation": true,
        "incoming_engagement_disposition_ref": "engagement.suspended_expired_premises",
        "incoming_engagement_reason_ref": "reason.requalify_expired_premises_before_reusing_engagement",
        "incoming_engagement_resume_condition_ref": "condition.named_dependencies_changed_then_current_continuation_requalified",
        "principal_goal_preserved": true
      }
    },
    {
      "id": "projection.native_continuation.suspend_inactive_premises",
      "all_conditions": [
        {
          "field": "selection_domain_current",
          "operator": "equals",
          "expected": true
        },
        {
          "field": "incoming_engagement_present",
          "operator": "equals",
          "expected": true
        },
        {
          "field": "incoming_engagement_consumption_proved",
          "operator": "equals",
          "expected": false
        },
        {
          "field": "incoming_inactive_premise_count",
          "operator": "greater_than",
          "expected": 0
        }
      ],
      "static_facts": {
        "continuation_review": "continuation_requires_revalidation",
        "requires_prior_continuation_revalidation": true,
        "incoming_engagement_disposition_ref": "engagement.suspended_inactive_premises",
        "incoming_engagement_reason_ref": "reason.requalify_inactive_premises_before_reusing_engagement",
        "incoming_engagement_resume_condition_ref": "condition.named_dependencies_changed_then_current_continuation_requalified",
        "principal_goal_preserved": true
      }
    },
    {
      "id": "projection.native_continuation.suspend_contested_premises",
      "all_conditions": [
        {
          "field": "selection_domain_current",
          "operator": "equals",
          "expected": true
        },
        {
          "field": "incoming_engagement_present",
          "operator": "equals",
          "expected": true
        },
        {
          "field": "incoming_engagement_consumption_proved",
          "operator": "equals",
          "expected": false
        },
        {
          "field": "incoming_contested_premise_count",
          "operator": "greater_than",
          "expected": 0
        }
      ],
      "static_facts": {
