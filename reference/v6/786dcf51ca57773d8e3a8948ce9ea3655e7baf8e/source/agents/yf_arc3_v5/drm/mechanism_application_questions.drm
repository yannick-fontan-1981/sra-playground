          "marker_compartment": {
            "subject_attribute": "moving_entity_ref", "field_refs": ["marker_compartment"]
          },
          "material_quantity_vector": {
            "subject_attribute": "moving_entity_ref", "field_refs": ["material_quantity_vector"]
          },
          "marker_visual_identity": {
            "subject_attribute": "moving_entity_ref",
            "field_refs": ["observed_value", "relative_shape_digest"]
          },
          "bounds": {"subject_attribute": "moving_entity_ref", "field_refs": ["bounds"]},
          "observed_value": {"subject_attribute": "moving_entity_ref", "field_refs": ["observed_value"]},
          "relative_shape_digest": {"subject_attribute": "moving_entity_ref", "field_refs": ["relative_shape_digest"]},
          "pixel_area": {"subject_attribute": "moving_entity_ref", "field_refs": ["pixel_area"]}
        },
        "maximum_observed_inverse_pairs": 4096,
        "maximum_symbolic_prediction_variants": 256,
        "experiment_nomination_required": true,
        "late_experiment_control_required": true,
        "current_control_binding_predicates": ["current_control_binding"],
        "maximum_current_control_bindings": 64,
        "participant_measurement_workflow_refs": ["arc3.track_scene.track_scene", "arc3.answer_acquired_resource_request_a.answer_acquired_resource_request_a"],
        "native_acquisition_required": true,
        "native_acquisition_fields": ["bounds", "observed_value", "relative_shape_digest", "pixel_area"],
        "maximum_native_acquisition_fields": 256,
        "open_response_falsifier_refs": [
          "falsifier.prior_action_context_or_observation_binding_changed",
          "falsifier.declared_response_fields_not_observable"
        ],
        "addressed_control_attributes": ["actuator_entity_ref", "addressed_control_ref", "control_ref"],
        "participant_reference_attributes": [
          "actuator_entity_ref",
          "moving_entity_ref",
          "fixed_entity_ref",
          "full_entity_ref",
          "derived_entity_ref",
          "carrier_entity_ref",
          "moving_support_ref",
          "terminal_support_ref",
          "negative_support_ref",
          "positive_support_ref",
          "contributor_entity_refs",
          "active_contributor_entity_ref",
          "connector_entity_ref",
          "source_entity_ref",
          "destination_entity_ref"
