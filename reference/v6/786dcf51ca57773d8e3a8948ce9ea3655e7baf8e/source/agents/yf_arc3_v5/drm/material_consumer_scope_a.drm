        {
          "id": "tier.material_consumer.current",
          "reason_ref": "reason.material_current_explicit_goal_consumer_scope",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "material_consumer_scope_a.current"
            },
            {
              "field": "consumer_scope_current",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.material_consumer.unknown",
          "reason_ref": "reason.material_consumer_scope_missing",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "material_consumer_scope_a.unknown"
            }
          ]
        }
      ],
