    },
    {
      "id": "principle.optimistic_replanning_preserves_hidden_barriers_and_temporal_unknowns",
      "kind": "principle",
      "premises": [
        "a_current_canonical_control_occurrence_and_rectangular_domain_are_measured",
        "a_stopped_attempt_exposes_a_new_uniform_contact_texture"
      ],
      "invariants": [
        "Unknown cells may be admitted only as an exploration hypothesis. Retain revealed barriers when visibility fades; revise them after contradictory occupancy. A mobile occurrence is not a permanent wall. Each attempt or bounded wait returns to the same parent with a full observation. Never declare terminal success or complete reaction safety from this optimistic path."
      ],
      "falsifiers": [
        "successful_control_occupancy_contradicts_a_blocking_cell",
        "the_role_or_domain_is_ambiguous"
      ],
      "reason_refs": [
        "reason.current_revisable_map_supports_bounded_optimistic_route"
      ]
    }
  ]
}
