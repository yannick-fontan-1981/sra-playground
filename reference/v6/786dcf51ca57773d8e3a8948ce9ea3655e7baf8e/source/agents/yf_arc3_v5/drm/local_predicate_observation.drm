    {
      "id": "principle.partial_local_counterexample_requires_current_prediction_revalidation",
      "kind": "principle",
      "premises": [
        "an_actual_response_has_a_canonical_partial_endpoint_predicate_observation",
        "a_current_Source_receipt_revalidates_role_pose_input_model_content_and_known_local_support",
        "the_same_positive_translation_prediction_has_an_observed_counterexample"
      ],
      "invariants": [
        "preserve_the_occurrence_after_goal_wrapper_or_pose_changes",
        "unknown_phase_is_not_known_equal_between_occurrences",
        "do_not_promote_endpoints_to_a_complete_trajectory",
        "reconsider_this_route_means_without_global_input_sterility_or_permanent_wall",
        "preserve_distinct_effects_and_conditionally_reopen_on_changed_support_or_bounded_temporal_question"
      ],
      "falsifiers": [
        "the_role_is_ambiguous_or_the_measurement_unknown",
        "current_support_model_or_relevant_condition_differs",
        "a_Source_admitted_bounded_temporal_condition_experiment_asks_a_distinct_question"
      ],
      "reason_refs": [
        "reason.partial_counterexample_requires_prediction_revalidation"
      ]
    },
    {
      "kind": "principle",
      "id": "principle.partial_counterexample_limits_provisional_word_to_observation_frontier",
      "premises": [
        "current_Source_revalidation_preserves_a_partial_counterexample_and_unbound_conditions",
        "a_provisional_word_does_not_discharge_its_future_edge_support_obligations"
      ],
      "invariants": [
        "retain_the_proposed_word_as_a_revisable_hypothesis",
        "authorize_at_most_its_first_information_frontier_then_return_to_Source",
        "do_not_repeat_a_currently_refuted_first_edge_without_a_distinct_bounded_condition_question",
        "do_not_mark_the_goal_reached_when_the_truncated_prefix_ends"
      ],
      "falsifiers": [
        "the_complete_word_has_an_independently_admitted_complete_transition_model",
        "the_current_counterexample_receipt_or_role_support_is_not_current"
      ],
      "reason_refs": [
        "reason.partial_route_suffix_requires_actual_support_before_release"
      ]
    },
    {
      "kind": "selection_policy",
