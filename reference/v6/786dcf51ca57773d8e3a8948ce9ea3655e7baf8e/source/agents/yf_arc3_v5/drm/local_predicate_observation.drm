        "claim_id_prefix": "claim.revisable_navigation_observation.",
        "maximum_cells": 256,
        "maximum_route_depth": 256,
        "barrier_projection": "NEW_UNIFORM_STOPPING_CONTACT_TEXTURE",
        "unknown_terrain_admission": "OPTIMISTIC_EXPERIMENT_NOT_ESTABLISHED_FREE",
        "goal_projection": "UNIQUE_STATIONARY_FRAMED_ENDPOINT_AFTER_MOVING_PEER_CONTRAST",
        "disappearing_barrier_observation": "RETAIN_UNTIL_PHYSICAL_COUNTEREVIDENCE",
        "mobile_obstacle_admission": "OBSERVE_ONE_NONCHECKPOINT_TICK_THEN_REPLAN",
        "wait_on_observed_mobile_track": "PREFER_ALTERNATE_BFS"
      },
      "meaning_template_ref_by_alternative": {
        "revisable_navigation.retain_current_map": "rule.revisable_navigation_observation"
      },
      "reason_refs": [
        "reason.current_revisable_map_supports_bounded_optimistic_route"
      ],
