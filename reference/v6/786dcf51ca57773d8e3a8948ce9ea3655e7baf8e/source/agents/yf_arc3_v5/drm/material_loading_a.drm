{
  "module_id": "material_loading_a",
  "declarations": [
    {
      "id": "policy.material_loading_a",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.material_current_whole_operand_preparation",
        "reason.material_loading_missing"
      ],
      "declared_alternative_refs": [
        "material_loading_a.current",
        "material_loading_a.unknown"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.material_loading_equivalent",
      "selection_tiers": [
        {
          "id": "tier.material_consumer.current",
          "reason_ref": "reason.material_current_whole_operand_preparation",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "material_loading_a.current"
            },
            {
              "field": "preparation_current",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.material_consumer.unknown",
          "reason_ref": "reason.material_loading_missing",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "material_loading_a.unknown"
            }
          ]
        }
      ],
      "meaning_template_ref_by_alternative": {
        "material_loading_a.current": "rule.material_loading_a"
      },
      "configuration": {}
    },
    {
      "id": "rule.material_loading_a",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "reason_refs": [
        "reason.material_current_whole_operand_preparation"
      ],
      "invariants": [
        "source_selected_financed_means",
        "all_operands_measured_together",
        "retain_already_loaded_operands",
        "future_layout_must_bind_each_primitive",
        "no_action_authority"
      ],
      "term_templates": [
        {
          "id_pattern": "value.material.loading_preparation.{request_ref}",
          "kind": "value",
          "label": "Whole operand preparation for current financed production step",
          "required_fields": [
            "request_ref",
            "parent_goal_ref",
            "consumer_ref",
            "next_item_ref",
            "epoch",
            "evidence_revision_ref",
            "model_revision_ref",
            "frame_ref",
            "why_digest",
            "payload",
            "payload_digest"
          ],
          "attribute_bindings": {
            "request_ref": "request_ref",
            "parent_goal_ref": "parent_goal_ref",
            "consumer_ref": "consumer_ref",
            "next_item_ref": "next_item_ref",
            "epoch": "epoch",
            "evidence_revision_ref": "evidence_revision_ref",
            "model_revision_ref": "model_revision_ref",
            "frame_ref": "frame_ref",
            "why_digest": "why_digest",
            "payload": "payload",
            "payload_digest": "payload_digest"
          },
          "static_attributes": {
            "source_kind_ref": "material.concurrent_loading_preparation.v1",
            "all_holders_must_be_ready_before_commit": true,
            "future_click_payloads_require_current_layout": true,
            "primitive_series_bound": false,
            "action_release_authorized": false
          }
        }
      ],
      "claim_templates": [
        {
          "id_pattern": "claim.material.loading_preparation.{request_ref}",
          "predicate": "qualifies_material_concurrent_loading_preparation",
          "family": "epistemic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "value.material.loading_preparation.{request_ref}",
            "{parent_goal_ref}"
          ],
          "required_term_patterns": [
            "value.material.loading_preparation.{request_ref}"
          ],
          "required_fields": [
            "request_ref",
            "parent_goal_ref",
            "consumer_ref",
            "next_item_ref",
            "epoch",
            "evidence_revision_ref",
            "model_revision_ref",
            "frame_ref",
            "why_digest",
            "payload",
            "payload_digest"
          ],
          "scope_bindings": {
            "epoch": "epoch",
