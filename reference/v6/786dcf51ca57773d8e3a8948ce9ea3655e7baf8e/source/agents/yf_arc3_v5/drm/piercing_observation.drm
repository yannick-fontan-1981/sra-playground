      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "premises": [
        "generic_rooted_tool_conditional_contact_and_support_alternatives"
      ],
      "applicability": [
        "before_observed_outcomes_select_or_falsify_a_model"
      ],
      "invariants": [
        "models_are_competing_predictions_never_established_physical_laws",
        "declared_partition_completeness_does_not_certify_whole_physics"
      ],
      "falsifiers": [
        "a_later_sealed_observation_contradicts_the_retained_model"
      ],
      "configuration": {
        "measurement_contract": {
          "model_field": "conditional_models",
          "model_predicate": "piercing_observed_model_revision",
          "independent_model_refs": [
            "model.piercing.axial_entry_independent",
            "model.piercing.free_push_coupling"
