    {
      "id": "principle.parent_dependency_question_preserves_root",
      "kind": "principle",
      "evaluation": "declarative_only",
      "supported_operators": [],
      "premises": [
        "an_engaged_source_parent_has_an_unresolved_declared_dependency"
      ],
      "applicability": [
        "a_source_child_returns_parent_revalidation_request"
      ],
      "invariants": [
        "preserve_parent_and_unfinished_dependency_edges",
        "name_a_missing_condition_without_asserting_its_truth",
        "an_unknown_answer_map_never_authorizes_act"
      ],
      "falsifiers": [
        "the_proposed_probe_does_not_change_the_named_dependency_condition"
      ],
      "reason_refs": [
        "reason.parent_dependency_condition_remains_open"
      ]
    },
    {
      "id": "policy.parent_observed_condition_answer",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": ["SELECT"],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "declared_alternative_refs": ["parent.observed_condition_answer"],
      "meaning_template_ref_by_alternative": {"*": "rule.parent_question_answer_lifecycle"},
      "selection_eligibility_conditions": [{"field": "applicable", "operator": "equals", "expected": true}],
      "invariants": ["prediction_is_not_observation", "answer_requires_exact_subjects_and_observed_action", "answer_never_grants_act", "condition_truth_does_not_complete_parent_goal"],
      "configuration": {
        "observation_contract": {
          "target_binding_predicate_ref": "goal_target_binding",
          "target_binding_candidates_field_ref": "candidate_target_refs",
          "active_disposition_ref": "active", "positive_polarity_ref": "positive",
          "epistemic_status_refs": ["supported", "established"],
          "successful_operation_status_ref": "completed",
          "scope_field_refs": {"game_ref": "game_ref", "level_ref": "level_ref", "session_ref": "session_ref"},
          "positive_partition_ref": "support_preserved", "negative_partition_ref": "support_removed",
          "models": [
            {"condition_ref": "condition.contact.retains_required_support", "predicate_ref": "piercing_observed_model_revision",
             "target_field_ref": "piece_ref", "receiver_field_ref": "rod_ref", "parent_field_ref": "retained_parent_goal_ref",
             "class_field_ref": "observation_class_ref", "class_refs": ["observation.entry_and_transport_support_discriminated", "observation.controlled_relative_transport_support_discriminated"],
             "principle_refs": ["principle.oriented_protrusion_boundary_crossing_is_discriminating"],
             "pair_field_ref": "support_known_pairs", "evidence_partition_ref": "support_preserved"},
            {"condition_ref": "condition.withdrawal.preserves_required_support", "predicate_ref": "piercing_observed_model_revision",
             "target_field_ref": "piece_ref", "receiver_field_ref": "rod_ref", "parent_field_ref": "retained_parent_goal_ref",
             "class_field_ref": "observation_class_ref", "class_refs": ["observation.controlled_relative_transport_support_discriminated"],
             "principle_refs": ["principle.geometric_retraction_does_not_undo_observed_dependency"],
             "pair_field_ref": "support_known_pairs", "evidence_partition_ref": "support_preserved"},
            {"condition_ref": "condition.withdrawal.preserves_required_support", "predicate_ref": "piercing_observed_model_revision",
             "target_field_ref": "piece_ref", "receiver_field_ref": "rod_ref", "parent_field_ref": "retained_parent_goal_ref",
             "class_field_ref": "observation_class_ref", "class_refs": ["observation.withdrawal_release_discriminated"],
             "principle_refs": ["principle.geometric_retraction_does_not_undo_observed_dependency"],
             "pair_field_ref": "support_independent_pairs", "evidence_partition_ref": "support_removed"}
          ]
        },
        "information_goal_contract": {"lifecycle_predicate_ref": "goal_lifecycle_status"},
        "target_binding_contract": {"predicate_ref": "goal_target_binding", "candidate_refs_field": "candidate_target_refs",
          "active_disposition_ref": "active", "positive_polarity_ref": "positive", "epistemic_status_refs": ["supported", "established"]}
      },
      "fact_projections": [
        {"id": "projection.parent_answer.unknown", "all_conditions": [],
         "static_facts": {"applicable": true, "answer_truth_ref": "unknown", "answer_consumption_accepted": false, "answer_grants_act": false, "answer_supports_continuation": false, "answer_refutes_continuation": false, "answer_conflicting": false, "answer_information_goal_update_allowed": false, "answer_information_goal_status": "pursuing", "answer_disposition_ref": "answer.current_evidence_incomplete"}},
        {"id": "projection.parent_answer.exact_information_goal", "all_conditions": [
          {"field": "question_goal_is_distinct_information_goal", "operator": "equals", "expected": true}],
         "static_facts": {"answer_information_goal_update_allowed": true}},
        {"id": "projection.parent_answer.satisfied", "all_conditions": [
          {"field": "question_origin_count", "operator": "greater_than", "expected": 0},
          {"field": "question_subject_origin_qualified", "operator": "equals", "expected": true},
          {"field": "positive_evidence_count", "operator": "greater_than", "expected": 0},
          {"field": "negative_evidence_count", "operator": "equals", "expected": 0},
          {"field": "contradictory_evidence_count", "operator": "equals", "expected": 0}],
         "static_facts": {"answer_truth_ref": "satisfied", "answer_consumption_accepted": true, "answer_supports_continuation": true, "answer_information_goal_status": "locally_satisfied", "answer_disposition_ref": "answer.observed_condition_satisfied"}},
        {"id": "projection.parent_answer.refuted", "all_conditions": [
          {"field": "question_origin_count", "operator": "greater_than", "expected": 0},
          {"field": "question_subject_origin_qualified", "operator": "equals", "expected": true},
          {"field": "negative_evidence_count", "operator": "greater_than", "expected": 0},
          {"field": "positive_evidence_count", "operator": "equals", "expected": 0},
          {"field": "contradictory_evidence_count", "operator": "equals", "expected": 0}],
         "static_facts": {"answer_truth_ref": "refuted", "answer_consumption_accepted": true, "answer_supports_continuation": false, "answer_refutes_continuation": true, "answer_information_goal_status": "locally_satisfied", "answer_disposition_ref": "answer.observed_condition_refuted"}},
        {"id": "projection.parent_answer.conflicting_partitions", "all_conditions": [
          {"field": "positive_evidence_count", "operator": "greater_than", "expected": 0},
          {"field": "negative_evidence_count", "operator": "greater_than", "expected": 0}],
         "static_facts": {"answer_truth_ref": "contradictory", "answer_consumption_accepted": false, "answer_supports_continuation": false, "answer_conflicting": true, "answer_information_goal_status": "pursuing", "answer_disposition_ref": "answer.conflicting_current_evidence"}},
        {"id": "projection.parent_answer.contradicted_claim", "all_conditions": [
          {"field": "contradictory_evidence_count", "operator": "greater_than", "expected": 0}],
         "static_facts": {"answer_truth_ref": "contradictory", "answer_consumption_accepted": false, "answer_supports_continuation": false, "answer_conflicting": true, "answer_information_goal_status": "pursuing", "answer_disposition_ref": "answer.conflicting_current_evidence"}}
      ],
      "reason_refs": ["reason.consume_observed_condition_without_completing_parent"]
    },
    {
      "id": "rule.parent_question_answer_lifecycle",
      "kind": "rule", "evaluation": "project_requested_conclusions", "supported_operators": ["DERIVE"],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "control",
      "invariants": ["answering_information_goal_never_completes_physical_dependency_or_parent", "unknown_or_conflicting_answer_keeps_information_goal_open"],
      "claim_templates": [{
        "id_pattern": "claim.question_answer.{consumption_receipt_ref}.{version_slot_ref}",
        "predicate": "goal_lifecycle_status", "family": "control", "epistemic_status": "supported",
        "argument_patterns": ["{question_goal_ref}", "{answer_information_goal_status}"],
        "required_fields": ["question_goal_ref", "consumption_receipt_ref", "version_slot_ref"],
        "all_conditions": [{"field": "answer_information_goal_update_allowed", "operator": "equals", "expected": true}],
        "iteration": {"source_field": "question_lifecycle_targets", "max_items": 4096,
          "item_bindings": {"prior_status_ref": "prior_status_ref", "version_slot_ref": "version_slot_ref", "status_history_refs": "status_history_refs"}},
        "attribute_bindings": {
          "lifecycle_status": "answer_information_goal_status", "question_ref": "question_ref",
          "condition_ref": "condition_ref", "condition_truth": "answer_truth_ref",
          "parent_goal_ref": "parent_goal_ref", "dependency_goal_ref": "dependency_goal_ref",
          "consumption_receipt_ref": "consumption_receipt_ref", "question_product_ref": "question_product_ref",
          "superseded_lifecycle_claim_ref": "prior_status_ref", "status_history_refs": "status_history_refs"
        }
      }],
      "reason_refs": ["reason.return_answered_information_child_without_assuming_parent_success"]
    },
