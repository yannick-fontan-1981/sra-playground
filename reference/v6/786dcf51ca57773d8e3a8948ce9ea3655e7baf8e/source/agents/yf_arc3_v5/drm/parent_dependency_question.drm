      ],
      "falsifiers": ["a_foreign_or_stale_return_reenters_the_parent", "a_question_tie_authorizes_a_primitive"],
      "selection_eligibility_conditions": [{"field": "applicable", "operator": "equals", "expected": true}],
      "fact_projections": [
