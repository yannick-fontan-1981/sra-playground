              "expected": -1
            },
            {
              "field": "shared_translation",
              "operator": "equals",
              "expected": false
            },
            {
              "field": "contact_group_count_excluding_peer",
              "operator": "equals",
              "expected": 1
            },
            {
              "field": "joint_distance",
              "operator": "greater_than",
              "expected": 0
            },
            {
              "field": "question_evidence_refs",
