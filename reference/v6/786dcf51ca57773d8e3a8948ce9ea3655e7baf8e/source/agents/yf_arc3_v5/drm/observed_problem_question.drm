{
  "module_id": "arc3.observed_problem_question",
  "declarations": [
    {
      "id": "policy.prepare_observed_peer_composition_access",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "selection_eligibility_conditions": [
        {
          "field": "composition_access_admissible",
          "operator": "equals",
          "expected": true
        }
      ],
      "selection_required_fact_fields": [
        "composition_relation_count",
        "total_primitive_distance",
        "access_distance",
        "direct_single_input_previously_executed",
        "conditional_peer_response_exit_upper_bound"
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.canonical_lexicographic_equivalence_tie_break",
      "selection_tiers": [
        {
          "id": "tier.prepare_joint_access_to_observed_peer",
          "reason_ref": "reason.prepare_complex_composition_by_shortest_jointly_accessible_means"
        }
      ],
      "selection_precedence_criteria": [
        {
          "field": "composition_relation_count",
          "preferred_order": "maximize",
          "criterion_ref": "criterion.most_complex_accessible_composition",
          "reason_ref": "reason.prepare_complex_composition_by_shortest_jointly_accessible_means"
        },
        {
          "field": "conditional_peer_response_exit_upper_bound",
          "preferred_order": "minimize",
          "criterion_ref": "criterion.restrict_peer_exits_under_stationary_or_one_cell_responses",
          "reason_ref": "reason.prepare_complex_composition_by_shortest_jointly_accessible_means"
        },
        {
          "field": "total_primitive_distance",
          "preferred_order": "minimize",
          "criterion_ref": "criterion.shortest_total_access_to_composition",
          "reason_ref": "reason.prepare_complex_composition_by_shortest_jointly_accessible_means"
        }
      ],
      "selection_tie_breakers": [
        {
          "field": "access_distance",
          "preferred_order": "minimize"
        },
        {
          "field": "direct_single_input_previously_executed",
          "preferred_order": "minimize"
        },
        {
          "field": "grip_row",
          "preferred_order": "minimize"
        },
        {
          "field": "grip_col",
          "preferred_order": "minimize"
        },
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "reason_refs": [
        "reason.prepare_complex_composition_by_shortest_jointly_accessible_means"
      ],
      "invariants": [
        "observe_counteracted_approach_before_selecting_a_composed_means",
        "current_exact_identities_join_the_retained_question_to_geometry",
        "carrier_part_and_carried_part_peer_contact_are_two_distinct_relations",
        "maximize_distinct_accessible_relations_then_restrict_local_peer_responses_then_minimize_total_primitive_cost",
        "equal_geometry_cost_uses_one_declared_row_then_column_traversal_witness_not_a_hash_preference",
        "attachment_is_a_revisable_experiment_not_an_acquired_law_or_act_permit",
        "one_straight_obstacle_translation_is_counterfactual_and_each_push_is_reconciled_before_continuation",
        "translation_cost_includes_contact_access_all_push_primitives_and_remaining_access_to_the_same_complex_composition",
        "the_observed_reactive_peer_does_not_count_as_a_competing_stationary_part",
        "contact_with_the_peer_does_not_guarantee_which_body_an_unknown_operator_changes",
        "no_palette_position_or_creator_action_sequence_selects_the_part",
        "stationary_part_must_remove_an_exit_and_independent_actor_must_close_the_remaining_domain",
        "inverse_operator_and_independence_are_experiments_not_acquired_physics",
        "a_contact_in_a_closed_geometric_domain_remains_an_unknown_terminal_probe",
        "among_equal_complexity_and_shortest_access_cost_prefer_a_direct_input_not_yet_executed_in_the_same_configuration",
        "peer_response_contrast_keeps_stationary_and_every_free_one_cell_response_possible_not_a_committed_evasion_law"
      ],
      "fact_projections": [
        {
          "id": "projection.observed_composition_access.defaults",
          "static_facts": {
            "composition_access_admissible": false,
            "composition_relation_count": 0,
            "conditional_peer_response_exit_upper_bound": 0
          }
        },
        {
          "id": "projection.observed_composition_access.joint_witness",
