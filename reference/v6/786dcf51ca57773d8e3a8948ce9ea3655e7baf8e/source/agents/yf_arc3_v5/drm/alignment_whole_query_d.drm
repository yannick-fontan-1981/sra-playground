{
  "module_id": "alignment_whole_query_d",
  "declarations": [
    {
      "id": "policy.d_alignment_whole_query_receipt",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.d_exact_whole_query_receipt_preserves_conditional_scope_and_parent"
      ],
      "declared_alternative_refs": [
        "d_alignment_receipt.domain_complete",
        "d_alignment_receipt.policy_complete",
        "d_alignment_receipt.complete_without_policy",
        "d_alignment_receipt.blocked"
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.d_alignment_whole_query_equivalent_receipt",
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "selection_tiers": [
        {
          "id": "tier.d_alignment_receipt.domain",
          "reason_ref": "reason.d_exact_whole_query_receipt_preserves_conditional_scope_and_parent",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "d_alignment_receipt.domain_complete"
            },
            {
              "field": "receipt_bindings_match",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "mode_ref",
              "operator": "equals",
              "expected": "DOMAIN"
            }
          ]
        },
        {
          "id": "tier.d_alignment_receipt.policy",
          "reason_ref": "reason.d_exact_whole_query_receipt_preserves_conditional_scope_and_parent",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "d_alignment_receipt.policy_complete"
            },
            {
              "field": "receipt_bindings_match",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "mode_ref",
              "operator": "equals",
              "expected": "SEARCH"
            },
            {
              "field": "witness_count",
              "operator": "greater_than",
              "expected": 0
            }
          ]
        },
        {
          "id": "tier.d_alignment_receipt.no_policy",
          "reason_ref": "reason.d_exact_whole_query_receipt_preserves_conditional_scope_and_parent",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "d_alignment_receipt.complete_without_policy"
            },
            {
              "field": "receipt_bindings_match",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "mode_ref",
              "operator": "equals",
              "expected": "SEARCH"
            },
            {
              "field": "witness_count",
              "operator": "equals",
              "expected": 0
            }
          ]
        },
        {
          "id": "tier.d_alignment_receipt.blocked",
          "reason_ref": "reason.d_exact_whole_query_receipt_preserves_conditional_scope_and_parent",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "d_alignment_receipt.blocked"
            }
          ]
        }
      ],
      "meaning_template_ref_by_alternative": {
        "d_alignment_receipt.domain_complete": "rule.d_alignment_current_whole_query_receipt",
        "d_alignment_receipt.policy_complete": "rule.d_alignment_current_whole_query_receipt",
        "d_alignment_receipt.complete_without_policy": "rule.d_alignment_current_whole_query_receipt"
      },
      "configuration": {
        "admitted_context_ref": "d_alignment_context.external_question",
        "admitted_receipt_refs": ["d_alignment_receipt.domain_complete", "d_alignment_receipt.policy_complete", "d_alignment_receipt.complete_without_policy"],
        "domain_mode_ref": "DOMAIN",
        "search_mode_ref": "SEARCH",
        "state_action_domain_digest_field": "state_action_domains_digest",
        "receipt_projection_contract_ref": "d.alignment_whole_query_receipt.v1",
        "receipt_predicate_ref": "qualifies_current_alignment_whole_query_receipt",
        "qualification_status_refs": [
