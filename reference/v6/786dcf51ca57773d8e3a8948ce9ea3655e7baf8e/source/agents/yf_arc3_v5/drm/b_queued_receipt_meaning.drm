{
  "module_id": "b_queued_receipt_meaning",
  "declarations": [
    {
      "id": "policy.b_queued_receipt_meaning",
      "kind": "selection_policy",
      "evaluation": "declared_eligibility_single",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason_future_projected_configuration_must_serve_current_parent"
      ],
      "premises": [
        "complete_current_correlated_receipt",
        "explicit_parent_quota_and_preservation"
      ],
      "invariants": [
        "conditional_model_scope_only",
        "no_world_success_confirmation",
        "no_act_authority",
        "unbound_later_consumer_stays_open"
      ],
      "falsifiers": [
        "changed_scope_or_occurrence_identity",
        "missing_later_consumer"
      ],
      "declared_alternative_refs": [
        "queued_receipt.derive",
        "queued_receipt.open"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "eligible",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.queued_receipt.matching_line",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "queued_receipt.derive"
            },
            {
              "field": "receipt_kind",
              "operator": "equals",
              "expected": "matching_line"
            },
            {
              "field": "receipt_bindings_current",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "eligible": true,
            "causal_reason_ref": "reason_projected_line_serves_parent_quota"
          }
        },
        {
          "id": "projection.queued_receipt.zero_credit_staging",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "queued_receipt.derive"
            },
            {
              "field": "receipt_kind",
              "operator": "equals",
              "expected": "zero_credit_staging"
            },
            {
              "field": "receipt_bindings_current",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "eligible": true,
            "causal_reason_ref": "reason_staged_occurrences_serve_named_later_line"
          }
        },
        {
          "id": "projection.queued_receipt.zero_credit_queue_access",
          "all_conditions": [
            {"field": "alternative_ref", "operator": "equals", "expected": "queued_receipt.derive"},
            {"field": "receipt_kind", "operator": "equals", "expected": "zero_credit_queue_access"},
            {"field": "receipt_bindings_current", "operator": "equals", "expected": true}
          ],
          "static_facts": {
            "eligible": true,
            "causal_reason_ref": "reason_zero_credit_lock_opens_named_later_queue_line"
          }
        },
        {
          "id": "projection.queued_receipt.open",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "queued_receipt.open"
            },
            {
              "field": "receipt_bindings_current",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "eligible": true
          }
        }
      ],
      "meaning_template_ref_by_alternative": {
        "queued_receipt.derive": "rule.b_queued_receipt_meaning"
      }
    },
