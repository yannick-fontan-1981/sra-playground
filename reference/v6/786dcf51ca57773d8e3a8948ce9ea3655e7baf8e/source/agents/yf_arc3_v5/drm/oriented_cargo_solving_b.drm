      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason_one_owned_joint_transaction_preserves_all_autonomous_responses"
      ],
      "configuration": {
        "kernel_ref": "mechanics.oriented_cargo_handoffs",
        "joint_operation_ref": "mechanics.oriented_cargo_handoffs.joint_successor",
        "joint_mode_ref": "STEP"
      },
      "invariants": [
        "no_second_debit_or_autonomous_pass",
        "one_response_is_not_all_responses",
        "internal_successor_is_not_a_complete_primitive"
      ],
      "declared_alternative_refs": [
        "cargo_primitive.bound",
        "cargo_primitive.unresolved"
      ],
      "selection_eligibility_conditions": [
        {
          "field": "eligible",
          "operator": "equals",
          "expected": true
        }
      ],
      "fact_projections": [
        {
          "id": "projection.cargo_primitive.bound",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cargo_primitive.bound"
            },
            {
              "field": "bindings_current",
              "operator": "equals",
              "expected": true
            }
          ],
          "static_facts": {
            "eligible": true,
            "reason_ref": "reason_exact_current_native_binding_before_joint_calculation"
          }
        },
        {
          "id": "projection.cargo_primitive.unresolved",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "cargo_primitive.unresolved"
            },
            {
              "field": "bindings_current",
              "operator": "equals",
              "expected": false
            }
          ],
          "static_facts": {
            "eligible": true,
            "reason_ref": "reason_missing_joint_binding_is_an_evidence_dependency_not_a_plan"
          }
        }
      ]
    },
