            "full_mask_digest": "full_mask_digest",
            "full_mask": "full_mask",
            "raw_input_ref": "raw_input_ref",
            "frame_ref": "frame_ref"
          },
          "static_attributes": {
            "physical_collision_mask_not_confirmed": true,
            "no_action_authority": true
          }
        }
      ]
