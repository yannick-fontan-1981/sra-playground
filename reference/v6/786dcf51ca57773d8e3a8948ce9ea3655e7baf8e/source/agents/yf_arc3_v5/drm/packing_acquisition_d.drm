    {
      "id": "rule.d_packing_acquired_display_mask",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "reason_refs": [
        "reason.packing_acquisition_from_actual_observations"
      ],
      "invariants": [
        "mask_is_measured_from_repository_not_request",
        "collision_support_not_confirmed",
        "unknown_boundary_never_completed"
      ],
      "term_templates": [
        {
          "id_pattern": "{drawing_ref}",
          "kind": "value",
          "label": "Acquired packing drawing support",
          "required_fields": [
            "drawing_ref",
            "full_mask",
            "raw_input_ref"
          ],
          "required_term_patterns": [
            "{piece_identity_ref}"
          ],
          "static_attributes": {
            "projection_contract_ref": "packing.acquired_display_mask.v1"
          },
          "attribute_bindings": {
            "full_mask": "full_mask",
            "raw_input_ref": "raw_input_ref",
            "piece_identity_ref": "piece_identity_ref",
            "frame_ref": "frame_ref",
            "full_mask_digest": "full_mask_digest"
          }
        }
      ],
      "claim_templates": [
        {
          "id_pattern": "{mask_claim_ref}",
          "predicate": "qualifies_acquired_packing_display_mask",
          "family": "epistemic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "{piece_identity_ref}",
            "{drawing_ref}"
