{
  "module_id": "packing_acquisition_d",
  "declarations": [
    {
      "id": "policy.d_packing_acquisition_mask",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.packing_acquisition_from_actual_observations",
        "reason.packing_observed_acquisition_unknown"
      ],
      "declared_alternative_refs": [
        "d_packing_acquisition.mask",
        "d_packing_acquisition.unknown"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.packing_acquisition_equivalent_observed_support",
      "selection_tiers": [
        {
          "id": "tier.packing_acq.mask",
          "reason_ref": "reason.packing_acquisition_from_actual_observations",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "d_packing_acquisition.mask"
            },
            {
            "field": "mask_acquisition_complete",
            "operator": "equals",
            "expected": true
          },
          {
            "field": "owner_bindings_current",
            "operator": "equals",
            "expected": true
            }
          ]
        },
        {
          "id": "tier.packing_acq.unknown",
          "reason_ref": "reason.packing_observed_acquisition_unknown",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "d_packing_acquisition.unknown"
            }
          ]
        }
      ],
      "meaning_template_ref_by_alternative": {
        "d_packing_acquisition.mask": "rule.d_packing_acquired_display_mask"
      },
      "configuration": {
        "mask_predicate_ref": "qualifies_acquired_packing_display_mask",
        "identity_predicate_ref": "qualifies_observed_packing_drawing_identity"
      }
    },
