{
  "module_id": "rail_layers_d",
  "declarations": [{
    "id": "policy.d_rail_layers",
    "kind": "selection_policy",
    "evaluation": "declared_lexicographic_order",
    "supported_operators": ["SELECT"],
    "input_contract": "yf_arc3_v5.authority_input.selection.v1",
    "output_contract": "yf_arc3_v5.authority_output.selection.v1",
    "reason_refs": ["reason.d_current_rail_layers_are_separate_descriptive_samples",
      "reason.d_obscured_schema_remains_unknown_despite_visible_content",
      "reason.d_rail_layer_scope_or_support_not_qualified"],
    "selection_required_fact_fields": ["layer_bindings_match", "unknown_pixel_count",
      "unprovided_motif_count", "schema_content_separated"],
    "declared_alternative_refs": ["d_rail_layers.current_visible", "d_rail_layers.current_obscured", "d_rail_layers.unknown"],
    "canonical_equivalence_tie_break_debt_ref": "debt.d_rail_layers_equivalent_scope",
    "selection_tie_breakers": [{"field": "alternative_ref", "preferred_order": "minimize"}],
    "selection_tiers": [
      {"id": "tier.d_rail_layers.visible", "reason_ref": "reason.d_current_rail_layers_are_separate_descriptive_samples",
       "all_conditions": [
         {"field": "alternative_ref", "operator": "equals", "expected": "d_rail_layers.current_visible"},
         {"field": "layer_bindings_match", "operator": "equals", "expected": true},
         {"field": "schema_content_separated", "operator": "equals", "expected": true},
         {"field": "unknown_pixel_count", "operator": "equals", "expected": 0},
         {"field": "unprovided_motif_count", "operator": "equals", "expected": 0}]},
      {"id": "tier.d_rail_layers.obscured", "reason_ref": "reason.d_obscured_schema_remains_unknown_despite_visible_content",
       "all_conditions": [
         {"field": "alternative_ref", "operator": "equals", "expected": "d_rail_layers.current_obscured"},
         {"field": "layer_bindings_match", "operator": "equals", "expected": true},
         {"field": "schema_content_separated", "operator": "equals", "expected": true},
         {"field": "unknown_pixel_count", "operator": "greater_than", "expected": 0}]},
      {"id": "tier.d_rail_layers.unprovided", "reason_ref": "reason.d_obscured_schema_remains_unknown_despite_visible_content",
       "all_conditions": [
         {"field": "alternative_ref", "operator": "equals", "expected": "d_rail_layers.current_obscured"},
         {"field": "layer_bindings_match", "operator": "equals", "expected": true},
         {"field": "schema_content_separated", "operator": "equals", "expected": true},
         {"field": "unprovided_motif_count", "operator": "greater_than", "expected": 0}]},
      {"id": "tier.d_rail_layers.unknown", "reason_ref": "reason.d_rail_layer_scope_or_support_not_qualified",
       "all_conditions": [{"field": "alternative_ref", "operator": "equals", "expected": "d_rail_layers.unknown"}]}
    ],
    "configuration": {
      "operation_ref": "mechanics.cadenced_rail_transfer.layers", "mode_ref": "MEASURE",
      "admitted_native_return_ref": "d_effect_request.descriptive_return",
      "qualification_status_refs": ["supported", "established"],
      "frame_field": "rail_layer_frame_ref", "frame_digest_field": "rail_layer_frame_digest",
      "layout_digest_field": "rail_layer_layout_digest",
      "schema_is_not_content": true, "unknown_is_not_empty": true,
      "no_transfer_or_model_confirmation": true, "no_action_authority": true
    }
  }]
}
