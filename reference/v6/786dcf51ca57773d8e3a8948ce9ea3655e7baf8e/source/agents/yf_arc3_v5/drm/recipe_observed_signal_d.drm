{
  "module_id": "recipe_observed_signal_d",
  "declarations": [
    {
      "id": "policy.recipe_observed_signal_d",
      "kind": "selection_policy",
      "evaluation": "declared_lexicographic_order",
      "supported_operators": [
        "SELECT"
      ],
      "input_contract": "yf_arc3_v5.authority_input.selection.v1",
      "output_contract": "yf_arc3_v5.authority_output.selection.v1",
      "reason_refs": [
        "reason.recipe_exact_acquired_signal",
        "reason.recipe_signal_still_unknown"
      ],
      "declared_alternative_refs": [
        "recipe_signal.publish_exact",
        "recipe_signal.unknown"
      ],
      "selection_tie_breakers": [
        {
          "field": "alternative_ref",
          "preferred_order": "minimize"
        }
      ],
      "canonical_equivalence_tie_break_debt_ref": "debt.recipe_observed_signal_equivalent_support",
      "selection_tiers": [
        {
          "id": "tier.recipe_signal.exact",
          "reason_ref": "reason.recipe_exact_acquired_signal",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "recipe_signal.publish_exact"
            },
            {
              "field": "acquisition_current",
              "operator": "equals",
              "expected": true
            },
            {
              "field": "matching_alternative_count",
              "operator": "equals",
              "expected": 1
            },
            {
              "field": "unknown_positions_empty",
              "operator": "equals",
              "expected": true
            }
          ]
        },
        {
          "id": "tier.recipe_signal.unknown",
          "reason_ref": "reason.recipe_signal_still_unknown",
          "all_conditions": [
            {
              "field": "alternative_ref",
              "operator": "equals",
              "expected": "recipe_signal.unknown"
            }
          ]
        }
      ],
      "meaning_template_ref_by_alternative": {
        "recipe_signal.publish_exact": "rule.recipe_acquired_signal_value_d"
      },
      "configuration": {
        "support_predicate_ref": "qualifies_acquired_recipe_signal",
        "acquired_source_kind_ref": "recipe.acquired_scalar_signal.v1"
      }
    },
    {
      "id": "rule.recipe_acquired_signal_value_d",
      "kind": "rule",
      "evaluation": "project_requested_conclusions",
      "supported_operators": [
        "DERIVE"
      ],
      "input_contract": "yf_arc3_v5.authority_input.derivation.v1",
      "output_contract": "yf_arc3_v5.authority_output.derivation.v1",
      "relation_family": "epistemic",
      "reason_refs": [
        "reason.recipe_exact_acquired_signal"
      ],
      "invariants": [
        "actual_acquisition_not_supplied_native_state",
        "source_declared_scalar_relation_only",
        "no_collision_or_action_authority"
      ],
      "term_templates": [
        {
          "id_pattern": "{field_ref}",
          "kind": "value",
          "label": "Acquired recipe display signal",
          "required_fields": [
            "field_ref",
            "frame_ref",
            "observation_record_ref",
            "signal_digest",
            "unique_alternative_ref"
          ],
          "static_attributes": {
            "projection_contract_ref": "recipe.acquired_scalar_signal.v1",
            "source_kind_ref": "recipe.acquired_scalar_signal.v1"
          },
          "attribute_bindings": {
            "value": "unique_value",
            "frame_ref": "frame_ref",
            "raw_input_ref": "raw_input_ref",
            "observation_record_ref": "observation_record_ref",
            "signal_ref": "signal_ref",
            "source_schema_ref": "source_schema_ref",
            "signal_digest": "signal_digest",
            "raster_digest": "raster_digest",
            "alternative_ref": "unique_alternative_ref"
          }
        }
      ],
      "claim_templates": [
        {
          "id_pattern": "{support_claim_ref}",
          "predicate": "qualifies_acquired_recipe_signal",
          "family": "epistemic",
          "epistemic_status": "supported",
          "argument_patterns": [
            "{field_ref}",
            "{observation_record_ref}"
          ],
          "required_term_patterns": [
            "{field_ref}"
          ],
          "required_fields": [
            "support_claim_ref",
            "field_ref",
            "observation_record_ref",
            "signal_digest",
            "frame_ref"
          ],
          "attribute_bindings": {
            "signal_digest": "signal_digest",
            "raster_digest": "raster_digest"
          },
          "scope_bindings": {
            "frame_ref": "frame_ref",
            "raw_input_ref": "raw_input_ref",
            "timeline_ref": "timeline_ref",
            "observation_record_ref": "observation_record_ref"
          },
          "static_attributes": {
            "no_native_state_or_action_authority": true
          }
        }
      ]
    },
    {
